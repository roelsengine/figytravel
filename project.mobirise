          "_name": "slider03",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider3\" group=\"Gallery &amp; Slider\" mbr-class=\"{'mbr-fullscreen': fullScreen}\">\n    <mbr-parameters>\n        <input type=\"id\" name=\"sliderId\">\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"!fullScreen\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Fade Effect\" name=\"fade\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"3\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <header>Slide</header>\n        <input type=\"checkbox\" title=\"Caption\" name=\"showCaption\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked=\"\">\n        <input type=\"checkbox\" title=\"Bullets\" name=\"showBullets\" checked=\"\">\n        <input type=\"checkbox\" title=\"Arrows\" name=\"showArrows\" checked=\"\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\" selected=\"\">\n    </mbr-parameters>\n    <div id=\"{{sliderId}}\" class=\"carousel slide\" mbr-class=\"{'carousel-fade': fade}\" data-ride=\"{{autoplay ? 'carousel' : false}}\" data-bs-ride=\"{{autoplay ? 'carousel' : false}}\" data-interval=\"{{interval*1000}}\" data-bs-interval=\"{{interval*1000}}\">\n        <ol class=\"carousel-indicators\" mbr-if=\"showBullets\">\n            <li data-target=\"#{{sliderId}}\" data-bs-target=\"#{{sliderId}}\" data-slide-to=\"0\" data-bs-slide-to=\"0\" class=\"active\"></li>\n            <li data-target=\"#{{sliderId}}\" data-bs-target=\"#{{sliderId}}\" data-slide-to=\"1\" data-bs-slide-to=\"1\"></li><li data-target=\"#{{sliderId}}\" data-bs-target=\"#{{sliderId}}\" data-slide-to=\"2\" data-bs-slide-to=\"2\"></li>\n            <li data-target=\"#{{sliderId}}\" data-bs-target=\"#{{sliderId}}\" data-slide-to=\"3\" data-bs-slide-to=\"3\"></li>\n        </ol>\n        <div class=\"carousel-inner\">\n            <div class=\"carousel-item slider-image item active\">\n                <div class=\"item-wrapper\">\n                    <img class=\"d-block w-100\" src=\"../_images/background18.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                    <div class=\"mbr-overlay\" mbr-if=\"overlay\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n                    </div>\n                    <div class=\"carousel-caption\" mbr-if=\"showCaption || showText || showButtons\">\n                        <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" mbr-if=\"showCaption\" mbr-theme-style=\"display-5\">\n                            <b>Full-Width Slider</b>\n                        </h5>\n                        <p class=\"mbr-section-text mbr-fonts-style mb-4\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-text, .mbr-section-btn\">Click on the image to edit slides.</p>\n                        <div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn mb-5\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove, -mbrBtnRemove\">\n\t\t\t\t\t\t<a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Get started</a>\n\t\t\t\t\t</div>     \n                    </div>\n                </div>\n            </div>\n            <div class=\"carousel-item slider-image item\">\n                <div class=\"item-wrapper\">\n                    <img class=\"d-block w-100\" src=\"../_images/background16.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                    <div class=\"mbr-overlay\" mbr-if=\"overlay\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n                    </div>\n                    <div class=\"carousel-caption\" mbr-if=\"showCaption || showText || showButtons\">\n                        <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" mbr-if=\"showCaption\" mbr-theme-style=\"display-5\">\n                            <b>Full-Width Slider</b>\n                        </h5>\n                        <p class=\"mbr-section-text mbr-fonts-style mb-4\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-text, .mbr-section-btn\">Click on the image to edit slides.</p>\n                        <div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn mb-5\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove, -mbrBtnRemove\">\n\t\t\t\t\t\t<a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Get started</a>\n\t\t\t\t\t</div>     \n                    </div>\n                </div>\n            </div><div class=\"carousel-item slider-image item\">\n                <div class=\"item-wrapper\">\n                    <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/volunteers-tanzania-cheeta-1920x1280.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                    <div class=\"mbr-overlay\" mbr-if=\"overlay\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n                    </div>\n                    <div class=\"carousel-caption\" mbr-if=\"showCaption || showText || showButtons\">\n                        <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" mbr-if=\"showCaption\" mbr-theme-style=\"display-5\">\n                            <b>Full-Width Slider</b>\n                        </h5>\n                        <p class=\"mbr-section-text mbr-fonts-style mb-4\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-text, .mbr-section-btn\">Click on the image to edit slides.</p>\n                        <div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn mb-5\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove, -mbrBtnRemove\">\n\t\t\t\t\t\t<a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Get started</a>\n\t\t\t\t\t</div>     \n                    </div>\n                </div>\n            </div>\n            <div class=\"carousel-item slider-image item\">\n                <div class=\"item-wrapper\">\n                    <img class=\"d-block w-100\" src=\"../_images/background19.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                    <div class=\"mbr-overlay\" mbr-if=\"overlay\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n                    </div>\n                    <div class=\"carousel-caption\" mbr-if=\"showCaption || showText || showButtons\">\n                        <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" mbr-if=\"showCaption\" mbr-theme-style=\"display-5\">\n                            <b>Full-Width Slider</b>\n                        </h5>\n                        <p class=\"mbr-section-text mbr-fonts-style mb-4\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-text, .mbr-section-btn\">Click on the image to edit slides.</p>\n                        <div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn mb-5\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove, -mbrBtnRemove\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-paperclip mbr-iconfont mbr-iconfont-btn\"></span>Get started</a></div>     \n                    </div>\n                </div>\n            </div>\n        </div>\n        <a class=\"carousel-control carousel-control-prev\" href=\"#{{sliderId}}\" role=\"button\" data-slide=\"prev\" data-bs-slide=\"prev\">\n            <span class=\"mobi-mbri mobi-mbri-arrow-prev\" aria-hidden=\"true\"></span>\n            <span class=\"sr-only visually-hidden\">Previous</span>\n        </a>\n        <a class=\"carousel-control carousel-control-next\" href=\"#{{sliderId}}\" role=\"button\" data-slide=\"next\" data-bs-slide=\"next\">\n            <span class=\"mobi-mbri mobi-mbri-arrow-next\" aria-hidden=\"true\"></span>\n            <span class=\"sr-only visually-hidden\">Next</span>\n        </a>\n    </div>\n</section>",
          "_cid": "uHesv703nR",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider03-1k"
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".title-wrapper": {
              "margin-bottom": "60px",
              "@media (max-width: 992px)": {
                "margin-bottom": "48px"
              },
              ".desc-wrapper": {
                ".mbr-desc": {
                  "display": "inline-block",
                  "width": "50%",
                  "margin-bottom": "36px",
                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "margin-bottom": "16px"
                  }
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "24px"
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-block",
                  "width": "50%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "850px",
              "max-width": "850px",
              "@media (max-width: 1200px)": {
                "min-width": "650px",
                "max-width": "650px"
              },
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              "&:hover, &:focus": {
                ".slide-content .item-wrapper .item-img img": {
                  "border": "2px solid @active"
                }
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".item-img": {
                    "margin-bottom": "32px",
                    "img": {
                      "height": "480px",
                      "width": "100%",
                      "object-fit": "cover",
                      "border": "2px solid transparent",
                      "@media (max-width: 992px)": {
                        "height": "350px"
                      }
                    }
                  },
                  ".item-content": {
                    "position": "relative",
                    "z-index": "1",
                    "padding": "2px",
                    ".title-wrap": {
                      ".item-title": {
                        "display": "inline-block",
                        "width": "50%",
                        "margin-bottom": "8px",
                        "@media (max-width: 992px)": {
                          "width": "100%"
                        }
                      }
                    },
                    ".text-wrap": {
                      ".item-text": {
                        "display": "inline-block",
                        "width": "50%",
                        "margin-bottom": "0",
                        "@media (max-width: 992px)": {
                          "width": "100%"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "48px",
              "height": "48px",
              "font-size": "24px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "transform": "scale(1.05)"
              },
              "&.embla__button--prev": {
                "left": "0"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "margin-bottom": "50px",
              "@media (max-width: 992px)": {
                "margin-bottom": "38px"
              },
              "& when (@arrows)": {
                "padding-bottom": "4rem"
              }
            },
            ".embla__viewport": {
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#9aa0a6",
              "text-align": "center"
            },
            ".mbr-desc, .desc-wrapper": {
              "color": "#9aa0a6",
              "text-align": "center"
            },
            ".item-title, .title-wrap": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-text, .text-wrap": {
              "color": "#9aa0a6",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "center"
            }
          },
          "_name": "slider02",
          "_sourceTheme": "progressm5",
          "_customHTML": "<section data-bs-version=\"5.1\"\n        class=\"slider02 mbr-embla progressm5\"\n        group=\"Gallery & Slider\"\n        plugins=\"embla\"\n        mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\"\n>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\"/>\n        <input\n                type=\"range\"\n                inline\n                title=\"Top\"\n                name=\"paddingTop\"\n                min=\"0\"\n                max=\"10\"\n                step=\"1\"\n                value=\"5\"\n        />\n        <input\n                type=\"range\"\n                inline\n                title=\"Bottom\"\n                name=\"paddingBottom\"\n                min=\"0\"\n                max=\"10\"\n                step=\"1\"\n                value=\"5\"\n        />\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\"/>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked/>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked/>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked/>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\n        <input\n                type=\"range\"\n                title=\"Interval\"\n                name=\"interval\"\n                min=\"1\"\n                max=\"10\"\n                value=\"4\"\n                step=\"1\"\n                condition=\"autoplay\"\n        />\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\n        <input\n                type=\"checkbox\"\n                name=\"arrowsMobile\"\n                title=\"Mobile Arrows\"\n                condition=\"arrows\"\n                checked\n        />\n        <input type=\"color\" name=\"arrowsBg\" title=\"Arrows BG\" value=\"#252525\" condition=\"arrows\"/>\n        <input type=\"color\" name=\"arrowsColor\" title=\"Arrows Color\" value=\"#ffffff\" condition=\"arrows\"/>\n        <header>Cards</header>\n        <input\n                type=\"range\"\n                name=\"gap\"\n                title=\"Gap\"\n                min=\"0\"\n                max=\"10\"\n                step=\"1\"\n                value=\"0\"\n        />\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Card Title\" checked/>\n        <input type=\"checkbox\" name=\"showCardText\" title=\"Card Text\" checked/>\n        <input type=\"color\" name=\"active\" title=\"Active Color\" value=\"#078efb\"/>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/progressm5/components/_images/background1.jpg\"/>\n            <input type=\"color\" title=\"Color\" value=\"#060606\" selected/>\n        </fieldset>\n        <input\n                type=\"checkbox\"\n                title=\"Overlay\"\n                name=\"overlay\"\n                condition=\"bg.type !== 'color'\"\n                checked\n        />\n        <input\n                type=\"color\"\n                title=\"Overlay Color\"\n                name=\"overlayColor\"\n                value=\"#060606\"\n                condition=\"overlay && bg.type == 'image'\"\n        />\n        <input\n                type=\"range\"\n                inline\n                title=\"Opacity\"\n                name=\"overlayOpacity\"\n                min=\"0\"\n                max=\"1\"\n                step=\"0.1\"\n                value=\"0.1\"\n                condition=\"overlay && bg.type == 'image'\"\n        />\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"title-wrapper\" mbr-if=\"showTitle || showText || showDesc\">\n                        <div class=\"desc-wrapper\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                               mbr-if=\"showDesc\" data-app-selector=\".mbr-desc, .desc-wrapper\">\n                                MODERN LIVING SPACES\n                            </p>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\"\n                            data-app-selector=\".mbr-section-title, .mbr-section-btn\"\n                            mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                            Smart home setups\n                        </h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                               mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Smart home setups have evolved to cater to various needs and preferences, offering a\n                                wide range of configurations that enhance convenience, security, and efficiency. These\n                                setups integrate multiple smart devices and systems, creating a cohesive environment\n                                where technology seamlessly interacts with daily life.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"slider-wrapper\">\n                        <div\n                                class=\"embla\"\n                                data-loop=\"{{loop}}\"\n                                data-auto-play=\"{{autoplay}}\"\n                                data-auto-play-interval=\"{{interval}}\"\n                                data-draggable=\"{{draggable}}\"\n                                data-skip-snaps=\"true\"\n                                data-align=\"center\"\n                                data-contain-scroll=\"trimSnaps\"\n                        >\n                            <div class=\"embla__viewport\">\n                                <div class=\"embla__container\">\n                                    <div class=\"embla__slide slider-image item\"\n                                         mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                                <div class=\"item-img\">\n                                                    <img src=\"@ADDONS_PATH@/progressm5/components/_images/progress/image2.jpg\"\n                                                         alt=\"Mobirise Website Builder\"/>\n                                                </div>\n                                                <div class=\"item-content\">\n                                                    <div class=\"title-wrap\">\n                                                        <h4 class=\"item-title mbr-fonts-style\"\n                                                            mbr-theme-style=\"display-7\"\n                                                            data-app-selector=\".item-title, .title-wrap\"\n                                                            mbr-if=\"showCardTitle\">\n                                                            Basic smart home setup\n                                                        </h4>\n                                                    </div>\n                                                    <div class=\"text-wrap\">\n                                                        <p class=\"item-text mbr-fonts-style\"\n                                                           mbr-theme-style=\"display-4\"\n                                                           data-app-selector=\".item-text, .text-wrap\"\n                                                           mbr-if=\"showCardText\">\n                                                            Voice-activated control for basic functions.\n                                                            Remote control via smartphone apps.\n                                                            Simple automation routines (e.g., lights turning on/off at\n                                                            specific times).\n                                                        </p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\"\n                                         mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                                <div class=\"item-img\">\n                                                    <img src=\"@ADDONS_PATH@/progressm5/components/_images/progress/image4.jpg\"\n                                                         alt=\"Mobirise Website Builder\"/>\n                                                </div>\n                                                <div class=\"item-content\">\n                                                    <div class=\"title-wrap\">\n                                                        <h4 class=\"item-title mbr-fonts-style\"\n                                                            mbr-theme-style=\"display-7\"\n                                                            data-app-selector=\".item-title, .title-wrap\"\n                                                            mbr-if=\"showCardTitle\">\n                                                            Security-focused setup\n                                                        </h4>\n                                                    </div>\n                                                    <div class=\"text-wrap\">\n                                                        <p class=\"item-text mbr-fonts-style\"\n                                                           mbr-theme-style=\"display-4\"\n                                                           data-app-selector=\".item-text, .text-wrap\"\n                                                           mbr-if=\"showCardText\">\n                                                            Real-time video surveillance and recording.\n                                                            Remote monitoring and notifications for suspicious activity.\n                                                            Keyless entry and remote lock/unlock functionality.\n                                                        </p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\"\n                                         mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                                <div class=\"item-img\">\n                                                    <img src=\"@ADDONS_PATH@/progressm5/components/_images/progress/image13.jpg\"\n                                                         alt=\"Mobirise Website Builder\"/>\n                                                </div>\n                                                <div class=\"item-content\">\n                                                    <div class=\"title-wrap\">\n                                                        <h4 class=\"item-title mbr-fonts-style\"\n                                                            mbr-theme-style=\"display-7\"\n                                                            data-app-selector=\".item-title, .title-wrap\"\n                                                            mbr-if=\"showCardTitle\">\n                                                            Energy-efficient setup\n                                                        </h4>\n                                                    </div>\n                                                    <div class=\"text-wrap\">\n                                                        <p class=\"item-text mbr-fonts-style\"\n                                                           mbr-theme-style=\"display-4\"\n                                                           data-app-selector=\".item-text, .text-wrap\"\n                                                           mbr-if=\"showCardText\">\n                                                            Automated heating and cooling based on occupancy and\n                                                            weather.\n                                                            Energy-saving lighting with motion sensors and dimming\n                                                            capabilities.\n                                                            Monitoring and optimizing power usage of various devices.\n                                                        </p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\"\n                                         mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                                <div class=\"item-img\">\n                                                    <img src=\"@ADDONS_PATH@/progressm5/components/_images/progress/image15.jpg\"\n                                                         alt=\"Mobirise Website Builder\"/>\n                                                </div>\n                                                <div class=\"item-content\">\n                                                    <div class=\"title-wrap\">\n                                                        <h4 class=\"item-title mbr-fonts-style\"\n                                                            mbr-theme-style=\"display-7\"\n                                                            data-app-selector=\".item-title, .title-wrap\"\n                                                            mbr-if=\"showCardTitle\">\n                                                            Comprehensive smart home setup\n                                                        </h4>\n                                                    </div>\n                                                    <div class=\"text-wrap\">\n                                                        <p class=\"item-text mbr-fonts-style\"\n                                                           mbr-theme-style=\"display-4\"\n                                                           data-app-selector=\".item-text, .text-wrap\"\n                                                           mbr-if=\"showCardText\">\n                                                            Centralized control of all smart home devices.\n                                                            Complex automation routines and scenarios.\n                                                            Integration with various smart home ecosystems and platforms.\n                                                        </p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\"\n                                         mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                                <div class=\"item-img\">\n                                                    <img src=\"@ADDONS_PATH@/progressm5/components/_images/progress/image3.jpg\"\n                                                         alt=\"Mobirise Website Builder\"/>\n                                                </div>\n                                                <div class=\"item-content\">\n                                                    <div class=\"title-wrap\">\n                                                        <h4 class=\"item-title mbr-fonts-style\"\n                                                            mbr-theme-style=\"display-7\"\n                                                            data-app-selector=\".item-title, .title-wrap\"\n                                                            mbr-if=\"showCardTitle\">\n                                                            Entertainment and media setup\n                                                        </h4>\n                                                    </div>\n                                                    <div class=\"text-wrap\">\n                                                        <p class=\"item-text mbr-fonts-style\"\n                                                           mbr-theme-style=\"display-4\"\n                                                           data-app-selector=\".item-text, .text-wrap\"\n                                                           mbr-if=\"showCardText\">\n                                                            Voice-controlled entertainment systems.\n                                                            High-quality audio and video streaming.\n                                                            Integration with streaming services and content providers.\n                                                        </p>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <button class=\"embla__button embla__button--prev\">\n                                <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                            </button>\n                            <button class=\"embla__button embla__button--next\">\n                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                            </button>\n                        </div>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"\n                         data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                            Get started now\n                        </a>\n                        <a class=\"btn btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                            View more setups\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_cid": "uHesv98sdG",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider02-1l"
        },
        {
          "_name": "slider01",
          "_sourceTheme": "progressm5",
          "_customHTML": "<section data-bs-version=\"5.1\"\n        class=\"slider01 mbr-embla progressm5\"\n        group=\"Gallery & Slider\"\n        plugins=\"embla\"\n        mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\"\n>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\"/>\n        <input\n                type=\"range\"\n                inline\n                title=\"Top\"\n                name=\"paddingTop\"\n                min=\"0\"\n                max=\"10\"\n                step=\"1\"\n                value=\"5\"\n        />\n        <input\n                type=\"range\"\n                inline\n                title=\"Bottom\"\n                name=\"paddingBottom\"\n                min=\"0\"\n                max=\"10\"\n                step=\"1\"\n                value=\"5\"\n        />\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\"/>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked/>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\n        <input\n                type=\"range\"\n                title=\"Interval\"\n                name=\"interval\"\n                min=\"1\"\n                max=\"10\"\n                value=\"4\"\n                step=\"1\"\n                condition=\"autoplay\"\n        />\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\n        <input\n                type=\"checkbox\"\n                name=\"arrowsMobile\"\n                title=\"Mobile Arrows\"\n                condition=\"arrows\"\n                checked\n        />\n        <input type=\"color\" name=\"arrowsBg\" title=\"Arrows BG\" value=\"#252525\" condition=\"arrows\"/>\n        <input type=\"color\" name=\"arrowsColor\" title=\"Arrows Color\" value=\"#ffffff\" condition=\"arrows\"/>\n        <header>Cards</header>\n        <input\n                type=\"range\"\n                name=\"gap\"\n                title=\"Gap\"\n                min=\"0\"\n                max=\"10\"\n                step=\"1\"\n                value=\"1\"\n        />\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Card Title\" checked/>\n        <input type=\"color\" name=\"border\" title=\"Card Border\" value=\"#078efb\"/>\n        <input type=\"color\" name=\"shadow\" title=\"Card Shadow\" value=\"#060606\"/>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/progressm5/components/_images/background1.jpg\"/>\n            <input type=\"color\" title=\"Color\" value=\"#060606\" selected/>\n        </fieldset>\n        <input\n                type=\"checkbox\"\n                title=\"Overlay\"\n                name=\"overlay\"\n                condition=\"bg.type !== 'color'\"\n                checked\n        />\n        <input\n                type=\"color\"\n                title=\"Overlay Color\"\n                name=\"overlayColor\"\n                value=\"#060606\"\n                condition=\"overlay && bg.type == 'image'\"\n        />\n        <input\n                type=\"range\"\n                inline\n                title=\"Opacity\"\n                name=\"overlayOpacity\"\n                min=\"0\"\n                max=\"1\"\n                step=\"0.1\"\n                value=\"0.1\"\n                condition=\"overlay && bg.type == 'image'\"\n        />\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"title-wrapper\" mbr-if=\"showTitle || showText\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\"\n                            data-app-selector=\".mbr-section-title\"\n                            mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                            Main functions\n                        </h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                               mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Virtual assistants (VAs) are AI-powered tools designed to assist users with a wide range\n                                of tasks, enhancing productivity, efficiency, and convenience.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"slider-wrapper\">\n                        <div\n                                class=\"embla\"\n                                data-loop=\"{{loop}}\"\n                                data-auto-play=\"{{autoplay}}\"\n                                data-auto-play-interval=\"{{interval}}\"\n                                data-draggable=\"{{draggable}}\"\n                                data-skip-snaps=\"true\"\n                                data-align=\"center\"\n                                data-contain-scroll=\"trimSnaps\"\n                        >\n                            <div class=\"embla__viewport\">\n                                <div class=\"embla__container\">\n                                    <div class=\"embla__slide slider-image item\"\n                                         mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                                <div class=\"item-content\">\n                                                    <h4 class=\"item-title mbr-fonts-style\"\n                                                        mbr-theme-style=\"display-5\"\n                                                        data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                        They help users create and manage task lists, ensuring deadlines\n                                                        are met and tasks.\n                                                    </h4>\n                                                </div>\n                                                <div class=\"item-img\">\n                                                    <div class=\"item-wrap item-number\">\n                                                        <img src=\"@ADDONS_PATH@/progressm5/components/_images/progress/image5.jpg\"\n                                                             alt=\"Mobirise Website Builder\"/>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\"\n                                         mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                                <div class=\"item-content\">\n                                                    <h4 class=\"item-title mbr-fonts-style\"\n                                                        mbr-theme-style=\"display-5\"\n                                                        data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                        They can send and receive text messages or instant messages, and\n                                                        sometimes even engage.\n                                                    </h4>\n                                                </div>\n                                                <div class=\"item-img\">\n                                                    <div class=\"item-wrap item-number\">\n                                                        <img src=\"@ADDONS_PATH@/progressm5/components/_images/progress/image19.jpg\"\n                                                             alt=\"Mobirise Website Builder\"/>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\"\n                                         mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                                <div class=\"item-content\">\n                                                    <h4 class=\"item-title mbr-fonts-style\"\n                                                        mbr-theme-style=\"display-5\"\n                                                        data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                        They can retrieve information from databases, documents, and\n                                                        other resources as requested.\n                                                    </h4>\n                                                </div>\n                                                <div class=\"item-img\">\n                                                    <div class=\"item-wrap item-number\">\n                                                        <img src=\"@ADDONS_PATH@/progressm5/components/_images/progress/image12.jpg\"\n                                                             alt=\"Mobirise Website Builder\"/>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <button class=\"embla__button embla__button--prev\">\n                                <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                            </button>\n                            <button class=\"embla__button embla__button--next\">\n                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".title-wrapper": {
              "margin-bottom": "60px",
              "@media (max-width: 992px)": {
                "margin-bottom": "48px"
              },
              ".mbr-section-title": {
                "margin-bottom": "24px"
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-block",
                  "width": "50%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "display": "flex",
                  "align-items": "center",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".item-content": {
                    "width": "40%",
                    "padding-right": "90px",
                    "position": "relative",
                    "z-index": "1",
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "padding-right": "0"
                    },
                    "& when (@reverseContent)": {
                      "padding-right": "0",
                      "padding-left": "90px",
                      "@media (max-width: 992px)": {
                        "padding-left": "0"
                      }
                    },
                    ".item-title": {
                      "margin-bottom": "0",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "36px"
                      }
                    }
                  },
                  ".item-img": {
                    "position": "relative",
                    "width": "60%",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    },
                    "&:before": {
                      "content": "''",
                      "width": "100%",
                      "height": "30%",
                      "position": "absolute",
                      "bottom": "-1px",
                      "left": "0",
                      "background-image": "linear-gradient(0deg, @shadow 40%, transparent 98%)"
                    },
                    ".item-wrap": {
                      "padding": "12px",
                      "border": "2px solid @border",
                      "@media (max-width: 992px)": {
                        "padding": "16px"
                      },
                      "img": {
                        "height": "360px",
                        "width": "100%",
                        "object-fit": "cover",
                        "@media (max-width: 992px)": {
                          "height": "300px"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "50%",
              "width": "48px",
              "height": "48px",
              "font-size": "24px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "@media (max-width: 992px)": {
                "bottom": "0"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "transform": "scale(1.05)"
              },
              "&.embla__button--prev": {
                "left": "0"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "padding": "0 12%",
              "@media (max-width: 992px)": {
                "padding": "0"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#9aa0a6",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#ffffff"
            }
          },
          "_cid": "uHesvbsxXZ",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider01-1m"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".container-fluid": {
              "padding": "0",
              "@media (max-width: 992px)": {
                "padding": "0 16px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "450px",
              "max-width": "450px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "height": "100%",
                  "border-radius": "2rem !important",
                  "background-color": "@card",
                  "padding": "40px",
                  "& when not (@isRoundedImages)": {
                    "border-radius": "0 !important"
                  },
                  "@media (max-width: 768px)": {
                    "padding": "40px 20px"
                  },
                  ".item-img": {
                    "margin-bottom": "30px",
                    "img": {
                      "display": "inline-flex",
                      "width": "66px",
                      "height": "66px",
                      "border-radius": ".5rem",
                      "object-fit": "cover"
                    }
                  },
                  ".item-content": {
                    "position": "relative",
                    "z-index": "1",
                    ".item-name": {
                      "margin-bottom": "15px"
                    },
                    ".icon-wrapper": {
                      "margin-bottom": "15px",
                      ".mbr-iconfont": {
                        "display": "block",
                        "color": "@icon",
                        "font-size": "32px"
                      }
                    },
                    ".item-text": {
                      "margin": "15px 0 0 0"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "48px",
              "height": "48px",
              "font-size": "16px",
              "background-color": "@primaryColor !important",
              "color": "@infoColor !important",
              "border": "none !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "font-weight": "700 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background-color": "@infoColor !important",
                "color": "@primaryColor !important"
              },
              "&.embla__button--prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "padding": "24px 0",
              "& when (@arrows)": {
                "padding-bottom": "6rem"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "background-color": "transparent"
            },
            ".item-name": {
              "color": "#000000"
            },
            ".item-text": {
              "color": "#000000"
            },
            ".item-name, .item-img, .icon-wrapper": {
              "text-align": "center"
            }
          },
          "_name": "slider02",
          "_sourceTheme": "ridem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider02 mbr-embla ridem5\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"5\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\"/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n                checked\r\n        />\r\n        <header>Cards</header>\r\n        <input\r\n                type=\"range\"\r\n                name=\"gap\"\r\n                title=\"Gap\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input type=\"checkbox\" name=\"showName\" title=\"Card Name\" checked/>\r\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked/>\r\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" condition=\"showIcon\" selected/>\r\n        <input type=\"checkbox\" name=\"showText\" title=\"Card Text\" checked/>\r\n        <input type=\"color\" title=\"Card BG\" value=\"#D0E59F\" name=\"card\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax required>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/ridem5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#CECDC7\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#fafafa\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div\r\n                        class=\"embla\"\r\n                        data-loop=\"{{loop}}\"\r\n                        data-auto-play=\"{{autoplay}}\"\r\n                        data-auto-play-interval=\"{{interval}}\"\r\n                        data-draggable=\"{{draggable}}\"\r\n                        data-skip-snaps=\"true\"\r\n                        data-align=\"center\"\r\n                        data-contain-scroll=\"trimSnaps\"\r\n                >\r\n                    <div class=\"embla__viewport\">\r\n                        <div class=\"embla__container\">\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/ridem5/components/_images/ride/image2.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name, .item-img, .icon-wrapper\" mbr-if=\"showName\">\r\n                                                <b>Tiffany Blake</b>\r\n                                            </h4>\r\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\"></span>\r\n                                            </div>\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               data-app-selector=\".item-text\" mbr-if=\"showText\">\r\n                                                I was a bit skeptical at first, but renting an electric scooter turned\r\n                                                out to be the highlight of my trip! The app made it super easy to find\r\n                                                and unlock a scooter, and zipping around the city was an absolute blast.\r\n                                                Plus, it's eco-friendly – what's not to love?\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/ridem5/components/_images/ride/image5.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name, .item-img, .icon-wrapper\" mbr-if=\"showName\">\r\n                                                <b>Bobby Carr</b>\r\n                                            </h4>\r\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\"></span>\r\n                                            </div>\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               data-app-selector=\".item-text\" mbr-if=\"showText\">\r\n                                                I've started using electric scooters for my daily commute, and it's\r\n                                                been a game-changer. The scooters are fast, convenient, and a fun way to\r\n                                                beat the traffic. My only gripe is that sometimes the battery life isn't\r\n                                                as long as I'd like, but overall, I'm really happy with the service.\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/ridem5/components/_images/ride/image6.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name, .item-img, .icon-wrapper\" mbr-if=\"showName\">\r\n                                                <b>Janet Hammond</b>\r\n                                            </h4>\r\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\"></span>\r\n                                            </div>\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               data-app-selector=\".item-text\" mbr-if=\"showText\">\r\n                                                Renting an electric scooter was a convenient way to explore the city,\r\n                                                but I found myself constantly dodging potholes and uneven pavement. The\r\n                                                scooters are great on smooth roads, but they can be a bit tricky to\r\n                                                handle on rough terrain.\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/ridem5/components/_images/ride/image1.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name, .item-img, .icon-wrapper\" mbr-if=\"showName\">\r\n                                                <b>Paul Reed</b>\r\n                                            </h4>\r\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\"></span>\r\n                                            </div>\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               data-app-selector=\".item-text\" mbr-if=\"showText\">\r\n                                                I appreciated the emphasis on safety with this electric scooter rental\r\n                                                service. The app provides clear instructions on how to ride safely, and\r\n                                                the scooters themselves feel sturdy and well-maintained. My only\r\n                                                suggestion would be to add more designated parking zones.\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/ridem5/components/_images/ride/image24.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name, .item-img, .icon-wrapper\" mbr-if=\"showName\">\r\n                                                <b>Lois Mills</b>\r\n                                            </h4>\r\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\"></span>\r\n                                            </div>\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               data-app-selector=\".item-text\" mbr-if=\"showText\">\r\n                                                As a tourist, renting an electric scooter was the best decision I made\r\n                                                during my trip. It made getting around the city so much easier and more\r\n                                                enjoyable. Plus, I loved that I could easily park the scooter and\r\n                                                explore on foot whenever I wanted.\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/ridem5/components/_images/ride/image4.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name, .item-img, .icon-wrapper\" mbr-if=\"showName\">\r\n                                                <b>Joseph Reid</b>\r\n                                            </h4>\r\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\"></span>\r\n                                            </div>\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               data-app-selector=\".item-text\" mbr-if=\"showText\">\r\n                                                While the concept of electric scooter rental is great, the customer\r\n                                                service leaves a lot to be desired. I had an issue with my rental and\r\n                                                struggled to get in touch with customer support for assistance. It was\r\n                                                frustrating and soured my experience overall.\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <button class=\"embla__button embla__button--prev\">\r\n                        <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                    </button>\r\n                    <button class=\"embla__button embla__button--next\">\r\n                        <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uHesvdDHSN",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider02-1n"
        },
        {
          "alias": false,
          "_styles": {
            "display": "flex",
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              ".mbr-overlay": {
                "background-color": "@overlayColor",
                "opacity": "@overlayOpacity"
              }
            },
            "@media (min-width: 768px)": {
              "align-items": "~\"@{verticalAlign}\"",
              ".row": {
                "justify-content": "~\"@{horizontalAlign}\""
              },
              ".content-wrap": {
                "padding": "1rem 3rem"
              }
            },
            "@media (max-width: 991px) and (min-width: 768px)": {
              ".content-wrap": {
                "min-width": "50%"
              }
            },
            "@media (max-width: 767px)": {
              "-webkit-align-items": "center",
              "align-items": "~\"@{verticalAlign}\"",
              ".mbr-row": {
                "-webkit-justify-content": "center",
                "justify-content": "center"
              },
              ".content-wrap": {
                "width": "100%"
              }
            },
            ".mbr-section-title, .mbr-section-subtitle": {
              "text-align": "center"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center"
            },
            ".mbr-section-title": {
              "text-align": "center"
            }
          },
          "_name": "header17",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header16\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"24\" step=\"1\" value=\"20\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline title=\"Content Width\" name=\"contentWidth\" min=\"3\" max=\"12\" step=\"1\" value=\"12\">\n    <header>Show / Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n    <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n    <select title=\"Vertical Align\" name=\"verticalAlign\" condition=\"fullScreen\">\n      <option value=\"flex-start\">Top</option>\n      <option value=\"center\" selected>Center</option>\n      <option value=\"flex-end\">Bottom</option>\n    </select>\n    <select title=\"Horizontal Align\" name=\"horizontalAlign\">\n      <option value=\"flex-start\">Left</option>\n      <option value=\"center\" selected>Center</option>\n      <option value=\"flex-end\">Right</option>\n    </select>\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-600x400.jpg\" parallax selected>\n      <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=2Gg6Seob5Mg\">\n      <input type=\"color\" title=\"Color\" value=\"#260a30\">\n    </fieldset>\n    <header condition=\"bg.type === 'video'\">Fallback Image</header>\n    <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type!='color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"bg.type!='color' && overlay\">\n    <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"bg.type!='color' && overlay\">\n  </mbr-parameters>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row\">\n      <div class=\"content-wrap col-12 col-md-{{contentWidth}}\">\n        <h1 class=\"mbr-section-title mbr-fonts-style mbr-white mb-4\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\"><b>Volunteers Tanzania Mwanza</b></h1>\n        <h2 class=\"mbr-section-subtitle mbr-fonts-style mbr-white mb-4\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\">\n          Header Subtitle\n        </h2>\n        <p class=\"mbr-fonts-style mbr-text mbr-white mb-4\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b>Charity volunteers internships Agriculture,Teaching,Healthcare</b></p>\n        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-7\"><a class=\"btn btn-danger\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Volunteer Agriculture</a> <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Volunteer Teaching</a> <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Volunteer Healthcare</a></div>\n      </div>\n    </div>\n  </div>\n</section>",
