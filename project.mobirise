          "_name": "menu02",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu2\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\t<mbr-parameters>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n\t\t<input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"1\" max=\"5\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n\t\t<input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n\t\t<input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n\t\t<select title=\"Menu Items Align\" name=\"contentAlign\" condition=\"showItems\">\n\t\t\t<option value=\"1\">Left</option>\n\t\t\t<option value=\"2\" selected>Center</option>\n\t\t\t<option value=\"3\">Right</option>\n\t\t</select>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n\t\t<select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t</select>\n\t\t<input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#000000\" condition=\"showIcons\">\n\t\t<input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n\t\t<header>Styles</header>\n\t\t<input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\" condition=\"none\">\n\t\t<input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" checked>\n\t\t<input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n\t\t<input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"transparent\">\n\t\t<input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#000000\">\n\t</mbr-parameters>\n\n\t<nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"navbar-brand\">\n\t\t\t\t<span mbr-if=\"showLogo\" class=\"navbar-logo\">\n\t\t\t\t\t<a href=\"https://mobiri.se\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/logo-figy-travel-volunteers-1-500x111.png\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n\t\t\t\t\t</a>\n\t\t\t\t</span>\n\t\t\t\t<span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Figy.travel</a></span>\n\t\t\t</div>\n\t\t\t<button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n\t\t\t\t<div class=\"hamburger\">\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t</div>\n\t\t\t</button>\n\t\t\t<div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n\t\t\t\t<ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n\t\t\t\t\t\t<a class=\"nav-link link text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About Charity</a>\n\t\t\t\t\t</li>\n\t\t\t\t\t<li class=\"nav-item dropdown\">\n\t\t\t\t\t\t<a class=\"nav-link link text-black dropdown-toggle\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\">Volunteer Programs</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-414\"><a class=\"text-black dropdown-item text-primary\" href=\"page2.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Volunteer internship program Agriculture</a><a class=\"text-black dropdown-item\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Volunteer internship program Teaching Education</a><a class=\"text-black dropdown-item\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Volunteer internship program Healthcare</a></div>\n\t\t\t\t\t</li>\n\t\t\t\t\t<li class=\"nav-item\">\n\t\t\t\t\t\t<a class=\"nav-link link text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">get inspired</a>\n\t\t\t\t\t</li><li class=\"nav-item\"><a class=\"nav-link link text-black\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Stories</a></li></ul>\n\t\t\t\t<div class=\"icons-menu\" mbr-if=\"showIcons\">\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 1\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 2\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-map-pin mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 3\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-shopping-cart mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t<div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"> Start Now!</a></div>\n\t\t\t</div>\n\t\t</div>\n\t</nav>\n</section>",
          "_cid": "uHesuZz5Da",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {},
          "_anchor": "menu02-1h"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".row": {
              "justify-content": "flex-end"
            },
            ".title": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              "margin-bottom": "80px",
              "@media (max-width: 992px)": {
                "margin-bottom": "30px"
              },
              ".label-wrapper": {
                ".label-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  "margin-bottom": "30px",
                  ".mbr-label": {
                    "margin-bottom": "0"
                  },
                  ".mbr-iconfont": {
                    "font-size": "18px",
                    "margin-right": "12px",
                    "color": "@iconColor"
                  }
                }
              },
              ".title-wrapper": {
                ".mbr-section-title": {
                  "margin-bottom": "0"
                }
              }
            },
            ".item-wrapper": {
              "position": "relative"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 768px)": {
                "min-width": "100%",
                "max-width": "100%",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "padding": "80px",
                  "min-height": "650px",
                  "background-color": "transparent",
                  "position": "relative",
                  "z-index": "1",
                  "@media (max-width: 1440px)": {
                    "padding": "60px"
                  },
                  "@media (max-width: 992px)": {
                    "padding": "30px 16px",
                    "min-height": "auto"
                  },
                  ".card-box": {
                    ".content-wrapper": {
                      "margin-bottom": "60px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "30px"
                      },
                      ".date-wrapper": {
                        "display": "inline-flex",
                        "flex-wrap": "wrap",
                        ".date-wrap": {
                          "display": "inline-flex",
                          "flex-wrap": "wrap",
                          "align-items": "center",
                          "padding": "8px 16px",
                          "background-color": "@dateBg",
                          "margin-right": "14px",
                          "margin-bottom": "14px",
                          ".item-date": {
                            "margin-bottom": "0"
                          },
                          ".mbr-iconfont": {
                            "font-size": "18px",
                            "margin-right": "12px",
                            "color": "@iconDate"
                          }
                        },
                        ".label-wrap": {
                          "display": "inline-flex",
                          "flex-wrap": "wrap",
                          "align-items": "center",
                          "padding": "8px 16px",
                          "background-color": "@labelBg",
                          "margin-bottom": "14px",
                          ".item-label": {
                            "margin-bottom": "0"
                          },
                          ".mbr-iconfont": {
                            "font-size": "18px",
                            "margin-right": "12px",
                            "color": "@icon"
                          }
                        }
                      }
                    }
                  },
                  ".item-title": {
                    "margin-bottom": "60px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "30px"
                    }
                  },
                  ".item-text": {
                    "margin-bottom": "0"
                  },
                  ".mbr-section-btn": {
                    "margin-top": "20px"
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "65px",
              "height": "65px",
              "margin-top": "-1.5rem",
              "font-size": "22px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "2px solid @arrowsBg !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "background-color": "transparent !important",
                "@media (max-width: 992px)": {
                  "background-color": "@arrowsBg !important"
                }
              },
              "&.embla__button--prev": {
                "right": "-5.5rem",
                "@media (max-width: 992px)": {
                  "right": "auto",
                  "left": "16px",
                  "bottom": "1rem"
                }
              },
              "&.embla__button--next": {
                "right": "-11rem",
                "@media (max-width: 992px)": {
                  "right": "16px",
                  "bottom": "1rem"
                }
              },
              "@media (max-width: 767px)": {
                "top": "auto"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "background-color": "@cardBg",
              "& when (@arrows)": {
                "@media (max-width: 992px)": {
                  "padding-bottom": "6rem"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "padding": "0"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-label, .label-wrapper": {
              "color": "#fff7ee",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#fff7ee",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#fff7ee"
            },
            ".item-text": {
              "color": "#fff7ee"
            },
            ".item-label": {
              "color": "#151e11"
            },
            ".item-date": {
              "color": "#151e11"
            }
          },
          "_name": "slider02",
          "_sourceTheme": "recyclem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider02 mbr-embla recyclem5\" group=\"Sliders & Galleries\" plugins=\"embla\"\n         mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked/>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked/>\n        <input type=\"color\" title=\"Icon Color\" value=\"#fff7ee\" name=\"iconColor\" condition=\"showLabel\" selected/>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"3\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"color\" name=\"arrowsColor\" title=\"Arrows Color\" value=\"#fff7ee\" condition=\"arrows\">\n        <input type=\"color\" name=\"arrowsBg\" title=\"Arrows BG\" value=\"#5c7d4f\" condition=\"arrows\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Date\" name=\"showDate\" checked/>\n        <input type=\"color\" title=\"Date Icon Color\" value=\"#151e11\" name=\"iconDate\" condition=\"showDate\" selected/>\n        <input type=\"color\" title=\"Date BG\" value=\"#FFBE0D\" name=\"dateBg\" condition=\"showDate\" selected/>\n        <input type=\"checkbox\" title=\"Label\" name=\"showCardLabel\" checked/>\n        <input type=\"color\" title=\"Label Icon Color\" value=\"#151e11\" name=\"icon\" condition=\"showLabel\" selected/>\n        <input type=\"color\" title=\"Label BG\" value=\"#fff7ee\" name=\"labelBg\" condition=\"showLabel\" selected/>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Card Title\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Card Text\" checked>\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Card Buttons\">\n        <input type=\"color\" name=\"cardBg\" title=\"Card BG\" value=\"#151e11\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/recyclem5/components/_images/background6.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#151e11\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#151e11\"\n               condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\"\n               condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row title\">\n            <div class=\"col-12 col-lg-8\" mbr-if=\"showLabel || showTitle\">\n                <div class=\"title-wrapper\">\n                    <div class=\"label-wrapper\">\n                        <div class=\"label-wrap\" mbr-if=\"showLabel\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-globe mobi-mbri\"></span>\n                            <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                               data-app-selector=\".mbr-label, .label-wrapper\">\n                                by the Recycling Company\n                            </p>\n                        </div>\n                    </div>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\n                        data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                        Upcoming Events\n                    </h2>\n                </div>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-5\">\n                <div class=\"slider-wrap\">\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\"\n                         data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\"\n                         data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\"\n                             mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide slider-image item features-without-image\"\n                                     mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"card-box\">\n                                                <div class=\"content-wrapper\" mbr-if=\"showDate || showCardLabel\">\n                                                    <div class=\"date-wrapper\">\n                                                        <div class=\"date-wrap\" mbr-if=\"showDate\">\n                                                        <span mbr-icon\n                                                              class=\"mbr-iconfont mobi-mbri-globe mobi-mbri\"></span>\n                                                            <p class=\"item-date mbr-fonts-style\"\n                                                               mbr-theme-style=\"display-4\"\n                                                               data-app-selector=\".item-date, .content-wrapper\">\n                                                                2030\n                                                            </p>\n                                                        </div>\n                                                        <div class=\"label-wrap\" mbr-if=\"showCardLabel\">\n                                                        <span mbr-icon\n                                                              class=\"mbr-iconfont mobi-mbri-globe mobi-mbri\"></span>\n                                                            <p class=\"item-label mbr-fonts-style\"\n                                                               mbr-theme-style=\"display-4\"\n                                                               data-app-selector=\".item-label\">\n                                                                Central Park\n                                                            </p>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\n                                                    data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                    Community Recycling Day\n                                                </h4>\n                                                <div class=\"text-wrapper\">\n                                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\"\n                                                       mbr-theme-style=\"display-4\"\n                                                       data-app-selector=\".item-text, .mbr-section-btn\">\n                                                        Join us for a day of environmental action! Drop off your\n                                                        recyclable items, including plastics, electronics, and paper, at\n                                                        designated collection points. Enjoy eco-friendly workshops, live\n                                                        demonstrations of recycling processes, and activities for kids.\n                                                        Free entry for all participants.\n                                                    </p>\n                                                </div>\n                                                <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\"\n                                                     data-toolbar=\"-mbrBtnMove\" mbr-buttons\n                                                     mbr-theme-style=\"display-4\">\n                                                    <a href class=\"btn btn-secondary item-btn\" target=\"_blank\"\n                                                       data-app-placeholder=\"Type Text\">\n                                                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                        View more\n                                                    </a>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item features-without-image\"\n                                     mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"card-box\">\n                                                <div class=\"content-wrapper\" mbr-if=\"showDate || showCardLabel\">\n                                                    <div class=\"date-wrapper\">\n                                                        <div class=\"date-wrap\" mbr-if=\"showDate\">\n                                                        <span mbr-icon\n                                                              class=\"mbr-iconfont mobi-mbri-globe mobi-mbri\"></span>\n                                                            <p class=\"item-date mbr-fonts-style\"\n                                                               mbr-theme-style=\"display-4\"\n                                                               data-app-selector=\".item-date, .content-wrapper\">\n                                                                2030\n                                                            </p>\n                                                        </div>\n                                                        <div class=\"label-wrap\" mbr-if=\"showCardLabel\">\n                                                        <span mbr-icon\n                                                              class=\"mbr-iconfont mobi-mbri-globe mobi-mbri\"></span>\n                                                            <p class=\"item-label mbr-fonts-style\"\n                                                               mbr-theme-style=\"display-4\"\n                                                               data-app-selector=\".item-label\">\n                                                                Expo Center\n                                                            </p>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\n                                                    data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                    Eco Innovation Fair\n                                                </h4>\n                                                <div class=\"text-wrapper\">\n                                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\"\n                                                       mbr-theme-style=\"display-4\"\n                                                       data-app-selector=\".item-text, .mbr-section-btn\">\n                                                        Discover the latest innovations in recycling and sustainability.\n                                                        Meet industry experts, explore new recycling technologies, and\n                                                        learn how businesses and individuals can contribute to a\n                                                        circular economy. The event includes keynote speakers,\n                                                        networking sessions, and hands-on exhibits.\n                                                    </p>\n                                                </div>\n                                                <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\"\n                                                     data-toolbar=\"-mbrBtnMove\" mbr-buttons\n                                                     mbr-theme-style=\"display-4\">\n                                                    <a href class=\"btn btn-secondary item-btn\" target=\"_blank\"\n                                                       data-app-placeholder=\"Type Text\">\n                                                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                        View more\n                                                    </a>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item features-without-image\"\n                                     mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"card-box\">\n                                                <div class=\"content-wrapper\" mbr-if=\"showDate || showCardLabel\">\n                                                    <div class=\"date-wrapper\">\n                                                        <div class=\"date-wrap\" mbr-if=\"showDate\">\n                                                        <span mbr-icon\n                                                              class=\"mbr-iconfont mobi-mbri-globe mobi-mbri\"></span>\n                                                            <p class=\"item-date mbr-fonts-style\"\n                                                               mbr-theme-style=\"display-4\"\n                                                               data-app-selector=\".item-date, .content-wrapper\">\n                                                                2030\n                                                            </p>\n                                                        </div>\n                                                        <div class=\"label-wrap\" mbr-if=\"showCardLabel\">\n                                                        <span mbr-icon\n                                                              class=\"mbr-iconfont mobi-mbri-globe mobi-mbri\"></span>\n                                                            <p class=\"item-label mbr-fonts-style\"\n                                                               mbr-theme-style=\"display-4\"\n                                                               data-app-selector=\".item-label\">\n                                                                Global Participation\n                                                            </p>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\n                                                    data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                    Zero-Waste Challenge Month\n                                                </h4>\n                                                <div class=\"text-wrapper\">\n                                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\"\n                                                       mbr-theme-style=\"display-4\"\n                                                       data-app-selector=\".item-text, .mbr-section-btn\">\n                                                        Take the Zero-Waste Challenge! Participants will receive daily\n                                                        tips, resources, and challenges to reduce waste and adopt\n                                                        sustainable practices. Share your progress on social media and\n                                                        stand a chance to win eco-friendly prizes.\n                                                    </p>\n                                                </div>\n                                                <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\"\n                                                     data-toolbar=\"-mbrBtnMove\" mbr-buttons\n                                                     mbr-theme-style=\"display-4\">\n                                                    <a href class=\"btn btn-secondary item-btn\" target=\"_blank\"\n                                                       data-app-placeholder=\"Type Text\">\n                                                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                        View more\n                                                    </a>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5\"></div>\n        </div>\n    </div>\n</section>",
          "_cid": "uHesv2rWna",
