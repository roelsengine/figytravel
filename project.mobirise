        {
          "_name": "team2",
          "_sourceTheme": "wellnessm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"team2 carousel slide testimonials-slider\" group=\"People\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"6\" inline condition=\"fullScreen == false\">\n        <input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"3\" inline condition=\"fullScreen == false\">\n        <header>Slider</header>\n        <input type=\"range\" inline title=\"Count\" name=\"testimonialsSlides\" min=\"1\" max=\"4\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Author\" name=\"showAuthor\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header condition=\"showIcon\">Icon</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Color\" name=\"iconColor\" value=\"#ffffff\" condition=\"showIcon\">\n        <input type=\"color\" title=\"Color\" name=\"borderColor\" value=\"#41392e\" condition=\"showIcon\">\n        <header condition=\"dots\">Bullets</header>\n        <input type=\"checkbox\" title=\"Bullets\" name=\"dots\" checked>\n        <input type=\"color\" title=\"Color\" name=\"dotsColor\" value=\"#ffffff\" condition=\"dots\">\n        <input type=\"color\" title=\"Active\" name=\"dotsColorActive\" value=\"#ddc499\" condition=\"dots\">\n        <input type=\"range\" title=\"Opacity\" name=\"dotsOpacity\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"dots\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/wellnessm5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#121212\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay&&bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"carousel slide\" data-ride=\"carousel\" data-bs-ride=\"carousel\" role=\"listbox\">\n            <div class=\"row justify-content-center mb-5\">\n                <div class=\"col-12 col-lg-8\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-quote-right mobi-mbri\" mbr-if=\"showIcon\"></span>\n                    <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n                        <div class=\"carousel-item\">\n                            <div class=\"col-md-12 col-lg-11\">\n                                <p class=\"mbr-text mbr-fonts-style box\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                                    Lorem ipsum dolor sit amet, conse ctetuer adipiscing elit, sed diam nonum nibhie\n                                    euismod.\n                                    Facilisis\n                                    at vero eros et accumsan et iusto odio dignissim qui blandit praesent luptatum\n                                    zzril.</p>\n                                <div class=\"author mbr-m-auto\" mbr-if=\"showAuthor\">\n                                    <h3 class=\" pb-0 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\">By Jessica Antony\n                                        / Cosmetologist\n                                    </h3>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"carousel-item\">\n                            <div class=\"col-md-12 col-lg-12\">\n                                <p class=\"mbr-text mbr-fonts-style box\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                                    Lorem ipsum dolor sit amet, conse ctetuer adipiscing elit, sed diam nonum nibhie\n                                    euismod.\n                                    Facilisis\n                                    at vero eros et accumsan et iusto odio dignissim qui blandit praesent luptatum\n                                    zzril. </p>\n                                <div class=\"author mbr-m-auto\" mbr-if=\"showAuthor\">\n                                    <h3 class=\"d pb-0 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\">By Madeleine\n                                        Golden / Cosmetologist\n                                    </h3>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"carousel-item\">\n                            <div class=\"col-md-12 col-lg-12\">\n                                <p class=\"mbr-text mbr-fonts-style box\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                                    Lorem ipsum dolor sit amet, conse ctetuer adipiscing elit, sed diam nonum nibhie\n                                    euismod.\n                                    Facilisis\n                                    at vero eros et accumsan et iusto odio dignissim qui blandit praesent luptatum\n                                    zzril. </p>\n                                <div class=\"author mbr-m-auto\" mbr-if=\"showAuthor\">\n                                    <h3 class=\"d pb-0 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\">By Madeleine\n                                        Golden / Cosmetologist\n                                    </h3>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <ol class=\"carousel-indicators\" mbr-if=\"dots\">\n                <li data-slide-to=\"0\" data-bs-slide-to=\"0\" class=\"active\">\n                    <svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg>\n                </li>\n                <li data-slide-to=\"1\" data-bs-slide-to=\"1\" mbr-if=\"testimonialsSlides > 1\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg>\n                </li>\n                <li data-slide-to=\"2\" data-bs-slide-to=\"2\" mbr-if=\"testimonialsSlides > 2\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg>\n                </li>\n                <li data-slide-to=\"3\" data-bs-slide-to=\"3\" mbr-if=\"testimonialsSlides > 3\"><svg class=\"qodef-svg-circle\">\n                        <circle cx=\"50%\" cy=\"50%\" r=\"45%\"></circle>\n                    </svg>\n                </li>\n            </ol>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".row": {
              "flex-direction": "row-reverse",
              "position": "relative"
            },
            ".carousel-indicators": {
              "left": "75%",
              "bottom": "0",
              "flex-direction": "column",
              "@media (max-width: 991px)": {
                "position": "relative",
                "left": "0",
                "flex-direction": "row",
                "bottom": "-10%"
              }
            },
            ".carousel-indicators li": {
              "margin-bottom": "2rem",
              "margin-right": "31px",
              "margin-left": "31px",
              "opacity": "(@dotsOpacity * 0.1)",
              "width": "6px",
              "height": "6px",
              "max-width": "6px",
              "max-height": "6px",
              "min-width": "6px",
              "min-height": "6px",
              "background": "@dotsColor",
              "border": "none",
              "position": "relative",
              "transition": "0.3s",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border-radius": "50%",
              "&:hover": {
                "opacity": "1 !important"
              },
              "& svg": {
                "position": "absolute",
                "display": "block",
                "width": "36px",
                "height": "36px",
                "z-index": "1",
                "fill": "none",
                "color": "@dotsColorActive",
                "stroke": "none",
                "overflow": "visible",
                "& circle": {
                  "stroke-dasharray": "110",
                  "stroke-dashoffset": "110",
                  "stroke": "@dotsColorActive",
                  "stroke-width": "1",
                  "transition": "all 0.6s cubic-bezier(0.43, 0.41, 0.36, 0.9)",
                  "transform": "rotate(-145deg)",
                  "transform-origin": "center"
                }
              }
            },
            ".carousel-indicators li.active": {
              "background": "@dotsColorActive",
              "& circle": {
                "stroke-dashoffset": "0",
                "transform": "rotate(55deg)"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "2rem"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left"
            },
            "H3": {
              "text-align": "left"
            },
            ".author, .box": {
              "font-style": "italic"
            },
            ".author": {
              "color": "#9A948D"
            },
            ".mbr-iconfont": {
              "left": "10%",
              "top": "-45%",
              "position": "absolute",
              "font-size": "35px",
              "border-radius": "50%",
              "color": "@iconColor",
              "border": "1px solid @borderColor",
              "padding": "4rem",
              "& when (@fullWidth)": {
                "left": "10%",
                "top": "-45%"
              },
              "@media (max-width: 991px)": {
                "display": "none"
              }
            }
          },
          "_cid": "uHesvRJitp",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "team2-23"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-text, .item .mbr-section-btn": {
              "text-align": "left"
            },
            ".item-wrapper": {
              "background": "@cardbg",
              "margin-bottom": "2rem",
              "padding": "2.25rem",
              "@media (min-width: 992px) and (max-width: 1200px)": {
                "padding": "2rem 1.5rem",
                "margin-bottom": "2rem"
              },
              "@media (max-width: 767px)": {
                "padding": "2rem 1.5rem",
                "margin-bottom": "1rem"
              }
            }
          },
          "_name": "list05",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list05\" group=\"List\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Question\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Card BG\" name=\"cardbg\" value=\"#ffffff\" selected>\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#edefeb\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"col-12 mb-5 content-head\" mbr-if=\"showMainTitle || showMainSubtitle\">\n            <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\"><b>Frequently Asked Questions</b></h3>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">Find answers to your questions about FIGY Travel Foundation and our volunteer programs in Mwanza, Tanzania.</h5>\n        </div>\n        <div class=\"row justify-content-center \">\n            <div class=\" col-12 col-lg-{{textWidth}}\">\n                <div class=\"item features-without-image col-12 active\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>What is FIGY Travel Foundation?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            FIGY Travel Foundation is a volunteer travel foundation that provides opportunities for people to volunteer in Mwanza, Tanzania through volunteer programs.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>What is the purpose of FIGY Travel Foundation?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">The purpose of FIGY Travel Foundation is to make a difference in Tanzania by getting more people involved in volunteering and helping to shape the future of the community through one of our programs.</p>\n                    </div>\n                </div>\n                <div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>What type of programs does FIGY Travel Foundation offer?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            After the photoshoot, I will provide you with a private online gallery where you can view\n                            and download your edited photos. You'll receive a password-protected link that you can share\n                            with friends and family.\n                        </p>\n                    </div>\n                </div><div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>Who can participate in FIGY Travel Foundation programs?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            Anyone who is interested in volunteering and making a difference in Tanzania can participate in FIGY Travel programs. We also offer internship programs for Universities. Contact us through the application form.\n                        </p>\n                    </div>\n                </div><div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>How long are the FIGY TravelFoundation programs?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            The length of a FIGY Travel program depends on the specific program, but they typically last from a few weeks to several months.\n                        </p>\n                    </div>\n                </div><div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>What is included in a FIGY Travel Foundation program?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            The length of a FIGY Travel program depends on the specific program, but they typically last from a few weeks to several months.\n                        </p>\n                    </div>\n                </div><div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>How can I apply for a FIGY Travel Foundation program?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            The length of a FIGY Travel program depends on the specific program, but they typically last from a few weeks to several months.\n                        </p>\n                    </div>\n                </div><div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>What is included in a FIGY Travel Foundation program?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            The length of a FIGY Travel program depends on the specific program, but they typically last from a few weeks to several months.\n                        </p>\n                    </div>\n                </div><div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>What is excluded in a FIGY Travel Foundation program?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            The length of a FIGY Travel program depends on the specific program, but they typically last from a few weeks to several months.\n                        </p>\n                    </div>\n                </div><div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>Is prior teaching experience required for FIGY Travel Foundation Teaching program?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            Prior teaching experience is not required for the teaching volunteer program, but some experience or affinity may be helpful.\n                        </p>\n                    </div>\n                </div><div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>What is the relationship between FIGY Travel Foundation and Stichting Support School Fees?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            FIGY Travel Foundation and Stichting Support School Fees have a strong and collaborative relationship, aimed at providing support and assistance to the local communities in the Sengerema District of Tanzania. FIGY Travel was founded to enhance the resources of its partner foundation and provide additional funding sources through affordable volunteer programs. These programs allow volunteers to assist in areas such as teaching, healthcare and agriculture, while experiencing life in the local community in a safe and enriching environment. By participating in FIGY Travel's programs, volunteers can make a significant impact on the lives of those in need. The profits from these experiences are reinvested directly back into the schools where volunteers serve as teaching assistants and into other social projects. Through the efforts of FIGY Travel and Stichting Support School Fees, the two organizations have been able to sponsor 276 children and teachers, donate over 2,400 goods, and place 3 water wells. With the help of our volunteers, we believe that we can make even greater positive change in the lives of those in the Sengerema District in Tanzania.\n                        </p>\n                    </div>\n                </div><div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>How does FIGY Travel Foundation differ from other volunteer travel organizations?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            At FIGY Travel, we strive to offer the most impactful, affordable and authentic volunteer travel experiences to young people around the world. Unlike other organizations, we have a unique partnership with our partner foundation, Stichting Support School Fees, which allows us to have a direct impact on the communities we serve in the Sengerema District of Tanzania. Additionally, we provide our volunteers with the opportunity to fully immerse themselves in the local culture, participate in cultural activities and even add on a Safari tour or visit to the beautiful island of Zanzibar. Our goal is to offer a holistic travel experience that allows our volunteers to make a meaningful impact, learn about new cultures, and have unforgettable memories.\n                        </p>\n                    </div>\n                </div><div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>How is the cost of FIGY Travel Foundation trips kept affordable while still providing guests with quality experiences and support?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">At FIGY Travel, we understand the importance of affordability and quality. That's why we work with small local suppliers to keep the cost of our trips low. By partnering with these local suppliers, we are able to provide our guests with authentic experiences while supporting local businesses and keeping the cost of our trips below that charged by large international tourist organizations. Additionally, we believe that the profits earned from our trips should be reinvested directly back into the communities where our volunteers work, which is why we have partnered with our partner foundation, Stichting Support School Fees. Through this partnership, we are able to provide our guests with quality experiences and support while making a meaningful impact on the local communities in Tanzania.</p>\n                    </div>\n                </div><div class=\"item features-without-image col-12\">\n                    <div class=\"item-wrapper\">\n                        <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\"><b>Can volunteers choose to focus their efforts in specific areas such as teaching, healthcare, or agriculture?</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mt-0 mb-3\" data-app-selector=\".mbr-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n                            At FIGY Travel, we strive to offer the most impactful, affordable and authentic volunteer travel experiences to young people around the world. Unlike other organizations, we have a unique partnership with our partner foundation, Stichting Support School Fees, which allows us to have a direct impact on the communities we serve in the Sengerema District of Tanzania. Additionally, we provide our volunteers with the opportunity to fully immerse themselves in the local culture, participate in cultural activities and even add on a Safari tour or visit to the beautiful island of Zanzibar. Our goal is to offer a holistic travel experience that allows our volunteers to make a meaningful impact, learn about new cultures, and have unforgettable memories.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uHesvUj3kf",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "list05-24"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 50px",
                "@media (max-width: 1440px)": {
                  "padding": "0 40px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "display": "flex",
                  "height": "100%",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  ".item-content": {
                    "position": "relative",
                    "z-index": "1",
                    ".item-text": {
                      "margin-bottom": "60px",
                      "line-height": "1",
                      "@media (max-width: 768px)": {
                        "margin-bottom": "30px"
                      },
                      "span": {
                        "opacity": ".5"
                      }
                    }
                  },
                  ".item-img": {
                    "padding-right": "180px",
                    "@media (max-width: 768px)": {
                      "padding-right": "0"
                    },
                    ".name-wrapper": {
                      "display": "inline-flex",
                      "align-items": "center",
                      "img": {
                        "width": "70px",
                        "height": "70px",
                        "min-width": "70px",
                        "object-fit": "cover",
                        "border-radius": "100% !important",
                        "margin-right": "20px"
                      },
                      "a": {
                        "width": "70px",
                        "height": "70px",
                        "margin-left": "20px"
                      },
                      ".name-wrap": {
                        "position": "relative",
                        "z-index": "1",
                        ".item-name": {
                          "display": "inline-flex",
                          "position": "relative",
                          "margin-bottom": "10px",
                          "padding-left": "24px",
                          "&::before": {
                            "content": "''",
                            "position": "absolute",
                            "top": "3px",
                            "left": "0",
                            "width": "14px",
                            "height": "14px",
                            "border-radius": "100%",
                            "background-color": "@marker"
                          }
                        },
                        ".item-role": {
                          "margin-bottom": "0",
                          "opacity": ".5"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "70px",
              "height": "70px",
              "margin-top": "-1.5rem",
              "font-size": "32px",
              "background-color": "transparent !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "background-color": "@arrowsBg !important"
              },
              "&.embla__button--prev": {
                "right": "4rem",
                "border-radius": "6.25rem 0 0 6.25rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "border-radius": "0 6.25rem 6.25rem 0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "@media (max-width: 768px)": {
                  "padding-bottom": "6rem"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-name": {
              "color": "#ffffff"
            },
            ".item-role": {
              "color": "#ffffff"
            },
            ".item-text": {
              "color": "#ffffff"
            }
          },
          "_name": "slider04",
          "_sourceTheme": "forwardm5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider04 mbr-embla forwardm5\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"3\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n                checked\r\n        />\r\n        <input type=\"color\" title=\"Arrows Color\" value=\"#ffffff\" name=\"arrowsColor\" condition=\"arrows\" selected/>\r\n        <input type=\"color\" title=\"Arrows BG\" value=\"#82d7ff\" name=\"arrowsBg\" condition=\"arrows\" selected/>\r\n        <header>Cards</header>\r\n        <input type=\"checkbox\" name=\"showText\" title=\"Card Text\" checked/>\r\n        <input type=\"checkbox\" name=\"showName\" title=\"Card Name\" checked/>\r\n        <input type=\"color\" title=\"Marker Color\" value=\"#ffffff\" name=\"marker\" condition=\"showName\" selected/>\r\n        <input type=\"checkbox\" name=\"showRole\" title=\"Card Role\" checked/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax required>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/forwardm5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#3799EA\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12 col-lg-8\">\r\n                <div\r\n                        class=\"embla\"\r\n                        data-loop=\"{{loop}}\"\r\n                        data-auto-play=\"{{autoplay}}\"\r\n                        data-auto-play-interval=\"{{interval}}\"\r\n                        data-draggable=\"{{draggable}}\"\r\n                        data-skip-snaps=\"true\"\r\n                        data-align=\"center\"\r\n                        data-contain-scroll=\"trimSnaps\"\r\n                >\r\n                    <div class=\"embla__viewport\">\r\n                        <div class=\"embla__container\">\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                               data-app-selector=\".item-text\" mbr-if=\"showText\">\r\n                                                \"I engaged with this software development company to create a custom\r\n                                                solution for my business, and the results were outstanding. The team\r\n                                                exhibited a deep understanding of our requirements.\"\r\n                                            </p>\r\n                                        </div>\r\n                                        <div class=\"item-img\">\r\n                                            <div class=\"name-wrapper\">\r\n                                                <img src=\"@ADDONS_PATH@/forwardm5/components/_images/forward/image18.jpg\"\r\n                                                     alt=\"Mobirise Website Builder\"/>\r\n                                                <div class=\"name-wrap\">\r\n                                                    <p class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                       data-app-selector=\".item-name, .item-img\" mbr-if=\"showName\">\r\n                                                        Phyllis Jones\r\n                                                    </p>\r\n                                                    <p class=\"item-role mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                       data-app-selector=\".item-role, .item-img\" mbr-if=\"showRole\">\r\n                                                        Senior Project Manager\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                               data-app-selector=\".item-text\" mbr-if=\"showText\">\r\n                                                \"As a startup founder, finding a trustworthy mobile app development\r\n                                                partner was crucial for our success. This software development company\r\n                                                not only met but surpassed our expectations.\"\r\n                                            </p>\r\n                                        </div>\r\n                                        <div class=\"item-img\">\r\n                                            <div class=\"name-wrapper\">\r\n                                                <img src=\"@ADDONS_PATH@/forwardm5/components/_images/forward/image21.jpg\"\r\n                                                     alt=\"Mobirise Website Builder\"/>\r\n                                                <div class=\"name-wrap\">\r\n                                                    <p class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                       data-app-selector=\".item-name, .name-wrapper\" mbr-if=\"showName\">\r\n                                                        Kathy White\r\n                                                    </p>\r\n                                                    <p class=\"item-role mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                       data-app-selector=\".item-role, .name-wrapper\" mbr-if=\"showRole\">\r\n                                                        Human Resources Specialist\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                               data-app-selector=\".item-text\" mbr-if=\"showText\">\r\n                                                \"Our experience with this software development company for cloud\r\n                                                computing services was nothing short of excellent. They efficiently set\r\n                                                up our cloud infrastructure.\"\r\n                                            </p>\r\n                                        </div>\r\n                                        <div class=\"item-img\">\r\n                                            <div class=\"name-wrapper\">\r\n                                                <img src=\"@ADDONS_PATH@/forwardm5/components/_images/forward/image14.jpg\"\r\n                                                     alt=\"Mobirise Website Builder\"/>\r\n                                                <div class=\"name-wrap\">\r\n                                                    <p class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                       data-app-selector=\".item-name, .name-wrapper\" mbr-if=\"showName\">\r\n                                                        Mark Smith\r\n                                                    </p>\r\n                                                    <p class=\"item-role mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                       data-app-selector=\".item-role, .name-wrapper\" mbr-if=\"showRole\">\r\n                                                        Software Engineer\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <button class=\"embla__button embla__button--prev\">\r\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                    </button>\r\n                    <button class=\"embla__button embla__button--next\">\r\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uHesvWWBat",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider04-25"
        },
        {
          "_name": "slider01",
          "_sourceTheme": "progressm5",
          "_customHTML": "<section data-bs-version=\"5.1\"\n        class=\"slider01 mbr-embla progressm5\"\n        group=\"Gallery & Slider\"\n        plugins=\"embla\"\n        mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\"\n>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\"/>\n        <input\n                type=\"range\"\n                inline\n                title=\"Top\"\n                name=\"paddingTop\"\n                min=\"0\"\n                max=\"10\"\n                step=\"1\"\n                value=\"5\"\n        />\n        <input\n                type=\"range\"\n                inline\n                title=\"Bottom\"\n                name=\"paddingBottom\"\n                min=\"0\"\n                max=\"10\"\n                step=\"1\"\n                value=\"5\"\n        />\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\"/>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked/>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\n        <input\n                type=\"range\"\n                title=\"Interval\"\n                name=\"interval\"\n                min=\"1\"\n                max=\"10\"\n                value=\"4\"\n                step=\"1\"\n                condition=\"autoplay\"\n        />\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\n        <input\n                type=\"checkbox\"\n                name=\"arrowsMobile\"\n                title=\"Mobile Arrows\"\n                condition=\"arrows\"\n                checked\n        />\n        <input type=\"color\" name=\"arrowsBg\" title=\"Arrows BG\" value=\"#252525\" condition=\"arrows\"/>\n        <input type=\"color\" name=\"arrowsColor\" title=\"Arrows Color\" value=\"#ffffff\" condition=\"arrows\"/>\n        <header>Cards</header>\n        <input\n                type=\"range\"\n                name=\"gap\"\n                title=\"Gap\"\n                min=\"0\"\n                max=\"10\"\n                step=\"1\"\n                value=\"1\"\n        />\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Card Title\" checked/>\n        <input type=\"color\" name=\"border\" title=\"Card Border\" value=\"#078efb\"/>\n        <input type=\"color\" name=\"shadow\" title=\"Card Shadow\" value=\"#060606\"/>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/progressm5/components/_images/background1.jpg\"/>\n            <input type=\"color\" title=\"Color\" value=\"#060606\" selected/>\n        </fieldset>\n        <input\n                type=\"checkbox\"\n                title=\"Overlay\"\n                name=\"overlay\"\n                condition=\"bg.type !== 'color'\"\n                checked\n        />\n        <input\n                type=\"color\"\n                title=\"Overlay Color\"\n                name=\"overlayColor\"\n                value=\"#060606\"\n                condition=\"overlay && bg.type == 'image'\"\n        />\n        <input\n                type=\"range\"\n                inline\n                title=\"Opacity\"\n                name=\"overlayOpacity\"\n                min=\"0\"\n                max=\"1\"\n                step=\"0.1\"\n                value=\"0.1\"\n                condition=\"overlay && bg.type == 'image'\"\n        />\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"title-wrapper\" mbr-if=\"showTitle || showText\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\"\n                            data-app-selector=\".mbr-section-title\"\n                            mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                            Main functions\n                        </h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                               mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Virtual assistants (VAs) are AI-powered tools designed to assist users with a wide range\n                                of tasks, enhancing productivity, efficiency, and convenience.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"slider-wrapper\">\n                        <div\n                                class=\"embla\"\n                                data-loop=\"{{loop}}\"\n                                data-auto-play=\"{{autoplay}}\"\n                                data-auto-play-interval=\"{{interval}}\"\n                                data-draggable=\"{{draggable}}\"\n                                data-skip-snaps=\"true\"\n                                data-align=\"center\"\n                                data-contain-scroll=\"trimSnaps\"\n                        >\n                            <div class=\"embla__viewport\">\n                                <div class=\"embla__container\">\n                                    <div class=\"embla__slide slider-image item\"\n                                         mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                                <div class=\"item-content\">\n                                                    <h4 class=\"item-title mbr-fonts-style\"\n                                                        mbr-theme-style=\"display-5\"\n                                                        data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                        They help users create and manage task lists, ensuring deadlines\n                                                        are met and tasks.\n                                                    </h4>\n                                                </div>\n                                                <div class=\"item-img\">\n                                                    <div class=\"item-wrap item-number\">\n                                                        <img src=\"@ADDONS_PATH@/progressm5/components/_images/progress/image5.jpg\"\n                                                             alt=\"Mobirise Website Builder\"/>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\"\n                                         mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                                <div class=\"item-content\">\n                                                    <h4 class=\"item-title mbr-fonts-style\"\n                                                        mbr-theme-style=\"display-5\"\n                                                        data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                        They can send and receive text messages or instant messages, and\n                                                        sometimes even engage.\n                                                    </h4>\n                                                </div>\n                                                <div class=\"item-img\">\n                                                    <div class=\"item-wrap item-number\">\n                                                        <img src=\"@ADDONS_PATH@/progressm5/components/_images/progress/image19.jpg\"\n                                                             alt=\"Mobirise Website Builder\"/>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\"\n                                         mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                                <div class=\"item-content\">\n                                                    <h4 class=\"item-title mbr-fonts-style\"\n                                                        mbr-theme-style=\"display-5\"\n                                                        data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                        They can retrieve information from databases, documents, and\n                                                        other resources as requested.\n                                                    </h4>\n                                                </div>\n                                                <div class=\"item-img\">\n                                                    <div class=\"item-wrap item-number\">\n                                                        <img src=\"@ADDONS_PATH@/progressm5/components/_images/progress/image12.jpg\"\n                                                             alt=\"Mobirise Website Builder\"/>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <button class=\"embla__button embla__button--prev\">\n                                <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                            </button>\n                            <button class=\"embla__button embla__button--next\">\n                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".title-wrapper": {
              "margin-bottom": "60px",
              "@media (max-width: 992px)": {
                "margin-bottom": "48px"
              },
              ".mbr-section-title": {
                "margin-bottom": "24px"
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-block",
                  "width": "50%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "display": "flex",
                  "align-items": "center",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".item-content": {
                    "width": "40%",
                    "padding-right": "90px",
                    "position": "relative",
                    "z-index": "1",
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "padding-right": "0"
                    },
                    "& when (@reverseContent)": {
                      "padding-right": "0",
                      "padding-left": "90px",
                      "@media (max-width: 992px)": {
                        "padding-left": "0"
                      }
                    },
                    ".item-title": {
                      "margin-bottom": "0",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "36px"
                      }
                    }
                  },
                  ".item-img": {
                    "position": "relative",
                    "width": "60%",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    },
                    "&:before": {
                      "content": "''",
                      "width": "100%",
                      "height": "30%",
                      "position": "absolute",
                      "bottom": "-1px",
                      "left": "0",
                      "background-image": "linear-gradient(0deg, @shadow 40%, transparent 98%)"
                    },
                    ".item-wrap": {
                      "padding": "12px",
                      "border": "2px solid @border",
                      "@media (max-width: 992px)": {
                        "padding": "16px"
                      },
                      "img": {
                        "height": "360px",
                        "width": "100%",
                        "object-fit": "cover",
                        "@media (max-width: 992px)": {
                          "height": "300px"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "50%",
              "width": "48px",
              "height": "48px",
              "font-size": "24px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "@media (max-width: 992px)": {
                "bottom": "0"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "transform": "scale(1.05)"
              },
              "&.embla__button--prev": {
                "left": "0"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "padding": "0 12%",
              "@media (max-width: 992px)": {
                "padding": "0"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#9aa0a6",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#ffffff"
            }
          },
          "_cid": "uHesvZxYop",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider01-26"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 30px",
                "@media (max-width: 768px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".row": {
              "margin": "0",
              "padding": "60px 16px 60px",
              "background-color": "@container",
              "border-radius": "20px",
              "justify-content": "space-between",
              "@media (max-width: 992px)": {
                "padding": "46px 4px 46px"
              },
              ".card": {
                "justify-content": "flex-end"
              }
            },
            ".content-wrapper": {
              ".mbr-desc": {
                "margin-bottom": "32px"
              },
              ".mbr-section-title": {
                "margin-bottom": "32px"
              }
            },
            ".mbr-section-btn": {
              "margin-bottom": "22px",
              "@media (max-width: 992px)": {
                "text-align": "left"
              },
              "text-align": "right"
            },
            ".tags-wrapper": {
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".list": {
                "display": "flex",
                "flex-wrap": "wrap",
                "margin": "0",
                "padding": "0",
                "list-style-type": "none",
                ".item-wrap": {
                  "margin": "0 32px 32px 0"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "314px",
              "max-width": "314px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".item-img": {
                    "margin-bottom": "50px",
                    "@media (max-width: 768px)": {
                      "margin-bottom": "20px"
                    },
                    "img": {
                      "height": "360px",
                      "border-radius": "20px !important",
                      "object-fit": "cover",
                      "@media (max-width: 768px)": {
                        "height": "300px"
                      }
                    }
                  },
                  ".item-content": {
                    "z-index": "1",
                    "position": "relative",
                    ".item-name": {
                      "margin-bottom": "5px"
                    },
                    ".item-role": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "48px",
              "height": "48px",
              "margin-top": "-1.5rem",
              "font-size": "18px",
              "background-color": "transparent !important",
              "color": "@infoColor !important",
              "border": "2px solid @infoColor !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": ".6 !important",
              "@media (max-width: 768px)": {
                "bottom": "0"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": "1 !important"
              },
              "&.embla__button--prev": {
                "left": "30px"
              },
              "&.embla__button--next": {
                "right": "30px"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-bottom": "80px"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#616161"
            },
            ".item-name": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-role": {
              "color": "#ffffff",
              "text-align": "center"
            }
          },
          "_name": "slider04",
          "_sourceTheme": "immersem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider04 mbr-embla\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\r\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Description\" checked/>\r\n        <input type=\"checkbox\" name=\"showTags\" title=\"Tags\" checked/>\r\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked/>\r\n        <input type=\"color\" name=\"container\" title=\"Container BG\" value=\"#1e1e1e\"/>\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"5\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n                checked\r\n        />\r\n        <header>Cards</header>\r\n        <input\r\n                type=\"range\"\r\n                name=\"gap\"\r\n                title=\"Gap\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"2\"\r\n        />\r\n        <input type=\"checkbox\" name=\"showName\" title=\"Name\" checked/>\r\n        <input type=\"checkbox\" name=\"showRole\" title=\"Role\" checked/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/immersem5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n            <div class=\"col-12 col-lg-5 card\">\r\n                <div class=\"content-wrapper\" mbr-if=\"showTitle || showDesc || showTags\">\r\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                       mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\">\r\n                        Exceptional students\r\n                    </p>\r\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"\r\n                        data-app-selector=\".mbr-section-title, .mbr-section-btn\">\r\n                        <b>These high achievers are academically gifted</b>\r\n                    </h2>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 col-lg-5 card\">\r\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"\r\n                     data-toolbar=\"-mbrBtnMove\">\r\n                    <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                        Start Now\r\n                    </a>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12\">\r\n                <div class=\"tags-wrapper\" mbr-if=\"showTags\">\r\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                        data-app-selector=\".list, .item-wrap, .tags-wrapper\"\r\n                        data-multiline mbr-article>\r\n                        <li class=\"item-wrap\"><b>Leadership</b></li>\r\n                        <li class=\"item-wrap\"><b>Innovation</b></li>\r\n                        <li class=\"item-wrap\"><b>Commitment</b></li>\r\n                        <li class=\"item-wrap\"><b>Educational</b></li>\r\n                        <li class=\"item-wrap\"><b>Institute</b></li>\r\n                        <li class=\"item-wrap\"><b>Academic</b></li>\r\n                        <li class=\"item-wrap\"><b>Pursuits</b></li>\r\n                        <li class=\"item-wrap\"><b>Subjects</b></li>\r\n                        <li class=\"item-wrap\"><b>Intellectual growth</b></li>\r\n                        <li class=\"item-wrap\"><b>Humanities</b></li>\r\n                        <li class=\"item-wrap\"><b>Arts</b></li>\r\n                        <li class=\"item-wrap\"><b>Mastery</b></li>\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12\">\r\n                <div\r\n                        class=\"embla\"\r\n                        data-loop=\"{{loop}}\"\r\n                        data-auto-play=\"{{autoplay}}\"\r\n                        data-auto-play-interval=\"{{interval}}\"\r\n                        data-draggable=\"{{draggable}}\"\r\n                        data-skip-snaps=\"true\"\r\n                        data-align=\"center\"\r\n                        data-contain-scroll=\"trimSnaps\"\r\n                >\r\n                    <div class=\"embla__viewport\">\r\n                        <div class=\"embla__container\">\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/immersem5/components/_images/immerse/image16.jpg\"\r\n                                                 alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name\" mbr-if=\"showName\">\r\n                                                <b>Dr. Emily Parker</b>\r\n                                            </h4>\r\n                                            <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                               mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                Medical Pioneer\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/immersem5/components/_images/immerse/image14.jpg\"\r\n                                                 alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name\" mbr-if=\"showName\">\r\n                                                <b>Alex Rodriguez</b>\r\n                                            </h4>\r\n                                            <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                               mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                Tech Innovator\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/immersem5/components/_images/immerse/image17.jpg\"\r\n                                                 alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name\" mbr-if=\"showName\">\r\n                                                <b>Dr. Maya Patel</b>\r\n                                            </h4>\r\n                                            <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                               mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                Environmental Advocate\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/immersem5/components/_images/immerse/image18.jpg\"\r\n                                                 alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name\" mbr-if=\"showName\">\r\n                                                <b>James Mitchell</b>\r\n                                            </h4>\r\n                                            <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                               mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                Sustainable Business Entrepreneur\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/immersem5/components/_images/immerse/image19.jpg\"\r\n                                                 alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name\" mbr-if=\"showName\">\r\n                                                <b>Sarah Williams</b>\r\n                                            </h4>\r\n                                            <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                               mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                Human Rights Ambassador\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/immersem5/components/_images/immerse/image24.jpg\"\r\n                                                 alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".item-name\" mbr-if=\"showName\">\r\n                                                <b>Daniel Chang</b>\r\n                                            </h4>\r\n                                            <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                               mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                Finance Visionary\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <button class=\"embla__button embla__button--prev\">\r\n                        <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                    </button>\r\n                    <button class=\"embla__button embla__button--next\">\r\n                        <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uHesw2kf4g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider04-27"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 80px",
                "@media (max-width: 1200px)": {
                  "padding": "0 40px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "40px",
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              },
              ".mbr-desc": {
                "margin-bottom": "0"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "flex",
              "justify-content": "center",
              "img": {
                "position": "absolute",
                "top": "0",
                "width": "200vh",
                "height": "100%",
                "object-fit": "cover"
              },
              "&::before": {
                "content": "''",
                "position": "absolute",
                "bottom": "0",
                "width": "200vh",
                "height": "40%",
                "background-image": "linear-gradient(transparent, @shadow 65%)",
                "z-index": "1"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".item-date": {
                    "margin-bottom": "10px"
                  },
                  ".list": {
                    "padding": "0",
                    "margin-bottom": "30px",
                    "list-style-position": "inside",
                    ".item-wrap": {
                      "margin-bottom": "10px",
                      "&:last-child": {
                        "margin-bottom": "0"
                      }
                    }
                  },
                  ".icon-wrapper": {
                    ".mbr-iconfont": {
                      "display": "inline-flex",
                      "font-size": "30px",
                      "width": "32px",
                      "height": "32px",
                      "color": "@icon"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "55px",
              "height": "55px",
              "margin-top": "-1.5rem",
              "font-size": "16px",
              "background-color": "transparent !important",
              "color": "@arrowsColor !important",
              "border": "1px solid @arrowsColor !important",
              "border-radius": "100%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "&::before": {
                "content": "''",
                "position": "absolute",
                "width": "55px",
                "height": "55px",
                "border-radius": "100%",
                "opacity": ".4",
                "background-color": "@arrowsColor"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": "1 !important"
              },
              "&.embla__button--prev": {
                "left": "0",
                "@media (max-width: 992px)": {
                  "left": "20px"
                }
              },
              "&.embla__button--next": {
                "right": "0",
                "@media (max-width: 992px)": {
                  "right": "20px"
                }
              },
              "@media (max-width: 992px)": {
                "top": "auto",
                "bottom": "1rem"
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".embla": {
              "position": "relative",
              "z-index": "1",
              "padding": "40px 55px",
              "@media (max-width: 992px)": {
                "padding": "40px 20px 4rem"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-desc": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-date": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-date, .icon-wrapper": {
              "text-align": "center"
            }
          },
          "_name": "slider04",
          "_sourceTheme": "essencem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider04 mbr-embla essencem5\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\"/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\r\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Description\" checked/>\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"5\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input type=\"color\" name=\"arrowsColor\" title=\"Arrows Color\" value=\"#ffffff\" condition=\"arrows\"/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n                checked\r\n        />\r\n        <header>Cards</header>\r\n        <input type=\"checkbox\" name=\"showDate\" title=\"Card Date\" checked/>\r\n        <input type=\"checkbox\" name=\"showList\" title=\"Card List\" checked/>\r\n        <input type=\"checkbox\" name=\"showIcon\" title=\"Card Icon\" checked/>\r\n        <input type=\"color\" name=\"icon\" title=\"Icon Color\" value=\"#ffffff\" condition=\"showIcon\"/>\r\n        <input type=\"color\" name=\"shadow\" title=\"Shadow Color\" value=\"#000000\"/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax required>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/essencem5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12 card\">\r\n                <div class=\"title-wrapper\" mbr-if=\"showTitle || showDesc\">\r\n                    <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                        data-app-selector=\".mbr-section-title, .mbr-section-btn\"\r\n                        mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                        <b>KEY PURPOSES</b>\r\n                    </h2>\r\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\"\r\n                       mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\r\n                        The purpose of recycled goods is rooted in the principles of environmental responsibility\r\n                    </p>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 card\">\r\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n                    <img src=\"@ADDONS_PATH@/essencem5/components/_images/background7.jpg\" alt=\"Mobirise\">\r\n                    <div\r\n                            class=\"embla\"\r\n                            data-loop=\"{{loop}}\"\r\n                            data-auto-play=\"{{autoplay}}\"\r\n                            data-auto-play-interval=\"{{interval}}\"\r\n                            data-draggable=\"{{draggable}}\"\r\n                            data-skip-snaps=\"true\"\r\n                            data-align=\"center\"\r\n                            data-contain-scroll=\"trimSnaps\"\r\n                    >\r\n                        <div class=\"embla__viewport\">\r\n                            <div class=\"embla__container\">\r\n                                <div class=\"embla__slide features-without-image slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-1\"\r\n                                               data-app-selector=\".item-date, .icon-wrapper\" mbr-if=\"showDate\">\r\n                                                <b>2030</b>\r\n                                            </p>\r\n                                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".list, .item-wrap\" mbr-if=\"showList\"\r\n                                                data-multiline mbr-article>\r\n                                                <li class=\"item-wrap\">Recycling helps conserve finite natural\r\n                                                    resources\r\n                                                </li>\r\n                                                <li class=\"item-wrap\">Producing goods from recycled materials generally\r\n                                                    requires less energy\r\n                                                </li>\r\n                                                <li class=\"item-wrap\">This energy efficiency contributes to the\r\n                                                    reduction of greenhouse gas\r\n                                                </li>\r\n                                            </ul>\r\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-arrow-up mobi-mbri\"></span>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide features-without-image slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-1\"\r\n                                               data-app-selector=\".item-date, .icon-wrapper\" mbr-if=\"showDate\">\r\n                                                <b>2031</b>\r\n                                            </p>\r\n                                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".list, .item-wrap\" mbr-if=\"showList\"\r\n                                                data-multiline mbr-article>\r\n                                                <li class=\"item-wrap\">Recycling diverts materials from landfills</li>\r\n                                                <li class=\"item-wrap\">This, in turn, helps reduce environmental\r\n                                                    pollution\r\n                                                </li>\r\n                                            </ul>\r\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-arrow-up mobi-mbri\"></span>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide features-without-image slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-1\"\r\n                                               data-app-selector=\".item-date, .icon-wrapper\" mbr-if=\"showDate\">\r\n                                                <b>2032</b>\r\n                                            </p>\r\n                                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                data-app-selector=\".list, .item-wrap\" mbr-if=\"showList\"\r\n                                                data-multiline mbr-article>\r\n                                                <li class=\"item-wrap\">Recycled goods promote the concept of a circular\r\n                                                    economy\r\n                                                </li>\r\n                                                <li class=\"item-wrap\">This approach minimizes the linear\r\n                                                    \"take-make-dispose\" model\r\n                                                </li>\r\n                                                <li class=\"item-wrap\">Fostering sustainability and waste reduction.</li>\r\n                                            </ul>\r\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-arrow-up mobi-mbri\"></span>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <button class=\"embla__button embla__button--prev\">\r\n                            <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                        </button>\r\n                        <button class=\"embla__button embla__button--next\">\r\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uHesw59OUz",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider04-28"
        },
        {
          "_name": "slider01",
          "_sourceTheme": "resumem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider01 mbr-embla resumem5\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\"/>\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked/>\r\n        <input type=\"checkbox\" title=\"Tags\" name=\"showTags\" checked/>\r\n        <input type=\"range\" inline title=\"Tags Amount\" name=\"tags\" min=1\" max=\"3\" step=\"1\" value=\"2\"\r\n               condition=\"showTags\"/>\r\n        <input type=\"color\" title=\"Border Color\" value=\"#898989\" name=\"tag\" condition=\"showTags\" selected/>\r\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked/>\r\n        <input type=\"color\" title=\"Shadow Color\" value=\"#333333\" name=\"shadow\" selected/>\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"3\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\"/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n                checked\r\n        />\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax required>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/resumem5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#f0f0f0\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#f0f0f0\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n            <div class=\"col-12\">\r\n                <div class=\"title-wrapper\">\r\n                    <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                        data-app-selector=\".mbr-section-title\"\r\n                        mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                        Diverse range of projects\r\n                    </h2>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 col-lg-4\">\r\n                <div class=\"content-wrapper\">\r\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\"\r\n                        data-app-selector=\".mbr-section-subtitle, .mbr-section-btn, .tags-wrapper\"\r\n                        mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\r\n                        Portfolio Websites\r\n                    </h3>\r\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\r\n                       mbr-theme-style=\"display-7\" mbr-if=\"showText\">\r\n                        Remember, the key is to curate a portfolio that not only reflects technical skills but also\r\n                        tells a story.\r\n                    </p>\r\n                    <div class=\"tags-wrapper\" mbr-if=\"showTags\">\r\n                        <div class=\"tags-wrap\">\r\n                            <p class=\"mbr-tag mbr-fonts-style\" data-app-selector=\".mbr-tag\"\r\n                               mbr-theme-style=\"display-4\">\r\n                                UI/UX\r\n                            </p>\r\n                            <p class=\"mbr-tag mbr-fonts-style\" data-app-selector=\".mbr-tag\"\r\n                               mbr-theme-style=\"display-4\" mbr-if=\"tags > 1\">\r\n                                Logo\r\n                            </p>\r\n                            <p class=\"mbr-tag mbr-fonts-style\" data-app-selector=\".mbr-tag\"\r\n                               mbr-theme-style=\"display-4\" mbr-if=\"tags > 2\">\r\n                                Content\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                         mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                        <a class=\"btn btn-success-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\r\n                            View more\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 col-lg-7\">\r\n                <div\r\n                        class=\"embla\"\r\n                        data-loop=\"{{loop}}\"\r\n                        data-auto-play=\"{{autoplay}}\"\r\n                        data-auto-play-interval=\"{{interval}}\"\r\n                        data-draggable=\"{{draggable}}\"\r\n                        data-skip-snaps=\"true\"\r\n                        data-align=\"center\"\r\n                        data-contain-scroll=\"trimSnaps\"\r\n                >\r\n                    <div class=\"embla__viewport\">\r\n                        <div class=\"embla__container\">\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/resumem5/components/_images/resume/image1.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/resumem5/components/_images/resume/image6.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/resumem5/components/_images/resume/image13.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <button class=\"embla__button embla__button--prev\">\r\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                    </button>\r\n                    <button class=\"embla__button embla__button--next\">\r\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 64px",
                "@media (max-width: 1440px)": {
                  "padding": "0 36px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 16px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "80px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "36px"
                }
              }
            },
            ".content-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "48px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              },
              ".tags-wrapper": {
                "margin-bottom": "16px",
                ".tags-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  "@media (max-width: 992px)": {
                    "flex-direction": "column"
                  },
                  ".mbr-tag": {
                    "border": "4px solid @tag",
                    "padding": "8px 22px",
                    "display": "inline-flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "margin": "0 0 16px 16px",
                    "border-radius": "100em",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "@media (max-width: 992px)": {
                      "margin": "0 0 16px 0"
                    }
                  }
                }
              },
              ".mbr-section-btn": {
                ".btn-primary-outline, .btn-secondary-outline, .btn-success-outline, .btn-info-outline, .btn-warning-outline, .btn-danger-outline, .btn-black-outline, .btn-white-outline": {
                  "padding": "0",
                  "border": "none !important",
                  "&:hover, &:focus": {
                    "letter-spacing": ".1em",
                    "&::after": {
                      "opacity": "0"
                    }
                  }
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".item-img": {
                    "img": {
                      "height": "520px",
                      "object-fit": "cover",
                      "border-radius": "0 !important"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "32px",
              "height": "32px",
              "margin-top": "-1.5rem",
              "font-size": "26px",
              "background-color": "transparent !important",
              "color": "@primaryColor !important",
              "border": "none",
              "border-radius": "0",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "color": "@successColor !important"
              },
              "&.embla__button--prev": {
                "right": "6rem"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-bottom": "3rem"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem",
              "box-shadow": "0 7px 20px @shadow",
              "border-radius": ".5em"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-section-title": {
              "color": "#080808"
            },
            ".mbr-section-subtitle": {
