        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 80px",
                "@media (max-width: 1200px)": {
                  "padding": "0 40px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "40px",
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              },
              ".mbr-desc": {
                "margin-bottom": "0"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "flex",
              "justify-content": "center",
              "img": {
                "position": "absolute",
                "top": "0",
                "width": "200vh",
                "height": "100%",
                "object-fit": "cover"
              },
              "&::before": {
                "content": "''",
                "position": "absolute",
                "bottom": "0",
                "width": "200vh",
                "height": "40%",
                "background-image": "linear-gradient(transparent, @shadow 65%)",
                "z-index": "1"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".item-date": {
                    "margin-bottom": "10px"
                  },
                  ".list": {
                    "padding": "0",
                    "margin-bottom": "30px",
                    "list-style-position": "inside",
                    ".item-wrap": {
                      "margin-bottom": "10px",
                      "&:last-child": {
                        "margin-bottom": "0"
                      }
                    }
                  },
                  ".icon-wrapper": {
                    ".mbr-iconfont": {
                      "display": "inline-flex",
                      "font-size": "30px",
                      "width": "32px",
                      "height": "32px",
                      "color": "@icon"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "55px",
              "height": "55px",
              "margin-top": "-1.5rem",
              "font-size": "16px",
              "background-color": "transparent !important",
              "color": "@arrowsColor !important",
              "border": "1px solid @arrowsColor !important",
              "border-radius": "100%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "&::before": {
                "content": "''",
                "position": "absolute",
                "width": "55px",
                "height": "55px",
                "border-radius": "100%",
                "opacity": ".4",
                "background-color": "@arrowsColor"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": "1 !important"
              },
              "&.embla__button--prev": {
                "left": "0",
                "@media (max-width: 992px)": {
                  "left": "20px"
                }
              },
              "&.embla__button--next": {
                "right": "0",
                "@media (max-width: 992px)": {
                  "right": "20px"
                }
              },
              "@media (max-width: 992px)": {
                "top": "auto",
                "bottom": "1rem"
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".embla": {
              "position": "relative",
              "z-index": "1",
              "padding": "40px 55px",
              "@media (max-width: 992px)": {
                "padding": "40px 20px 4rem"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-desc": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-date": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-date, .icon-wrapper": {
              "text-align": "center"
            }
          },
          "_name": "slider04",
          "_sourceTheme": "essencem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider04 mbr-embla essencem5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Description\" checked>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"4\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"color\" name=\"arrowsColor\" title=\"Arrows Color\" value=\"#ffffff\" condition=\"arrows\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"showDate\" title=\"Card Date\" checked>\n        <input type=\"checkbox\" name=\"showList\" title=\"Card List\" checked>\n        <input type=\"checkbox\" name=\"showIcon\" title=\"Card Icon\" checked>\n        <input type=\"color\" name=\"icon\" title=\"Icon Color\" value=\"#ffffff\" condition=\"showIcon\">\n        <input type=\"color\" name=\"shadow\" title=\"Shadow Color\" value=\"#000000\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/essencem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#232323\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 card\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle || showDesc\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>KEY PURPOSES</b>\n                    </h2>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\n                        Mwanza lake view farm, giving back</p>\n                </div>\n            </div>\n            <div class=\"col-12 card\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <img src=\"@ADDONS_PATH@/essencem5/components/_images/background7.jpg\" alt=\"Mobirise\">\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".item-date, .icon-wrapper\" mbr-if=\"showDate\">\n                                                <b>Agriculture</b></p>\n                                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" mbr-if=\"showList\" data-multiline mbr-article>\n                                                <li class=\"item-wrap\">Recycling helps conserve finite natural\n                                                    resources\n                                                </li>\n                                                <li class=\"item-wrap\">Producing goods from recycled materials generally\n                                                    requires less energy\n                                                </li>\n                                                <li class=\"item-wrap\">This energy efficiency contributes to the\n                                                    reduction of greenhouse gas\n                                                </li>\n                                            </ul>\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-arrow-up mobi-mbri\"></span>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".item-date, .icon-wrapper\" mbr-if=\"showDate\">\n                                                <b>Teaching Education</b></p>\n                                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" mbr-if=\"showList\" data-multiline mbr-article>\n                                                <li class=\"item-wrap\">Recycling diverts materials from landfills</li>\n                                                <li class=\"item-wrap\">This, in turn, helps reduce environmental\n                                                    pollution\n                                                </li>\n                                            </ul>\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-arrow-up mobi-mbri\"></span>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".item-date, .icon-wrapper\" mbr-if=\"showDate\"><b>Healthcare</b></p>\n                                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" mbr-if=\"showList\" data-multiline mbr-article>\n                                                <li class=\"item-wrap\">Recycled goods promote the concept of a circular\n                                                    economy\n                                                </li>\n                                                <li class=\"item-wrap\">This approach minimizes the linear\n                                                    \"take-make-dispose\" model\n                                                </li>\n                                                <li class=\"item-wrap\">Fostering sustainability and waste reduction.</li>\n                                            </ul>\n                                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-arrow-up mobi-mbri\"></span>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uHejbVL2Aw",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider04-10"
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 992px)": {
                  "padding": "0 30px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 30px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "space-between",
              "align-items": "center",
              "padding": "20px 40px",
              "border": "1px solid @border",
              "border-radius": "2rem 0 2rem 0",
              "@media (max-width: 992px)": {
                "padding": "20px",
                "display": "block"
              },
              ".mbr-desc": {
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "margin-bottom": "30px"
                }
              },
              ".social-wrapper": {
                "display": "inline-flex",
                "flex-wrap": "wrap",
                ".soc-item": {
                  "margin-left": "50px",
                  "&:first-child": {
                    "margin-left": "0"
                  },
                  "a": {
                    "display": "block",
                    "&:hover, &:hover": {
                      ".mbr-iconfont": {
                        "color": "@active"
                      }
                    },
                    ".mbr-iconfont": {
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "width": "36px",
                      "height": "36px",
                      "color": "@socColor",
                      "font-size": "36px",
                      "transition": "all 0.3s ease-in-out",
                      "@media (max-width: 992px)": {
                        "width": "28px",
                        "height": "28px",
                        "font-size": "28px"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-desc": {
              "color": "#22654E"
            }
          },
          "_name": "article04",
          "_sourceTheme": "carem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 carem5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSoc\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"3\" step=\"1\" value=\"3\" condition=\"showSoc\">\n        <input type=\"color\" title=\"Social Color\" value=\"#000000\" name=\"socColor\" condition=\"showSoc\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#22654e\" name=\"active\" condition=\"showSoc\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#22654e\" name=\"border\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/carem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/carem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\">Follow us on our <b>social networks</b>\n                    </p>\n                    <div class=\"social-wrapper\" mbr-if=\"showSoc\">\n                        <div class=\"soc-item\">\n                            <a href=\"https://mobiri.se/\">\n                                <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                            </a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                            <a href=\"https://mobiri.se/\">\n                                <span mbr-icon class=\"mbr-iconfont socicon socicon-linkedin\"></span>\n                            </a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                            <a href=\"https://mobiri.se/\">\n                                <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uH81uDht6R",
