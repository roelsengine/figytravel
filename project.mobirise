              },
              ".social-wrapper": {
                "display": "inline-flex",
                "flex-wrap": "wrap",
                ".soc-item": {
                  "margin-left": "50px",
                  "&:first-child": {
                    "margin-left": "0"
                  },
                  "a": {
                    "display": "block",
                    "&:hover, &:hover": {
                      ".mbr-iconfont": {
                        "color": "@active"
                      }
                    },
                    ".mbr-iconfont": {
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "width": "36px",
                      "height": "36px",
                      "color": "@socColor",
                      "font-size": "36px",
                      "transition": "all 0.3s ease-in-out",
                      "@media (max-width: 992px)": {
                        "width": "28px",
