          "_name": "slider03",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider03 mbr-embla scalem5\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\"/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\"/>\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"8\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n                checked\r\n        />\r\n        <input type=\"color\" title=\"Arrows Color\" value=\"#635D60\" name=\"arrowsColor\" condition=\"arrows\" selected/>\r\n        <input type=\"color\" title=\"Active Color\" value=\"#ff5753\" name=\"active\" condition=\"arrows\" selected/>\r\n        <header>Cards</header>\r\n        <input\r\n                type=\"range\"\r\n                name=\"gap\"\r\n                title=\"Gap\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input type=\"checkbox\" name=\"showDate\" title=\"Title\" checked/>\r\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Description\" checked/>\r\n        <input type=\"color\" title=\"Border Color\" value=\"#d4d3d3\" name=\"border\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax required>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/scalem5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n            <div class=\"col-12 col-lg-5\">\r\n                <div class=\"image-wrapper\">\r\n                    <img src=\"@ADDONS_PATH@/scalem5/components/_images/scale/image16.jpg\" alt=\"Mobirise\">\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 col-lg-6\">\r\n                <div class=\"title-wrapper\">\r\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                        data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\">\r\n                        Software as a service\r\n                    </h2>\r\n                </div>\r\n                <div\r\n                        class=\"embla\"\r\n                        data-loop=\"{{loop}}\"\r\n                        data-auto-play=\"{{autoplay}}\"\r\n                        data-auto-play-interval=\"{{interval}}\"\r\n                        data-draggable=\"{{draggable}}\"\r\n                        data-skip-snaps=\"true\"\r\n                        data-align=\"center\"\r\n                        data-contain-scroll=\"trimSnaps\"\r\n                >\r\n                    <div class=\"embla__viewport\">\r\n                        <div class=\"embla__container\">\r\n                            <div class=\"embla__slide slider-image item features-without-image\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                data-app-selector=\".item-date\" mbr-if=\"showDate\">\r\n                                                2030\r\n                                            </h4>\r\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".item-desc\" mbr-if=\"showDesc\">\r\n                                                The SaaS industry continues to experience rapid growth\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item features-without-image\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                data-app-selector=\".item-date\" mbr-if=\"showDate\">\r\n                                                2030\r\n                                            </h4>\r\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".item-desc\" mbr-if=\"showDesc\">\r\n                                                Data security and privacy concerns remain a prominent\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item features-without-image\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                data-app-selector=\".item-date\" mbr-if=\"showDate\">\r\n                                                2030\r\n                                            </h4>\r\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".item-desc\" mbr-if=\"showDesc\">\r\n                                                SaaS providers are improving multi-tenancy capabilities\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item features-without-image\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                data-app-selector=\".item-date\" mbr-if=\"showDate\">\r\n                                                2030\r\n                                            </h4>\r\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".item-desc\" mbr-if=\"showDesc\">\r\n                                                Users often face integration challenges when trying to connect various\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item features-without-image\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <h4 class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                data-app-selector=\".item-date\" mbr-if=\"showDate\">\r\n                                                2030\r\n                                            </h4>\r\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".item-desc\" mbr-if=\"showDesc\">\r\n                                                SaaS platforms continue to utilize subscription-based pricing models\r\n                                            </p>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <button class=\"embla__button embla__button--prev\">\r\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont mbr-iconfont-btn\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                    </button>\r\n                    <button class=\"embla__button embla__button--next\">\r\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uHeswaDs8y",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider03-2a"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 30px",
                "@media (max-width: 768px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "height": "100%",
                  ".item-img": {
                    "position": "relative",
                    "min-height": "830px",
                    "border-radius": "20px !important",
                    "overflow": "hidden",
                    "padding": "60px 86px 80px",
                    "display": "flex",
                    "flex-direction": "column",
                    "justify-content": "space-between",
                    "@media (max-width: 992px)": {
                      "padding": "46px 20px 46px",
                      "min-height": "auto",
                      "height": "100%"
                    },
                    "img": {
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "border-radius": "20px !important",
                      "object-fit": "cover"
                    },
                    "& when (@showImageOverlay)": {
                      "&::before": {
                        "content": "''",
                        "position": "absolute",
                        "top": "0",
                        "left": "0",
                        "width": "100%",
                        "height": "100%",
                        "pointer-events": "none",
                        "z-index": "1",
                        "border-radius": "20px !important",
                        "background-color": "@imageOver",
                        "opacity": "@imageOverOpacity"
                      }
                    },
                    ".item-desc": {
                      "position": "relative",
                      "z-index": "1",
                      "margin-bottom": "32px"
                    },
                    ".title-wrapper": {
                      "position": "relative",
                      "z-index": "1",
                      "margin-bottom": "20px",
                      ".title-wrap": {
                        ".item-title": {
                          "display": "inline-flex",
                          "width": "60%",
                          "margin-bottom": "32px",
                          "@media (max-width: 768px)": {
                            "width": "100%"
                          }
                        }
                      }
                    },
                    ".name-wrapper": {
                      "position": "relative",
                      "z-index": "1",
                      "display": "inline-flex",
                      "align-items": "center",
                      "margin": "0 auto",
                      ".icon-wrapper": {
                        "margin-right": "32px",
                        "@media (max-width: 768px)": {
                          "margin-right": "16px"
                        },
                        ".mbr-iconfont": {
                          "font-size": "86px",
                          "border-radius": "100%",
                          "color": "@icon"
                        },
                        ".name-wrap": {
                          ".item-name": {
                            "margin-bottom": "16px"
                          },
                          ".item-role": {
                            "margin-bottom": "0"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "48px",
              "height": "48px",
              "margin-top": "-1.5rem",
              "font-size": "18px",
              "background-color": "transparent !important",
              "color": "@primaryColor !important",
              "border": "2px solid @primaryColor !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": ".6 !important",
              "@media (max-width: 768px)": {
                "top": "2.5rem",
                "color": "@primaryColor !important",
                "border": "2px solid @primaryColor !important"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": "1 !important"
              },
              "&.embla__button--prev": {
                "left": "30px"
              },
              "&.embla__button--next": {
                "right": "30px"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "padding-top": "100px"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-desc": {
              "color": "#000000",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#000000"
            },
            ".item-name": {
              "color": "#000000"
            },
            ".item-role": {
              "color": "#000000"
            },
            ".list": {
              "color": "#000000"
            },
            ".item-title, .mbr-section-btn, .title-wrap": {
              "text-align": "center"
            }
          },
          "_name": "slider03",
          "_sourceTheme": "immersem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider03 mbr-embla\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"5\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n        />\r\n        <header>Cards</header>\r\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Card Description\" checked/>\r\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Card Title\" checked/>\r\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked/>\r\n        <input type=\"checkbox\" name=\"showIcon\" title=\"Icon\" checked/>\r\n        <input type=\"color\" name=\"icon\" title=\"Icon Color\" value=\"#000000\" condition=\"showIcon\"/>\r\n        <input type=\"checkbox\" name=\"showName\" title=\"Name\" checked/>\r\n        <input type=\"checkbox\" name=\"showRole\" title=\"Role\" checked/>\r\n        <input type=\"checkbox\" title=\"Image Overlay\" name=\"showImageOverlay\">\r\n        <input type=\"color\" title=\"Image Overlay Color\" value=\"#f3f6f9\" name=\"imageOver\" condition=\"showImageOverlay\"\r\n               selected>\r\n        <input type=\"range\" inline title=\"Overlay Opacity\" name=\"imageOverOpacity\" min=\"0\" max=\"1\" step=\"0.1\"\r\n               value=\"0.5\" condition=\"showImageOverlay\">\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/immersem5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div\r\n                        class=\"embla\"\r\n                        data-loop=\"{{loop}}\"\r\n                        data-auto-play=\"{{autoplay}}\"\r\n                        data-auto-play-interval=\"{{interval}}\"\r\n                        data-draggable=\"{{draggable}}\"\r\n                        data-skip-snaps=\"true\"\r\n                        data-align=\"center\"\r\n                        data-contain-scroll=\"trimSnaps\"\r\n                >\r\n                    <div class=\"embla__viewport\">\r\n                        <div class=\"embla__container\">\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/immersem5/components/_images/background3.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\r\n                                                Labs\r\n                                            </p>\r\n                                            <div class=\"title-wrapper\">\r\n                                                <div class=\"title-wrap\">\r\n                                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                                        data-app-selector=\".item-title, .mbr-section-btn, .title-wrap\"\r\n                                                        mbr-if=\"showTitle\">\r\n                                                        <b>Research has been reshaping our understanding</b>\r\n                                                    </h4>\r\n                                                </div>\r\n                                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                     mbr-if=\"showButtons\"\r\n                                                     data-toolbar=\"-mbrBtnMove\">\r\n                                                    <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Read More\r\n                                                    </a>\r\n                                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Start Now\r\n                                                    </a>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div class=\"name-wrapper\">\r\n                                                <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\">\r\n                                                        </span>\r\n                                                </div>\r\n                                                <div class=\"name-wrap\">\r\n                                                    <h4 class=\"item-name mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-7\"\r\n                                                        data-app-selector=\".item-name\"\r\n                                                        mbr-if=\"showName\">\r\n                                                        <b>Dr. Amelia Turner</b>\r\n                                                    </h4>\r\n                                                    <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                                       mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                        Quantum Physicist\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/immersem5/components/_images/background4.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\r\n                                                Labs\r\n                                            </p>\r\n                                            <div class=\"title-wrapper\">\r\n                                                <div class=\"title-wrap\">\r\n                                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                                        data-app-selector=\".item-title, .mbr-section-btn, .title-wrap\"\r\n                                                        mbr-if=\"showTitle\">\r\n                                                        <b>Trailblazing renewable energy scientist</b>\r\n                                                    </h4>\r\n                                                </div>\r\n                                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                     mbr-if=\"showButtons\"\r\n                                                     data-toolbar=\"-mbrBtnMove\">\r\n                                                    <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Read More\r\n                                                    </a>\r\n                                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Start Now\r\n                                                    </a>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div class=\"name-wrapper\">\r\n                                                <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                        <span mbr-icon\r\n                                                              class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\"></span>\r\n                                                </div>\r\n                                                <div class=\"name-wrap\">\r\n                                                    <h4 class=\"item-name mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-7\"\r\n                                                        data-app-selector=\".item-name\"\r\n                                                        mbr-if=\"showName\">\r\n                                                        <b>Javier Morales</b>\r\n                                                    </h4>\r\n                                                    <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                                       mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                        Renewable Energy Innovator\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/immersem5/components/_images/background2.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\r\n                                                Labs\r\n                                            </p>\r\n                                            <div class=\"title-wrapper\">\r\n                                                <div class=\"title-wrap\">\r\n                                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                                        data-app-selector=\".item-title, .mbr-section-btn\"\r\n                                                        mbr-if=\"showTitle\">\r\n                                                        <b>Marine biology lab committed to unraveling the mysteries</b>\r\n                                                    </h4>\r\n                                                </div>\r\n                                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                     mbr-if=\"showButtons\"\r\n                                                     data-toolbar=\"-mbrBtnMove\">\r\n                                                    <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Read More\r\n                                                    </a>\r\n                                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Start Now\r\n                                                    </a>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div class=\"name-wrapper\">\r\n                                                <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                        <span mbr-icon\r\n                                                              class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\"></span>\r\n                                                </div>\r\n                                                <div class=\"name-wrap\">\r\n                                                    <h4 class=\"item-name mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-7\"\r\n                                                        data-app-selector=\".item-name\"\r\n                                                        mbr-if=\"showName\">\r\n                                                        <b>Dr. Marcus Rodriguez</b>\r\n                                                    </h4>\r\n                                                    <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                                       mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                        Marine Biologist\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <button class=\"embla__button embla__button--prev\">\r\n                        <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                    </button>\r\n                    <button class=\"embla__button embla__button--next\">\r\n                        <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uHeswdoIqI",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider03-2b"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 80px",
                "@media (max-width: 1200px)": {
                  "padding": "0 40px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "50px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "30px"
                }
              }
            },
            ".content-wrapper": {
              "padding": "40px 0",
              "display": "flex",
              "align-items": "center",
              "min-height": "455px",
              "background-color": "@container",
              "@media (max-width: 992px)": {
                "display": "block"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".rating-wrapper": {
                    "margin-bottom": "20px",
                    ".rating-wrap": {
                      "display": "inline-flex",
                      "align-items": "center",
                      ".mbr-rating": {
                        "margin-bottom": "0",
                        "margin-right": "5px",
                        "&:last-child": {
                          "margin-right": "0"
                        }
                      }
                    }
                  },
                  ".item-text": {
                    "margin-bottom": "30px"
                  },
                  ".desc-wrapper": {
                    ".desc-wrap": {
                      "display": "inline-flex",
                      "flex-wrap": "wrap",
                      ".item-desc": {
                        "padding-right": "10px",
                        "margin-bottom": "0"
                      },
                      ".item-date": {
                        "padding-left": "10px",
                        "border-left": "1px solid @border",
                        "margin-bottom": "0"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "32px",
              "height": "32px",
              "margin-top": "-1.5rem",
              "font-size": "16px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "none",
              "border-radius": "100%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": "1 !important"
              },
              "&.embla__button--prev": {
                "left": "3rem",
                "@media (max-width: 992px)": {
                  "left": "20px"
                }
              },
              "&.embla__button--next": {
                "right": "3rem",
                "@media (max-width: 992px)": {
                  "right": "20px"
                }
              },
              "@media (max-width: 992px)": {
                "top": "auto",
                "bottom": "1rem"
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".embla": {
              "position": "relative",
              "width": "60%",
              "padding": "0 104px",
              "@media (max-width: 992px)": {
                "width": "100%",
                "padding": "0 20px 4rem"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".image-wrapper": {
              "width": "40%",
              "position": "relative",
              "height": "100%",
              "@media (max-width: 992px)": {
                "width": "100%"
              },
              "img": {
                "position": "absolute",
                "top": "-5rem",
                "right": "-2rem",
                "height": "400px",
                "width": "80%",
                "object-fit": "cover",
                "& when (@reverseContent)": {
                  "right": "auto",
                  "left": "-2rem"
                },
                "@media (max-width: 992px)": {
                  "position": "static",
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-text": {
              "color": "#000305"
            },
            ".item-desc": {
              "color": "#000305"
            },
            ".item-date": {
              "color": "#b0b0b0"
            },
            ".mbr-rating": {
              "color": "#000305"
            }
          },
          "_name": "slider03",
          "_sourceTheme": "essencem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider03 mbr-embla essencem5\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\"/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\"/>\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\r\n        <input type=\"color\" name=\"container\" title=\"Container BG\" value=\"#ffffff\" condition=\"showTitle\"/>\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"5\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input type=\"color\" name=\"arrowsColor\" title=\"Arrows Color\" value=\"#ffffff\" condition=\"arrows\"/>\r\n        <input type=\"color\" name=\"arrowsBg\" title=\"Arrows BG\" value=\"#000305\" condition=\"arrows\"/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n                checked\r\n        />\r\n        <header>Cards</header>\r\n        <input type=\"checkbox\" name=\"showRating\" title=\"Rating\" checked/>\r\n        <input type=\"range\" inline title=\"Rating Amount\" name=\"rating\" min=\"1\" max=\"5\" step=\"1\" value=\"5\"\r\n               condition=\"showRating\"/>\r\n        <input type=\"checkbox\" name=\"showText\" title=\"Card Text\" checked/>\r\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Card Description\" checked/>\r\n        <input type=\"checkbox\" name=\"showDate\" title=\"Card Date\" checked/>\r\n        <input type=\"color\" name=\"border\" title=\"Date Border\" value=\"#dadada\" condition=\"showDate\"/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax required>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/essencem5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12 card\">\r\n                <div class=\"title-wrapper\">\r\n                    <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                        data-app-selector=\".mbr-section-title, .mbr-section-btn\"\r\n                        mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                        <b>FEEDBACK</b>\r\n                    </h2>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 card\">\r\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n                    <div\r\n                            class=\"embla\"\r\n                            data-loop=\"{{loop}}\"\r\n                            data-auto-play=\"{{autoplay}}\"\r\n                            data-auto-play-interval=\"{{interval}}\"\r\n                            data-draggable=\"{{draggable}}\"\r\n                            data-skip-snaps=\"true\"\r\n                            data-align=\"center\"\r\n                            data-contain-scroll=\"trimSnaps\"\r\n                    >\r\n                        <div class=\"embla__viewport\">\r\n                            <div class=\"embla__container\">\r\n                                <div class=\"embla__slide features-without-image slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <div class=\"rating-wrapper\" mbr-if=\"showRating\">\r\n                                                <div class=\"rating-wrap\">\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 1\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 2\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 3\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 4\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".item-text, .rating-wrapper\" mbr-if=\"showText\">\r\n                                                \"The environmental community has truly made a difference in advocating\r\n                                                for policies that protect our planet. Their dedication to influencing\r\n                                                positive change is commendable. From pushing for renewable energy to\r\n                                                fighting against deforestation, their impact resonates globally. Keep up\r\n                                                the excellent work!\"\r\n                                            </p>\r\n                                            <div class=\"desc-wrapper\">\r\n                                                <div class=\"desc-wrap\">\r\n                                                    <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                       data-app-selector=\".item-desc, .desc-wrapper\" mbr-if=\"showDesc\">\r\n                                                        <b>Our clients</b>\r\n                                                    </p>\r\n                                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                       data-app-selector=\".item-date, .desc-wrapper\" mbr-if=\"showDate\">\r\n                                                        2030\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide features-without-image slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <div class=\"rating-wrapper\" mbr-if=\"showRating\">\r\n                                                <div class=\"rating-wrap\">\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 1\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 2\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 3\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 4\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".item-text, .rating-wrapper\" mbr-if=\"showText\">\r\n                                                \"Kudos to the environmental community for their relentless efforts in\r\n                                                educating the public about crucial environmental issues. Their\r\n                                                commitment to raising awareness through informative campaigns and\r\n                                                engaging programs is vital in fostering a sense of responsibility\r\n                                                towards our planet.\"\r\n                                            </p>\r\n                                            <div class=\"desc-wrapper\">\r\n                                                <div class=\"desc-wrap\">\r\n                                                    <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                       data-app-selector=\".item-desc, .desc-wrapper\" mbr-if=\"showDesc\">\r\n                                                        <b>Our clients</b>\r\n                                                    </p>\r\n                                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                       data-app-selector=\".item-date, .desc-wrapper\" mbr-if=\"showDate\">\r\n                                                        2030\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide features-without-image slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <div class=\"rating-wrapper\" mbr-if=\"showRating\">\r\n                                                <div class=\"rating-wrap\">\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 1\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 2\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 3\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 4\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".item-text, .rating-wrapper\" mbr-if=\"showText\">\r\n                                                \"What I appreciate most about the environmental community is their\r\n                                                diverse approach to addressing environmental challenges. Whether it's\r\n                                                grassroots community projects, scientific research, or policy advocacy,\r\n                                                they tackle the issues from every angle. A united front with a common\r\n                                                goal: a sustainable and thriving planet\"\r\n                                            </p>\r\n                                            <div class=\"desc-wrapper\">\r\n                                                <div class=\"desc-wrap\">\r\n                                                    <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                       data-app-selector=\".item-desc, .desc-wrapper\" mbr-if=\"showDesc\">\r\n                                                        <b>Our clients</b>\r\n                                                    </p>\r\n                                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                       data-app-selector=\".item-date, .desc-wrapper\" mbr-if=\"showDate\">\r\n                                                        2030\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide features-without-image slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <div class=\"rating-wrapper\" mbr-if=\"showRating\">\r\n                                                <div class=\"rating-wrap\">\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 1\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 2\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 3\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                    <p class=\"mbr-rating mbr-fonts-style\" mbr-if=\"rating > 4\"\r\n                                                       mbr-theme-style=\"display-5\" data-app-selector=\".mbr-rating\">\r\n                                                        ★\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".item-text, .rating-wrapper\" mbr-if=\"showText\">\r\n                                                \"While the environmental community does remarkable work, there's room\r\n                                                for improvement in diversity and inclusion. It's crucial that all\r\n                                                voices, especially those from marginalized communities, are heard and\r\n                                                represented. Let's strive for a more inclusive movement that truly\r\n                                                reflects the global nature of our environmental challenges.\"\r\n                                            </p>\r\n                                            <div class=\"desc-wrapper\">\r\n                                                <div class=\"desc-wrap\">\r\n                                                    <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                       data-app-selector=\".item-desc, .desc-wrapper\" mbr-if=\"showDesc\">\r\n                                                        <b>Our clients</b>\r\n                                                    </p>\r\n                                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                                       data-app-selector=\".item-date, .desc-wrapper\" mbr-if=\"showDate\">\r\n                                                        2030\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <button class=\"embla__button embla__button--prev\">\r\n                            <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                        </button>\r\n                        <button class=\"embla__button embla__button--next\">\r\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                        </button>\r\n                    </div>\r\n                    <div class=\"image-wrapper\">\r\n                        <img src=\"@ADDONS_PATH@/essencem5/components/_images/essence/image5.jpg\" alt=\"Mobirise\">\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uHeswgiHUQ",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider03-2c"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "10px 8px"
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "padding": "10px 8px"
              }
            },
            ".row": {
              "border-radius": "25px",
              "background-color": "@container",
              "padding": "100px 40px",
              "margin": "0",
              "overflow": "hidden",
              "@media (max-width: 768px)": {
                "padding": "100px 10px"
              },
              ".card": {
                "padding": "0"
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".desc-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-desc": {
                "display": "inline-flex",
                "border-radius": "300px",
                "padding": "5px 25px",
                "background-color": "@desc",
                "margin-bottom": "0"
              }
            },
            ".mbr-section-title": {
              "width": "50%",
              "margin-bottom": "0",
              "@media (max-width: 992px)": {
                "margin-bottom": "30px"
              },
              "@media (max-width: 768px)": {
                "width": "100%"
              },
              "span": {
                "opacity": ".5"
              },
              "color": "#ffffff"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "650px",
              "max-width": "650px",
              "cursor": "pointer",
              "@media (max-width: 992px)": {
                "min-width": "550px",
                "max-width": "550px"
              },
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                "background-color": "@card",
                "border-radius": "25px !important",
                "padding": "20px",
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                ".item-wrapper": {
                  ".item-img": {
                    "margin-bottom": "20px",
                    "img": {
                      "height": "240px",
                      "object-fit": "cover",
                      "border-radius": "25px !important"
                    }
                  }
                },
                ".item-content": {
                  "position": "relative",
                  "z-index": "1",
                  ".card-title": {
                    "margin-bottom": "30px"
                  },
                  ".items-wrapper": {
                    "display": "flex",
                    "align-items": "flex-end",
                    "justify-content": "space-between",
                    "@media (max-width: 992px)": {
                      "display": "block"
                    },
                    ".items-wrap": {
                      "display": "grid",
                      "grid-template-columns": "1fr 1fr 1fr",
                      "gap": "10px",
                      "@media (max-width: 768px)": {
                        "grid-template-columns": "1fr"
                      },
                      ".item-wrap": {
                        "border-radius": "17px",
                        "background-color": "@item",
                        "padding": "20px",
                        "display": "flex",
                        "flex-direction": "column",
                        "justify-content": "space-between",
                        "width": "100%",
                        ".item-title": {
                          "margin-bottom": "30px"
                        },
                        ".item-number": {
                          "margin-bottom": "0"
                        }
                      }
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "transform": "scale(1.15)"
                        }
                      },
                      ".mbr-iconfont": {
                        "width": "60px",
                        "height": "60px",
                        "border-radius": "100%",
                        "display": "flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "background-color": "@iconBg",
                        "color": "@icon",
                        "font-size": "16px",
                        "margin-left": "50px",
                        "transition": "all 0.3s ease-in-out",
                        "& when not (@showItems)": {
                          "margin-left": "0"
                        },
                        "@media (max-width: 992px)": {
                          "margin": "20px auto 0"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "-7.5rem",
              "width": "50px",
              "height": "50px",
              "margin-top": "-1.5rem",
              "font-size": "16px",
              "background-image": "linear-gradient(45deg, @arrow_1 0, @arrow_2 98%)",
              "color": "@arrowsColor !important",
              "border": "none",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "@media (max-width: 768px)": {
                "top": "-3rem"
              },
              "& when not (@showTitle)": {
                "top": "-3.5rem"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "transform": "scale(1.15)"
              },
              "&.embla__button--prev": {
                "right": "6rem",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@showTitle)": {
                "margin-top": "80px",
                "@media (max-width: 768px)": {
                  "& when not (@arrows)": {
                    "margin-top": "20px"
                  }
                }
              },
              "& when (@showDesc)": {
                "margin-top": "80px",
                "@media (max-width: 768px)": {
                  "& when not (@arrows)": {
                    "margin-top": "20px"
                  }
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-desc": {
              "color": "#222222"
            },
            ".card-title": {
              "color": "#222222"
            },
            ".item-title": {
              "color": "#222222"
            },
            ".item-number": {
              "color": "#222222"
            }
          },
          "_name": "slider02",
          "_sourceTheme": "trackm5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider02 mbr-embla trackm5\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"0\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"0\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\r\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked/>\r\n        <input type=\"color\" title=\"Description BG\" value=\"#ffffff\" name=\"desc\" condition=\"showDesc\" selected/>\r\n        <input type=\"color\" title=\"Container BG\" value=\"#3283fb\" name=\"container\" selected/>\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"4\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input type=\"color\" title=\"Arrows Color\" value=\"#3283fb\" name=\"arrowsColor\" condition=\"arrows\" selected/>\r\n        <input type=\"color\" title=\"Arrows BG 1\" value=\"#ffffff\" name=\"arrow_1\" condition=\"arrows\" selected/>\r\n        <input type=\"color\" title=\"Arrows BG 2\" value=\"#ffffff\" name=\"arrow_2\" condition=\"arrows\" selected/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n                checked\r\n        />\r\n        <header>Cards</header>\r\n        <input\r\n                type=\"range\"\r\n                name=\"gap\"\r\n                title=\"Gap\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Card Title\" checked/>\r\n        <input type=\"color\" title=\"Card BG\" value=\"#ffffff\" name=\"card\" selected/>\r\n        <input type=\"checkbox\" name=\"showIcon\" title=\"Card Icon\" checked/>\r\n        <input type=\"color\" title=\"Icon Color\" value=\"#ffffff\" name=\"icon\" condition=\"showIcon\" selected/>\r\n        <input type=\"color\" title=\"Icon BG\" value=\"#3283fb\" name=\"iconBg\" condition=\"showIcon\" selected/>\r\n        <header>Items</header>\r\n        <input type=\"checkbox\" name=\"showItems\" title=\"Items\" checked/>\r\n        <input type=\"range\" inline title=\"Amount\" name=\"items\" min=\"1\" max=\"3\" step=\"1\" value=\"3\"\r\n               condition=\"showItems\"/>\r\n        <input type=\"checkbox\" name=\"showItemTitle\" title=\"Item Title\" condition=\"showItems\" checked/>\r\n        <input type=\"checkbox\" name=\"showNumber\" title=\"Item Number\" condition=\"showItems\" checked/>\r\n        <input type=\"color\" title=\"Item BG\" value=\"#e1edff\" name=\"item\" condition=\"showItems\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax required>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/trackm5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#e2e7f8\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showDesc\">\r\n                <div class=\"desc-wrapper\">\r\n                    <p class=\"mbr-desc mbr-fonts-style\"\r\n                       data-app-selector=\".mbr-desc, .desc-wrapper\"\r\n                       mbr-theme-style=\"display-4\">\r\n                        Different genres\r\n                    </p>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 col-lg-9 card\" mbr-if=\"showTitle\">\r\n                <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                    data-app-selector=\".mbr-section-title\"\r\n                    mbr-theme-style=\"display-2\">\r\n                    Producer Does Any <span>Kind of Music</span>\r\n                </h2>\r\n            </div>\r\n            <div class=\"col-12 card\">\r\n                <div\r\n                        class=\"embla\"\r\n                        data-loop=\"{{loop}}\"\r\n                        data-auto-play=\"{{autoplay}}\"\r\n                        data-auto-play-interval=\"{{interval}}\"\r\n                        data-draggable=\"{{draggable}}\"\r\n                        data-skip-snaps=\"true\"\r\n                        data-align=\"center\"\r\n                        data-contain-scroll=\"trimSnaps\">\r\n                    <div class=\"embla__viewport\">\r\n                        <div class=\"embla__container\">\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/trackm5/components/_images/track/image7.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                    </div>\r\n                                    <div class=\"item-content\">\r\n                                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                            data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\r\n                                            Pop music\r\n                                        </h4>\r\n                                        <div class=\"items-wrapper\" mbr-if=\"showItems || showIcon\">\r\n                                            <div class=\"items-wrap\" mbr-if=\"showItems\">\r\n                                                <div class=\"item-wrap\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Dance All Night\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        4:00\r\n                                                    </p>\r\n                                                </div>\r\n                                                <div class=\"item-wrap\" mbr-if=\"items > 1\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Summer Love\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        4:00\r\n                                                    </p>\r\n                                                </div>\r\n                                                <div class=\"item-wrap\" mbr-if=\"items > 2\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Electric Dreams\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        4:00\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                            <a href=\"#\">\r\n                                                    <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"\r\n                                                          mbr-if=\"showIcon\"></span>\r\n                                            </a>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/trackm5/components/_images/track/image5.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                    </div>\r\n                                    <div class=\"item-content\">\r\n                                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                            data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\r\n                                            Hip-hop\r\n                                        </h4>\r\n                                        <div class=\"items-wrapper\" mbr-if=\"showItems || showIcon\">\r\n                                            <div class=\"items-wrap\" mbr-if=\"showItems\">\r\n                                                <div class=\"item-wrap\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"City Streets\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        3:00\r\n                                                    </p>\r\n                                                </div>\r\n                                                <div class=\"item-wrap\" mbr-if=\"items > 1\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Rise to the Top\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        3:00\r\n                                                    </p>\r\n                                                </div>\r\n                                                <div class=\"item-wrap\" mbr-if=\"items > 2\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Urban Legends\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        3:00\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                            <a href=\"#\">\r\n                                                    <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"\r\n                                                          mbr-if=\"showIcon\"></span>\r\n                                            </a>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/trackm5/components/_images/track/image17.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                    </div>\r\n                                    <div class=\"item-content\">\r\n                                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                            data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\r\n                                            Rock music\r\n                                        </h4>\r\n                                        <div class=\"items-wrapper\" mbr-if=\"showItems || showIcon\">\r\n                                            <div class=\"items-wrap\" mbr-if=\"showItems\">\r\n                                                <div class=\"item-wrap\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Rebel Heart\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        5:00\r\n                                                    </p>\r\n                                                </div>\r\n                                                <div class=\"item-wrap\" mbr-if=\"items > 1\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Road to Redemption\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        5:00\r\n                                                    </p>\r\n                                                </div>\r\n                                                <div class=\"item-wrap\" mbr-if=\"items > 2\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Wildfire\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        5:00\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                            <a href=\"#\">\r\n                                                    <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"\r\n                                                          mbr-if=\"showIcon\"></span>\r\n                                            </a>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/trackm5/components/_images/track/image15.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                    </div>\r\n                                    <div class=\"item-content\">\r\n                                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                            data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\r\n                                            Electronic music\r\n                                        </h4>\r\n                                        <div class=\"items-wrapper\" mbr-if=\"showItems || showIcon\">\r\n                                            <div class=\"items-wrap\" mbr-if=\"showItems\">\r\n                                                <div class=\"item-wrap\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Neon Dreams\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        3:00\r\n                                                    </p>\r\n                                                </div>\r\n                                                <div class=\"item-wrap\" mbr-if=\"items > 1\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Euphoria\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        3:00\r\n                                                    </p>\r\n                                                </div>\r\n                                                <div class=\"item-wrap\" mbr-if=\"items > 2\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Digital <br> Pulse\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        3:00\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                            <a href=\"#\">\r\n                                                    <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"\r\n                                                          mbr-if=\"showIcon\"></span>\r\n                                            </a>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@ADDONS_PATH@/trackm5/components/_images/track/image13.jpg\" alt=\"Mobirise Website Builder\"/>\r\n                                        </div>\r\n                                    </div>\r\n                                    <div class=\"item-content\">\r\n                                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                            data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\r\n                                            R&B and Soul\r\n                                        </h4>\r\n                                        <div class=\"items-wrapper\" mbr-if=\"showItems || showIcon\">\r\n                                            <div class=\"items-wrap\" mbr-if=\"showItems\">\r\n                                                <div class=\"item-wrap\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Soulful Serenade\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        4:00\r\n                                                    </p>\r\n                                                </div>\r\n                                                <div class=\"item-wrap\" mbr-if=\"items > 1\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Love and Lyrics\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        4:00\r\n                                                    </p>\r\n                                                </div>\r\n                                                <div class=\"item-wrap\" mbr-if=\"items > 2\">\r\n                                                    <h5 class=\"item-title mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".item-title\" mbr-if=\"showItemTitle\">\r\n                                                        \"Midnight Whispers\"\r\n                                                    </h5>\r\n                                                    <p class=\"item-number mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".item-number\" mbr-if=\"showNumber\">\r\n                                                        4:00\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                            <a href=\"#\">\r\n                                                    <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"\r\n                                                          mbr-if=\"showIcon\"></span>\r\n                                            </a>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <button class=\"embla__button embla__button--prev\">\r\n                        <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                    </button>\r\n                    <button class=\"embla__button embla__button--next\">\r\n                        <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uHeswjo31E",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider02-2d"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "10px 8px"
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "padding": "10px 8px"
              }
            },
            ".row": {
              "border-radius": "25px",
              "background-color": "@container",
              "padding": "100px 40px",
              "margin": "0",
              "overflow": "hidden",
              "@media (max-width: 768px)": {
                "padding": "100px 10px",
                "& when (@arrows)": {
                  "padding": "50px 10px 100px"
                }
              },
              ".card": {
                "padding": "0"
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".desc-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "20px"
              },
              ".mbr-desc": {
                "display": "inline-flex",
                "border-radius": "300px",
                "padding": "5px 25px",
                "background-color": "@desc",
                "margin-bottom": "0"
              }
            },
            ".mbr-section-title": {
              "width": "50%",
              "margin-bottom": "50px",
              "@media (max-width: 992px)": {
                "margin-bottom": "30px"
              },
              "@media (max-width: 768px)": {
                "width": "100%"
              },
              "span": {
                "opacity": ".5"
              },
              "color": "#ffffff"
            },
            ".mbr-section-btn": {
              "margin-bottom": "50px",
              "@media (max-width: 992px)": {
                "margin-bottom": "30px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "410px",
              "max-width": "410px",
              "cursor": "pointer",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                "background-color": "@card",
                "border-radius": "25px !important",
                "padding": "30px",
                "@media (max-width: 768px)": {
                  "padding": "20px"
                },
                ".item-wrapper": {
                  "height": "100%",
                  ".item-content": {
                    "display": "flex",
                    "justify-content": "space-between",
                    "flex-direction": "column",
                    "height": "100%",
                    "position": "relative",
                    "z-index": "1",
                    ".card-text": {
                      "width": "100%",
                      "margin-bottom": "0"
                    },
                    ".name-wrapper": {
                      "margin-top": "16px",
                      ".name-wrap": {
                        "display": "inline-flex",
                        "align-items": "center",
                        ".card-circle": {
                          "width": "100px",
                          "height": "100px",
                          "display": "inline-flex",
                          "align-items": "center",
                          "justify-content": "center",
                          "background-color": "@circle",
                          "border-radius": "100%",
                          "margin-bottom": "0",
                          "margin-right": "16px"
                        },
                        ".card-name": {
                          "margin-bottom": "0"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "-4.5rem",
              "width": "50px",
              "height": "50px",
              "margin-top": "-1.5rem",
              "font-size": "16px",
              "background-image": "linear-gradient(45deg, @arrow_1 0, @arrow_2 98%)",
              "color": "@arrowsColor !important",
              "border": "none",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@showTitle)": {
                "top": "-3.5rem"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "transform": "scale(1.15)"
              },
              "&.embla__button--prev": {
                "right": "6rem",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".card-text": {
              "color": "#222222"
            },
            ".card-circle": {
              "color": "#ffffff"
            },
            ".card-name": {
              "color": "#222222"
            }
          },
          "_name": "slider03",
          "_sourceTheme": "trackm5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider03 mbr-embla trackm5\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"0\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"0\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\r\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked/>\r\n        <input type=\"color\" title=\"Description BG\" value=\"#3283fb\" name=\"desc\" condition=\"showDesc\" selected/>\r\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked/>\r\n        <input type=\"color\" title=\"Container BG\" value=\"#222222\" name=\"container\" selected/>\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"4\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input type=\"color\" title=\"Arrows Color\" value=\"#ffffff\" name=\"arrowsColor\" condition=\"arrows\" selected/>\r\n        <input type=\"color\" title=\"Arrows BG 1\" value=\"#3283fb\" name=\"arrow_1\" condition=\"arrows\" selected/>\r\n        <input type=\"color\" title=\"Arrows BG 2\" value=\"#73abff\" name=\"arrow_2\" condition=\"arrows\" selected/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n                checked\r\n        />\r\n        <header>Cards</header>\r\n        <input\r\n                type=\"range\"\r\n                name=\"gap\"\r\n                title=\"Gap\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input type=\"checkbox\" name=\"showText\" title=\"Card Text\" checked/>\r\n        <input type=\"checkbox\" name=\"showCircle\" title=\"Card Circle\" checked/>\r\n        <input type=\"color\" title=\"Circle BG\" value=\"#73abff\" name=\"circle\" condition=\"showCircle\" selected/>\r\n        <input type=\"checkbox\" name=\"showName\" title=\"Card Name\" checked/>\r\n        <input type=\"color\" title=\"Card BG\" value=\"#ffffff\" name=\"card\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax required>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/trackm5/components/_images/background1.jpg\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#e2e7f8\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showDesc\">\r\n                <div class=\"desc-wrapper\">\r\n                    <p class=\"mbr-desc mbr-fonts-style\"\r\n                       data-app-selector=\".mbr-desc, .desc-wrapper\"\r\n                       mbr-theme-style=\"display-4\">\r\n                        Reviews\r\n                    </p>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 col-lg-9 card\" mbr-if=\"showTitle\">\r\n                <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                    data-app-selector=\".mbr-section-title\"\r\n                    mbr-theme-style=\"display-2\">\r\n                    Our Fans are as <span>Passionate as Ever</span>\r\n                </h2>\r\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"\r\n                     data-toolbar=\"-mbrBtnMove\">\r\n                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                        <span class=\"socicon socicon-spotify mbr-iconfont mbr-iconfont-btn\"></span>\r\n                        Play Now\r\n                    </a>\r\n                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                        <span class=\"socicon socicon-youtube mbr-iconfont mbr-iconfont-btn\"></span>\r\n                        Play Now\r\n                    </a>\r\n                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                        <span class=\"socicon socicon-beatport mbr-iconfont mbr-iconfont-btn\"></span>\r\n                        Play Now\r\n                    </a>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 card\">\r\n                <div\r\n                        class=\"embla\"\r\n                        data-loop=\"{{loop}}\"\r\n                        data-auto-play=\"{{autoplay}}\"\r\n                        data-auto-play-interval=\"{{interval}}\"\r\n                        data-draggable=\"{{draggable}}\"\r\n                        data-skip-snaps=\"true\"\r\n                        data-align=\"center\"\r\n                        data-contain-scroll=\"trimSnaps\">\r\n                    <div class=\"embla__viewport\">\r\n                        <div class=\"embla__container\">\r\n                            <div class=\"embla__slide features-without-image slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".card-text\" mbr-if=\"showText\">\r\n                                                \"Their latest album is a masterpiece of musical storytelling. I can't\r\n                                                stop listening! Each track is a journey through emotions, and their\r\n                                                unique blend of folk and indie rock is absolutely enchanting. I've found\r\n                                                my new musical obsession.\"\r\n                                            </p>\r\n                                            <div class=\"name-wrapper\" mbr-if=\"showCircle || showName\">\r\n                                                <div class=\"name-wrap\">\r\n                                                    <p class=\"card-circle mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-circle\" mbr-if=\"showCircle\">\r\n                                                        S\r\n                                                    </p>\r\n                                                    <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-name\" mbr-if=\"showName\">\r\n                                                        Sarah J.\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide features-without-image slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".card-text\" mbr-if=\"showText\">\r\n                                                \"Their stage presence is electrifying, and the energy they bring to\r\n                                                their\r\n                                                music is infectious. It's not just a concert; it's an immersive\r\n                                                experience. I danced, laughed, and even shed a tear. 'SoundScape\r\n                                                Collective' is a musical journey that everyone should embark on at least\r\n                                                once.\"\r\n                                            </p>\r\n                                            <div class=\"name-wrapper\" mbr-if=\"showCircle || showName\">\r\n                                                <div class=\"name-wrap\">\r\n                                                    <p class=\"card-circle mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-circle\" mbr-if=\"showCircle\">\r\n                                                        J\r\n                                                    </p>\r\n                                                    <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-name\" mbr-if=\"showName\">\r\n                                                        John D.\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide features-without-image slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".card-text\" mbr-if=\"showText\">\r\n                                                \"As an aspiring musician, I find 'Melodic Fusion' incredibly inspiring.\r\n                                                Their intricate compositions and masterful fusion of classical and\r\n                                                progressive rock elements are a testament to their artistry.\"\r\n                                            </p>\r\n                                            <div class=\"name-wrapper\" mbr-if=\"showCircle || showName\">\r\n                                                <div class=\"name-wrap\">\r\n                                                    <p class=\"card-circle mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-circle\" mbr-if=\"showCircle\">\r\n                                                        E\r\n                                                    </p>\r\n                                                    <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-name\" mbr-if=\"showName\">\r\n                                                        Emily M.\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide features-without-image slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".card-text\" mbr-if=\"showText\">\r\n                                                \"The debut album from 'Rhythmic Reverie' is a revelation in modern\r\n                                                music. Their genre-blending approach seamlessly fuses elements of jazz,\r\n                                                electronic, and world music into a mesmerizing sonic tapestry.\"\r\n                                            </p>\r\n                                            <div class=\"name-wrapper\" mbr-if=\"showCircle || showName\">\r\n                                                <div class=\"name-wrap\">\r\n                                                    <p class=\"card-circle mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-circle\" mbr-if=\"showCircle\">\r\n                                                        D\r\n                                                    </p>\r\n                                                    <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-name\" mbr-if=\"showName\">\r\n                                                        David R.\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide features-without-image slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".card-text\" mbr-if=\"showText\">\r\n                                                While their musicianship is impeccable, I found the songwriting somewhat\r\n                                                predictable, and the production lacked the innovation I was hoping for.\r\n                                                I look forward to seeing how they evolve and experiment with their sound\r\n                                                in the future.\"\r\n                                            </p>\r\n                                            <div class=\"name-wrapper\" mbr-if=\"showCircle || showName\">\r\n                                                <div class=\"name-wrap\">\r\n                                                    <p class=\"card-circle mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-circle\" mbr-if=\"showCircle\">\r\n                                                        L\r\n                                                    </p>\r\n                                                    <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-name\" mbr-if=\"showName\">\r\n                                                        Laura S.\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide features-without-image slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-content\">\r\n                                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                               data-app-selector=\".card-text\" mbr-if=\"showText\">\r\n                                                \"Their music speaks to my soul, and I've been a devoted fan since day\r\n                                                one. Each song is a heartfelt anthem that speaks to the human\r\n                                                experience. I've already pre-ordered the vinyl and can't wait to see\r\n                                                them perform live again.\"\r\n                                            </p>\r\n                                            <div class=\"name-wrapper\" mbr-if=\"showCircle || showName\">\r\n                                                <div class=\"name-wrap\">\r\n                                                    <p class=\"card-circle mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-circle\" mbr-if=\"showCircle\">\r\n                                                        M\r\n                                                    </p>\r\n                                                    <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                                       data-app-selector=\".card-name\" mbr-if=\"showName\">\r\n                                                        Mark P.\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <button class=\"embla__button embla__button--prev\">\r\n                        <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                    </button>\r\n                    <button class=\"embla__button embla__button--next\">\r\n                        <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uHeswmyBF8",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider03-2e"
        },
        {
          "_name": "slider2",
          "_sourceTheme": "advisorym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider2 mbr-embla advisorym5\" group=\"Sliders & Galleries\"\n         mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"embla\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"color\" title=\"Line Color\" value=\"#1d1d1d\" name=\"line\" condition=\"showSubtitle\" selected>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\">\n        <header>Card</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"color\" title=\"Border Color\" value=\"#d7d7d7\" name=\"border\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/advisorym5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#FCFBF5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/advisorym5/components/_images/background1.jpg\" name=\"fallBackImage\"\n               condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\"\n               condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"\n               condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n         mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 card\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\n                        mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                        Lorem ipsum dolor sit amet, consectetur <br> adipisicing elit, beatae illum elit <br>\n                        libero, necessitatibus nulla rerum <br> obcaecati officia officiis.\n                    </h2>\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                        mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                        Labore\n                    </h3>\n                </div>\n            </div>\n            <div class=\"embla\" data-loop={{loop}} data-auto-play={{autoplay}} data-auto-play-interval={{interval}}\n                 data-draggable={{draggable}} data-skip-snaps=\"true\" data-align=\"center\"\n                 data-contain-scroll=\"trimSnaps\">\n                <div class=\"embla__viewport\">\n                    <div class=\"embla__container\">\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Lorem ipsum dolor sit amet\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Dolorum earum esse eveniet fuga\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Pariatur quasi quia vero\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Nemo neque optio pariatur\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Et illo inventore officia\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Minus modi odit omnis perferendis\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Nihil, officiis omnis quidem\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Quos reprend sint dolorum magni.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Facere illo labor mollitia\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Enim eum expedita iste libero\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Ratione sunt tempora tenetur\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item\"\n                             mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrap\">\n                                <div class=\"content-wrap\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                       data-app-selector=\".mbr-text\">\n                                        Error minima nam sint\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <button class=\"embla__button embla__button--prev\">\n                    <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\n                    <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                </button>\n                <button class=\"embla__button embla__button--next\">\n                    <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\n                    <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                </button>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 16px",
                "@media (max-width: 992px)": {
                  "padding": "0 12px"
                },
                ".row": {
                  "padding": "0"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".card": {
              "padding": "0"
            },
            ".title-wrapper": {
              "padding-left": "64px",
              "@media (max-width: 992px)": {
                "padding-left": "20px"
              },
              ".mbr-section-title": {
                "padding-right": "64px",
                "margin-bottom": "64px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "50px",
                  "padding-right": "20px"
                }
              },
              ".mbr-section-subtitle": {
                "position": "relative",
                "display": "flex",
                "align-items": "center",
                "margin-bottom": "64px",
                "white-space": "nowrap",
                "&::after": {
                  "content": "''",
                  "margin-left": "8px",
                  "width": "100%",
                  "height": "2px",
                  "background-color": "@line"
                },
                "@media (max-width: 992px)": {
                  "margin-bottom": "50px"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "200px",
              "max-width": "200px",
              "margin": "0 10px",
              "height": "200px",
              "border-radius": "100%",
              "border": "2px solid @border",
              "@media (max-width: 768px)": {
                "min-width": "200px",
                "max-width": "200px",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              },
              ".card-wrap": {
                ".content-wrap": {
                  "height": "100%",
                  "display": "flex",
                  "justify-content": "center",
                  "align-items": "center",
                  "padding": "0 8px",
                  ".mbr-text": {
                    "margin": "0"
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "-2rem",
              "width": "30px",
              "height": "30px",
              "margin-top": "-1.5rem",
              "font-size": "16px",
              "background-color": "transparent",
              "color": "@primaryColor",
              "border": "none",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "transparent",
                "color": "@primaryColor",
                "opacity": ".7"
              },
              "&.embla__button--prev": {
                "left": "auto",
                "right": "2rem",
                "margin-left": "0"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "0"
              },
              "@media (max-width: 767px)": {
                "top": "-1.5rem"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-section-title": {
              "color": "#1d1d1d",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#1d1d1d",
              "text-align": "center"
            }
          },
          "_cid": "uHeswr6YKY",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider2-2f"
        },
        {
          "_name": "slider1",
          "_sourceTheme": "deepm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider1 mbr-embla deepm5\" group=\"Sliders & Galleries\"\n         mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"embla\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <header>Card</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"color\" title=\"Description BG\" value=\"#8a9198\" name=\"desc\" condition=\"showDesc\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/deepm5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/deepm5/components/_images/background1.jpg\" name=\"fallBackImage\"\n               condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\"\n               condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"\n               condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n         mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop={{loop}} data-auto-play={{autoplay}} data-auto-play-interval={{interval}}\n                     data-draggable={{draggable}} data-skip-snaps=\"true\" data-align=\"center\"\n                     data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide slider-image item\"\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"card-wrap\">\n                                    <div class=\"item-wrapper position-relative\">\n                                        <div class=\"desc-wrap\">\n                                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                               mbr-if=\"showDesc\" data-app-selector=\".mbr-desc, .desc-wrap\">\n                                                <b>01. SERVICE</b>\n                                            </p>\n                                        </div>\n                                        <div class=\"image-wrap\">\n                                            <img src=\"@ADDONS_PATH@/deepm5/components/_images/deep/image9.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                    </div>\n                                    <div class=\"content-wrap\">\n                                        <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\n                                            mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                                            <b>Sourcing Investments</b>\n                                        </h3>\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\n                                           mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Doloremque earum\n                                            explicabo illo iusto laudantium, maiores necessitatibus nihil, nisi odio\n                                            perspiciatis placeat quaerat quidem quod temporibus ut vero voluptas\n                                            voluptates voluptatibus.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\"\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"card-wrap\">\n                                    <div class=\"item-wrapper position-relative\">\n                                        <div class=\"desc-wrap\">\n                                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                               mbr-if=\"showDesc\" data-app-selector=\".mbr-desc, .desc-wrap\">\n                                                <b>02. SERVICE</b>\n                                            </p>\n                                        </div>\n                                        <div class=\"image-wrap\">\n                                            <img src=\"@ADDONS_PATH@/deepm5/components/_images/deep/image8.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                    </div>\n                                    <div class=\"content-wrap\">\n                                        <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\n                                            mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                                            <b>Investor Involvement</b>\n                                        </h3>\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\n                                           mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Doloremque earum\n                                            explicabo illo iusto laudantium, maiores necessitatibus nihil, nisi odio\n                                            perspiciatis placeat quaerat quidem quod temporibus ut vero voluptas\n                                            voluptates voluptatibus.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\"\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"card-wrap\">\n                                    <div class=\"item-wrapper position-relative\">\n                                        <div class=\"desc-wrap\">\n                                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                               mbr-if=\"showDesc\" data-app-selector=\".mbr-desc, .desc-wrap\">\n                                                <b>03. SERVICE</b>\n                                            </p>\n                                        </div>\n                                        <div class=\"image-wrap\">\n                                            <img src=\"@ADDONS_PATH@/deepm5/components/_images/deep/image10.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                    </div>\n                                    <div class=\"content-wrap\">\n                                        <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\n                                            mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                                            <b>Conclusion of Contract</b>\n                                        </h3>\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\n                                           mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Doloremque earum\n                                            explicabo illo iusto laudantium, maiores necessitatibus nihil, nisi odio\n                                            perspiciatis placeat quaerat quidem quod temporibus ut vero voluptas\n                                            voluptates voluptatibus.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
