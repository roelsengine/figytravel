            "img": {
              "border-radius": "50%",
              "object-fit": "cover",
              "width": "3.6em",
              "height": "3.6em",
              "transition": "0.1s"
            },
            ".heading": {
              "font-weight": "600",
              "margin-bottom": "30px",
              "padding": "0"
