        {
          "_name": "slider01",
          "_sourceTheme": "techm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"carousel slide\" group=\"Sliders & Gallery\" plugins=\"YTPlayer,VimeoPlayer,SliderVideo,BootstrapCarouselSwipe,mobirise-icons2\" data-interval=\"false\" data-bs-interval=\"false\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"carousel\" title=\"Slides\" name=\"slides\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div mbr-carousel=\"slides\" class=\"full-screen\" mbr-carousel-embedded></div>\n\n</section>",
          "_styles": {
            ".modal-body .close": {
              "background": "#1b1b1b"
            },
            ".modal-body .close span": {
              "font-style": "normal"
            },
            ".carousel-inner > .active, .carousel-inner > .next, .carousel-inner > .prev": {
              "display": "table"
            },
            ".mbr-iconfont": {
              "font-family": "'Moririse2' !important"
            },
            ".mbri-right:before": {
              "content": "\"\\e909\"",
              "font-weight": "900",
              "padding-left": "5px"
            },
            ".mbri-left:before": {
              "content": "\"\\e90a\"",
              "font-weight": "900",
              "padding-right": "5px"
            },
            ".carousel-control, .carousel-indicators li": {
              "background-color": "@primaryColor !important",
              "opacity": "0.7!important",
              "border": "none",
              "&:hover": {
                "transform": "scale(1.1)",
                "opacity": "1!important"
              },
              ".active": {
                "transform": "scale(1.1)",
                "opacity": "1!important"
              }
            },
            ".carousel-indicators .active": {
              "transform": "scale(1.1)",
              "opacity": "1!important"
            },
            ".carousel-control .icon-next, .carousel-control .icon-prev": {
              "margin-top": "-18px",
              "font-size": "40px",
              "line-height": "27px"
            },
            ".carousel-control:hover": {
              "background": "#1b1b1b",
              "color": "#fff",
              "opacity": "1"
            },
            ".col-10": {
              "max-width": "900px",
              "margin": "auto"
            },
            "@media (max-width: 992px)": {
              ".col-10": {
                "max-width": "500px"
              }
            },
