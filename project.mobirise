            },
            ".mbr-section-title": {
              "color": "#4e423d"
            },
            ".mbr-section-subtitle": {
              "color": "#232323"
            },
            ".content-head": {
              "max-width": "800px"
            },
            ".card-subtitle": {
              "color": "#a1a1a1"
            }
