          "_name": "people04",
          "_sourceTheme": "workflowm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"people4\" group=\"People\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\"\r\n    mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\r\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\r\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\r\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\r\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\r\n        <select title=\"Cards\" name=\"cardsAmount\">\r\n            <option value=\"1\">1</option>\r\n            <option value=\"2\">2</option>\r\n            <option value=\"3\" selected>3</option>\r\n        </select>\r\n        <header condition=\"showIcon\">Color</header>\r\n        <input type=\"color\" title=\"Icon\" name=\"iconColor\" value=\"#1f357f\" selected condition=\"showIcon\">\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/workflowm5/components/_images/background1.jpg\">\r\n            <input type=\"color\" title=\"Color\" value=\"#e3f3ff\" selected>\r\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/workflowm5/components/_images/background1.jpg\" name=\"fallBackImage\"\r\n            condition=\"bg.type === 'video'\">\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\r\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\r\n            condition=\"overlay && bg.type !== 'color'\">\r\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"\r\n            condition=\"overlay && bg.type !== 'color'\">\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\r\n        mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\r\n    </div>\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row justify-content-center\">\r\n            <div class=\"card md-pb col-12 col-md-6\" mbr-class=\"{'col-lg-6': cardsAmount == '2', 'col-lg-3': cardsAmount == '4',\r\n                             'col-lg-4': cardsAmount == '3'}\">\r\n                <div class=\"card-wrapper\">\r\n                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                        <span mbr-icon class=\"mbr-iconfont m-auto mobi-mbri-up mobi-mbri\" mbr-if=\"showIcon\"></span>\r\n                    </div>\r\n                    <div class=\"card-box\">\r\n                        <h4 class=\"card-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"\r\n                            data-app-selector=\".card-title\"><b>50%</b></h4>\r\n\r\n                    </div>\r\n                </div>\r\n                <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\r\n                    data-app-selector=\".card-text\">Lorem ipsum dolor amet</h5>\r\n                <img src=\"@ADDONS_PATH@/workflowm5/components/_images/clients/4.png\" alt=\"Mobirise Website Builder\">\r\n            </div>\r\n            <div class=\"card md-pb col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-6': cardsAmount == '2', 'col-lg-3': cardsAmount == '4',\r\n                             'col-lg-4': cardsAmount == '3'}\">\r\n                <div class=\"card-wrapper\">\r\n                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                        <span mbr-icon class=\"mbr-iconfont m-auto mobi-mbri-up mobi-mbri\" mbr-if=\"showIcon\"></span>\r\n                    </div>\r\n                    <div class=\"card-box\">\r\n                        <h4 class=\"card-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"\r\n                            data-app-selector=\".card-title\"><b>18%</b></h4>\r\n\r\n                    </div>\r\n                </div>\r\n                <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\r\n                    data-app-selector=\".card-text\">In hac habitasse platea</h5>\r\n                <img src=\"@ADDONS_PATH@/workflowm5/components/_images/clients/3.png\" alt=\"Mobirise Website Builder\">\r\n            </div>\r\n            <div class=\"card col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\r\n                             'col-lg-4': cardsAmount == '3'}\">\r\n                <div class=\"card-wrapper\">\r\n                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                        <span mbr-icon class=\"mbr-iconfont m-auto mobi-mbri-up mobi-mbri\" mbr-if=\"showIcon\"></span>\r\n                    </div>\r\n                    <div class=\"card-box\">\r\n                        <h4 class=\"card-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"\r\n                            data-app-selector=\".card-title\"><b>25%</b>\r\n                        </h4>\r\n\r\n                    </div>\r\n                </div>\r\n                <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\r\n                    data-app-selector=\".card-text\">Sed lectus efficitur dignissim</h5>\r\n                <img src=\"@ADDONS_PATH@/workflowm5/components/_images/clients/1.png\" alt=\"Mobirise Website Builder\">\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>",
