        {
          "_name": "slider01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider1 mbr-embla\" group=\"Gallery &amp; Slider\"\n\tmbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"embla\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked=\"\">\n\t\t<input inline=\"\" type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n\t\t<input inline=\"\" type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n\t\t<header>Carousel</header>\n\t\t<input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n\t\t<input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n\t\t<input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Arrows\" name=\"arrows\" checked=\"\">\n\t\t<header>Card</header>\n\t\t<input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n\t\t<input type=\"range\" name=\"carouselHeight\" title=\"Height\" min=\"1\" max=\"8\" step=\"1\" value=\"4\">\n\t\t<input type=\"range\" name=\"cardWidth\" title=\"Width\" min=\"1\" max=\"12\" step=\"1\" value=\"6\">\n\t\t<input type=\"checkbox\" name=\"cardBorder\" title=\"Border\" checked=\"\">\n\t\t<input type=\"color\" name=\"borderColor\" title=\"Color\" value=\"#fdfde1\" condition=\"cardBorder\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax=\"\">\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/rangem5/components/_images/background1.jpg\" parallax=\"\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#000000\" selected=\"\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\"\n\t\t\tcondition=\"overlay &amp;&amp; bg.type !== 'color'\">\n\t\t<input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\"\n\t\t\tcondition=\"overlay &amp;&amp; bg.type !== 'color'\">\n\t</mbr-parameters>\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\"\n\t\tmbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row mb-5 justify-content-center\" mbr-if=\"showMainTitle || showMainSubtitle\">\n\t\t\t<div class=\"col-12 content-head\">\n\t\t\t\t<div class=\"mb-4 text-center\">\n\n\t\t\t\t\t<h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\"\n\t\t\t\t\t\tmbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\"><b>Have a wide range of creative\n\t\t\t\t\t\t\tprojects ✨</b>\n\t\t\t\t\t</h3>\n\t\t\t\t</div>\n\n\n\t\t\t\t<h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-4\" mbr-theme-style=\"display-7\"\n\t\t\t\t\tmbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n\t\t\t\t\tCarousel with Multiple Items\n\t\t\t\t</h5>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-12\">\n\t\t\t\t<div class=\"embla position-relative\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\"\n\t\t\t\t\tdata-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\"\n\t\t\t\t\tdata-align=\"center\" data-contain-scroll=\"trimSnaps\">\n\t\t\t\t\t<div class=\"embla__viewport\">\n\t\t\t\t\t\t<div class=\"embla__container\">\n\t\t\t\t\t\t\t<div class=\"embla__slide slider-image item\"\n\t\t\t\t\t\t\t\tmbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n\t\t\t\t\t\t\t\t<div class=\"slide-content\">\n\t\t\t\t\t\t\t\t\t<div class=\"item-img\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t\t\t\t\t\t\t<img class=\"card-img-bg w-100 h-100\" src=\"@ADDONS_PATH@/rangem5/components/_images/gallery/gallery14.jpg\"\n\t\t\t\t\t\t\t\t\t\t\t\talt=\"Mobirise Website Builder\" title=\"\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"card-box row\">\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"col pe-0\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<h3 class=\"card-title card-title-1 mbr-fonts-style\"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tmbr-theme-style=\"display-5\" data-app-selector=\".card-title-1\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<b>Product Design</b>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</h3>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdata-app-selector=\".card-text\">Developing the look and feel of\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tphysical products,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\taesthetics, and functionality.</p>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\t\t\t\t\t\tclass=\"col-auto icon-wrapper d-flex align-items-center overflow-hidden\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"#\"><span mbr-icon=\"\"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tclass=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span></a>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"embla__slide slider-image item\"\n\t\t\t\t\t\t\t\tmbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n\t\t\t\t\t\t\t\t<div class=\"slide-content\">\n\t\t\t\t\t\t\t\t\t<div class=\"item-img\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t\t\t\t\t\t\t<img class=\"card-img-bg w-100 h-100\" src=\"@ADDONS_PATH@/rangem5/compo