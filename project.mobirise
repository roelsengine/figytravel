            },
            ".container, .container-fluid": {
              "padding": "0 60px",
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 768px)": {
                "min-width": "100%",
                "max-width": "100%",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              },
              ".card-wrap": {
                "display": "grid",
                "grid-template-columns": "1fr 1fr",
                "column-gap": "72px",
                "@media (max-width: 992px)": {
                  "grid-template-columns": "1fr"
                },
                ".item-wrapper": {
                  "display": "flex",
                  "@media (max-width: 992px)": {
                    "flex-direction": "column"
                  },
                  ".desc-wrap": {
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "z-index": "1",
                    "width": "100%",
                    "@media (max-width: 992px)": {
                      "position": "static",
                      "margin-bottom": "20px"
                    },
                    ".mbr-desc": {
                      "display": "inline-flex",
                      "padding": "8px 10px",
                      "background-color": "@desc",
                      "margin-bottom": "0"
                    }
                  },
                  ".image-wrap": {
                    "margin": "0 0 0 auto",
                    "@media (max-width: 992px)": {
                      "margin": "0 auto 30px"
                    },
                    "img": {
                      "width": "450px",
                      "height": "450px",
                      "border-radius": "100%",
                      "object-fit": "cover",
                      "@media (max-width: 1200px)": {
                        "width": "350px",
                        "height": "350px"
                      },
                      "@media (max-width: 768px)": {
                        "width": "250px",
                        "height": "250px"
                      }
                    }
                  }
                },
                ".content-wrap": {
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "center",
                  ".mbr-section-title": {
                    "margin-bottom": "40px"
                  },
                  ".mbr-text": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "0",
              "width": "25px",
              "height": "25px",
              "margin-top": "-1.5rem",
              "font-size": "25px",
              "background-color": "transparent",
              "color": "@primaryColor",
              "border": "none",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "transparent",
                "color": "@primaryColor",
                "opacity": ".5"
              },
              "&.embla__button--prev": {
                "left": "auto",
                "right": "3rem"
              },
              "&.embla__button--next": {
                "right": "0"
              },
              "@media (max-width: 767px)": {
                "top": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#3d4045"
            },
            ".mbr-text": {
              "color": "#3d4045"
            }
          },
          "_cid": "uHeswvGsJS",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider1-2g"
        },
        {
          "_name": "slider1",
          "_sourceTheme": "careerm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider1 mbr-embla careerm5\" group=\"Sliders & Galleries\"\n         mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"embla\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <input type=\"color\" title=\"Decoration Color\" value=\"#FF6839\" name=\"decor\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"4\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <header>Card</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Role\" name=\"showRole\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/careerm5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/careerm5/components/_images/background1.jpg\" name=\"fallBackImage\"\n               condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\"\n               condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"\n               condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n         mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"position-relative row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                    <img src=\"@ADDONS_PATH@/careerm5/components/_images/career/image6.jpg\" alt=\"Mobirise\">\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-8 slider-wrap\">\n                <div class=\"embla\" data-loop={{loop}} data-auto-play={{autoplay}} data-auto-play-interval={{interval}}\n                     data-draggable={{draggable}} data-skip-snaps=\"true\" data-align=\"center\"\n                     data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide slider-image item\"\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"card-wrap\">\n                                    <div class=\"content-wrap\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\n                                           mbr-theme-style=\"display-5\" mbr-if=\"showText\">\n                                            Reiciendis repudiandae soluta, tenetur. Accusamus dolore ducimus possimus\n                                            corporis delectus fuga laborum, magnam placeat quae quam qui quo tenetur.\n                                        </p>\n                                        <p class=\"mbr-name card-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                           mbr-if=\"showName\" data-app-selector=\".mbr-name\">\n                                            Craig Evans\n                                        </p>\n                                        <p class=\"mbr-role mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                           mbr-if=\"showRole\" data-app-selector=\".mbr-role\">\n                                            Manager\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\"\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"card-wrap\">\n                                    <div class=\"content-wrap\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\n                                           mbr-theme-style=\"display-5\" mbr-if=\"showText\">\n                                            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Aut blanditiis\n                                            corporis delectus fuga laborum, magnam placeat quae quam qui quo tenetur.\n                                        </p>\n                                        <p class=\"mbr-name card-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                           mbr-if=\"showName\" data-app-selector=\".mbr-name\">\n                                            Jesse Turner\n                                        </p>\n                                        <p class=\"mbr-role mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                           mbr-if=\"showRole\" data-app-selector=\".mbr-role\">\n                                            Manager\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\"\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"card-wrap\">\n                                    <div class=\"content-wrap\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\n                                           mbr-theme-style=\"display-5\" mbr-if=\"showText\">\n                                            Aspernatur consectetur dolore illum iusto. Dolorem fugit, nemo nisi\n                                            obcaecati quae reiciendis tempora. Distinctio dolor in laborum.\n                                        </p>\n                                        <p class=\"mbr-name card-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                           mbr-if=\"showName\" data-app-selector=\".mbr-name\">\n                                            Charles Perry\n                                        </p>\n                                        <p class=\"mbr-role mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                           mbr-if=\"showRole\" data-app-selector=\".mbr-role\">\n                                            Manager\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\"\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"card-wrap\">\n                                    <div class=\"content-wrap\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\n                                           mbr-theme-style=\"display-5\" mbr-if=\"showText\">\n                                            Alias, animi at, deleniti dignissimos fugiat fugit iste laborum nisi\n                                            quisquam quos repellat sequi sint temporibus tenetur.\n                                        </p>\n                                        <p class=\"mbr-name card-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                           mbr-if=\"showName\" data-app-selector=\".mbr-name\">\n                                            William Baker\n                                        </p>\n                                        <p class=\"mbr-role mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                           mbr-if=\"showRole\" data-app-selector=\".mbr-role\">\n                                            Manager\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\"\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"card-wrap\">\n                                    <div class=\"content-wrap\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\n                                           mbr-theme-style=\"display-5\" mbr-if=\"showText\">\n                                            Deserunt doloribus eius error expedita in iusto molestias nostrum nulla\n                                            quaerat, quasi ratione recusandae reiciendis reprehenderit.\n                                        </p>\n                                        <p class=\"mbr-name card-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                           mbr-if=\"showName\" data-app-selector=\".mbr-name\">\n                                            George Harris\n                                        </p>\n                                        <p class=\"mbr-role mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                           mbr-if=\"showRole\" data-app-selector=\".mbr-role\">\n                                            Manager\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 992px)": {
                  "padding": "0 30px"
                },
                ".row": {
                  "padding": "0"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 30px"
              }
            },
            ".row": {
              "position": "relative",
              "&::before": {
                "content": "''",
                "position": "absolute",
                "top": "-15rem",
                "right": "-10rem",
                "transform": "rotate(-45deg)",
                "display": "block",
                "width": "500px",
                "height": "400px",
                "border-radius": "100%",
                "border": "2px solid @decor",
                "& when (@reverseContent)": {
                  "right": "auto",
                  "left": "-10rem",
                  "transform": "rotate(45deg)",
                  "@media (max-width: 992px)": {
                    "display": "none"
                  }
                },
                "@media (max-width: 992px)": {
                  "display": "none"
                }
              }
            },
            ".image-wrapper": {
              "margin-bottom": "40px",
              "margin-right": "64px",
              "@media (max-width: 1300px)": {
                "margin-right": "0"
              },
              "img": {
                "height": "450px",
                "object-fit": "cover",
                "border-radius": "10px",
                "@media (max-width: 992px)": {
                  "height": "280px"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 768px)": {
                "min-width": "100%",
                "max-width": "100%",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              },
              ".card-wrap": {
                ".content-wrap": {
                  ".mbr-text": {
                    "margin-bottom": "38px"
                  },
                  ".mbr-name": {
                    "margin-bottom": "0"
                  },
                  ".mbr-role": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "-4rem",
              "width": "32px",
              "height": "32px",
              "margin-top": "-1.5rem",
              "font-size": "22px",
              "background-color": "transparent",
              "color": "@primaryColor",
              "border": "none",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "transparent",
                "color": "@secondaryColor"
              },
              "&.embla__button--prev": {
                "left": "0"
              },
              "&.embla__button--next": {
                "right": "auto",
                "left": "2rem"
              },
              "@media (max-width: 767px)": {
                "top": "auto"
              }
            },
            ".slider-wrap": {
              "display": "flex",
              "align-items": "center"
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-name": {
              "color": "#a8a8a8"
            },
            ".mbr-role": {
              "color": "#000000"
            }
          },
          "_cid": "uHeswz3OYS",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider1-2h"
        },
        {
          "_name": "aslider3",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider3 expertm5\" group=\"Gallery & Slider\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\"\n    mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <input type=\"id\" name=\"sliderId\">\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked>\n        <header>Slider</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"checkbox\" title=\"List Title\" name=\"showText\" checked condition=\"showList\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked condition=\"showList\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#C4CFDE\" condition=\"showIcon && showList\">\n        <input type=\"range\" inline title=\"List 1 Count\" name=\"list1Count\" min=\"1\" max=\"6\" step=\"1\" value=\"5\" condition=\"showList\">\n        <header>Card Style</header>\n        <input type=\"color\" title=\"Card BG 1\" name=\"cardBg1\" value=\"#1e2024\">\n        <input type=\"color\" title=\"Card BG 2\" name=\"cardBg2\" value=\"#23272b\">\n        <input type=\"checkbox\" name=\"cardShadow\" title=\"Card Shadow\" checked>\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"shadowColor1\" value=\"#191b1f\" condition=\"cardShadow\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"shadowColor2\" value=\"#23272B\" condition=\"cardShadow\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Fade Effect\" name=\"fade\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"3\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background4.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#212428\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background4.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\"\n            condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\"\n            condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n        mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <div class=\"mbr-section-head\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\"\n                        mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                        PRACTICE HEALTHY LIFE\n                    </h3>\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\"\n                        mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                        <b>My Workout Plan</b>\n                    </h5>\n                </div>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12 d-flex\">\n                <div class=\"item-wrap\">\n                    <div class=\"row slider-row\">\n                        <div class=\"col-12\">\n                            <div class=\"carousel-wrapper\">\n                                <div id={{sliderId}} class=\"carousel slide\" mbr-class=\"{'carousel-fade': fade}\"\n                                     data-ride=\"{{autoplay ? 'carousel' : false}}\" data-bs-ride=\"{{autoplay ? 'carousel' : false}}\" data-interval=\"{{interval*1000}}\" data-bs-interval=\"{{interval*1000}}\">\n                                    <ol class=\"carousel-indicators\">\n                                        <li data-target=\"#{{sliderId}}\" data-bs-target=\"#{{sliderId}}\" data-slide-to=\"0\" data-bs-slide-to=\"0\" class=\"active\"></li>\n                                        <li data-target=\"#{{sliderId}}\" data-bs-target=\"#{{sliderId}}\" data-slide-to=\"1\" data-bs-slide-to=\"1\"></li>\n                                        <li data-target=\"#{{sliderId}}\" data-bs-target=\"#{{sliderId}}\" data-slide-to=\"2\" data-bs-slide-to=\"2\"></li>\n                                    </ol>\n                                    <div class=\"carousel-inner\">\n\n                                        <div class=\"carousel-item slider-image item active\">\n                                            <div class=\"carousel-item-wrapper item-wrapper\">\n                                                <div class=\"row carousel-row align-items-center justify-content-center\">\n                                                    <div class=\"col-12 col-lg-5 col-text\"  mbr-if=\"showTitle || showSubtitle || showList\">\n                                                        <div class=\"text-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\"\n                                                                data-app-selector=\".card-title\">\n                                                                <b>Viverra nibh cras</b>\n                                                            </h5>\n                                                            <h5 class=\"card-subtitle mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\"\n                                                                data-app-selector=\".card-subtitle\">\n                                                                Rhoncus dolor purus non enim praesent elementum facilisis.\n                                                                Faucibus turpis in eu mi bibendum neque. Tristique magna\n                                                                sit amet purus gravida quis.\n                                                            </h5>\n                                                            <div class=\"list-container\" mbr-if=\"showList\">\n                                                                <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                                                   data-app-selector=\".mbr-text\">\n                                                                    <b>--- NULLA FACILISI NULLAM ---</b>\n                                                                </p>\n                                                                <div class=\"list-item\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Neque convallis a cras\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 1\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Nulla facilisi cras fermentum\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 2\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Ultrices tincidunt arcu\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 3\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Scelerisque mauris\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 4\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Nunc sed blandit libero\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 5\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Tortor dignissim convallis\n                                                                    </p>\n                                                                </div>\n                                                            </div>\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-12 col-lg-7 flex-grow-1 col-img\">\n                                                        <div class=\"img-box\">\n                                                            <img src=\"@ADDONS_PATH@/expertm5/components/_images/gallery/gallery15.jpg\" alt=\"Mobirise Website Builder\">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n\n                                        <div class=\"carousel-item slider-image item\">\n                                            <div class=\"carousel-item-wrapper item-wrapper\">\n                                                <div class=\"row carousel-row justify-content-center align-items-center\">\n                                                    <div class=\"col-12 col-lg-5 col-text\" mbr-if=\"showTitle || showSubtitle || showList\">\n                                                        <div class=\"text-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\"\n                                                                data-app-selector=\".card-title\">\n                                                                <b>Iaculis eu non diam</b>\n                                                            </h5>\n                                                            <h5 class=\"card-subtitle mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\"\n                                                                data-app-selector=\".card-subtitle\">\n                                                                Rhoncus dolor purus non enim praesent elementum facilisis.\n                                                                Faucibus turpis in eu mi bibendum neque. Tristique magna\n                                                                sit amet purus gravida quis.\n                                                            </h5>\n                                                            <div class=\"list-container\" mbr-if=\"showList\">\n                                                                <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                                                   data-app-selector=\".mbr-text\">\n                                                                    <b>--- PORTTITOR LEO A DIAM ---</b>\n                                                                </p>\n                                                                <div class=\"list-item\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Neque convallis a cras\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 1\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Nulla facilisi cras fermentum\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 2\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Ultrices tincidunt arcu\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 3\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Scelerisque mauris\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 4\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Nunc sed blandit libero\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 5\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Tortor dignissim convallis\n                                                                    </p>\n                                                                </div>\n                                                            </div>\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-12 col-lg-7 flex-grow-1 col-img\">\n                                                        <div class=\"img-box\">\n                                                            <img src=\"@ADDONS_PATH@/expertm5/components/_images/gallery/gallery16.jpg\" alt=\"Mobirise Website Builder\">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n\n                                        <div class=\"carousel-item slider-image item\">\n                                            <div class=\"carousel-item-wrapper item-wrapper\">\n                                                <div class=\"row carousel-row justify-content-center align-items-center\">\n                                                    <div class=\"col-12 col-lg-5 col-text\" mbr-if=\"showTitle || showSubtitle || showList\">\n                                                        <div class=\"text-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\"\n                                                                data-app-selector=\".card-title\">\n                                                                <b>Sed id semper risus</b>\n                                                            </h5>\n                                                            <h5 class=\"card-subtitle mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\"\n                                                                data-app-selector=\".card-subtitle\">\n                                                                Rhoncus dolor purus non enim praesent elementum facilisis.\n                                                                Faucibus turpis in eu mi bibendum neque. Tristique magna\n                                                                sit amet purus gravida quis.\n                                                            </h5>\n                                                            <div class=\"list-container\" mbr-if=\"showList\">\n                                                                <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                                                                   data-app-selector=\".mbr-text\">\n                                                                    <b>--- MAGNA SIT AMET PURUS ---</b>\n                                                                </p>\n                                                                <div class=\"list-item\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Neque convallis a cras\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 1\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Nulla facilisi cras fermentum\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 2\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Ultrices tincidunt arcu\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 3\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Scelerisque mauris\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 4\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Nunc sed blandit libero\n                                                                    </p>\n                                                                </div>\n                                                                <div class=\"list-item\" mbr-if=\"list1Count > 5\">\n                                                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                                                    </div>\n                                                                    <p class=\"list-item-text mbr-fonts-style mb-0\"\n                                                                       data-app-selector=\".list-item-text\" mbr-theme-style=\"display-7\">\n                                                                        Tortor dignissim convallis\n                                                                    </p>\n                                                                </div>\n                                                            </div>\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-12 col-lg-7 flex-grow-1 col-img\">\n                                                        <div class=\"img-box\">\n                                                            <img src=\"@ADDONS_PATH@/expertm5/components/_images/gallery/gallery17.jpg\" alt=\"Mobirise Website Builder\">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n\n                                    </div>\n                                    <a class=\"carousel-control carousel-control-prev\" href=\"#{{sliderId}}\" role=\"button\"\n                                       data-slide=\"prev\" data-bs-slide=\"prev\">\n                                        <span class=\"mobi-mbri mobi-mbri-arrow-prev\" aria-hidden=\"true\"></span>\n                                        <span class=\"sr-only visually-hidden\">Previous</span>\n                                    </a>\n                                    <a class=\"carousel-control carousel-control-next\" href=\"#{{sliderId}}\" role=\"button\"\n                                       data-slide=\"next\" data-bs-slide=\"next\">\n                                        <span class=\"mobi-mbri mobi-mbri-arrow-next\" aria-hidden=\"true\"></span>\n                                        <span class=\"sr-only visually-hidden\">Next</span>\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "overflow": "hidden",
            ".mbr-section-head": {
              "width": "100%",
              "padding-bottom": "60px"
            },
            ".mbr-section-title": {
              "color": "#FF014E",
              "@media (max-width: 767px)": {
                "text-align": "center !important"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#C4CFDE",
              "margin-top": "15px",
              "@media (max-width: 767px)": {
                "margin-top": "10px",
                "text-align": "center !important"
              }
            },
            ".item-wrap": {
              "position": "relative",
              "width": "100%",
              "padding": "55px",
              "border-radius": "10px",
              "background": "linear-gradient(145deg, @cardBg1, @cardBg2)",
              "& when (@cardShadow)": {
                "box-shadow": "10px 10px 19px @shadowColor1, -10px -10px 19px @shadowColor2"
              },
              "@media (max-width: 767px)": {
                "padding": "30px",
                "margin-bottom": "82px"
              },
              "&:hover": {
                ".carousel-control": {
                  "opacity": "1"
                }
              }
            },
            ".carousel": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "max-width": "100%",
              "width": "100%",
              "margin": "0"
            },
            ".carousel-inner": {
              "display": "flex",
              "align-items": "center",
              "margin-bottom": "0",
              "border-radius": "10px"
            },
            ".carousel-item-wrapper": {
              "display": "flex",
              "width": "100%",
              "overflow": "visible",
              "padding": "0"
            },
            ".carousel-control": {
              "top": "50%",
              "transform": "translateY(-50%)",
              "width": "60px",
              "height": "60px",
              "border-radius": "50%",
              "background": "linear-gradient(to right bottom, #212428, #16181c) !important",
              "border": "none",
              "transition": "all 0.4s",
              "opacity": "0",
              "color": "#C4CFDE",
              "font-size": "18px",
              "@media (max-width: 767px)": {
                "width": "52px",
                "height": "52px",
                "border-radius": "20%",
                "opacity": "1 !important"
              },
              "&.carousel-control-prev": {
                "left": "-55px",
                "margin-left": "0",
                "@media (max-width: 767px)": {
                  "top": "auto",
                  "bottom": "-137px",
                  "left": "-30px"
                }
              },
              "&.carousel-control-next": {
                "right": "-55px",
                "margin-right": "0",
                "@media (max-width: 767px)": {
                  "right": "auto",
                  "left": "42px",
                  "top": "auto",
                  "bottom": "-137px"
                }
              }
            },
            ".carousel-control:hover": {
              "color": "#FFFFFF !important",
              "opacity": "1"
            },
            ".mobi-mbri-arrow-next": {
              "margin-left": "5px"
            },
            ".mobi-mbri-arrow-prev": {
              "margin-right": "5px"
            },
            ".container .carousel-indicators": {
              "margin-bottom": "3px",
              "display": "none !important"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".col-img": {
              "@media (max-width: 991px)": {
                "order": "1"
              }
            },
            ".col-text": {
              "@media (max-width: 991px)": {
                "order": "2"
              }
            },
            ".text-box": {
              "position": "relative",
              "z-index": "10",
              "width": "100%",
              "@media (max-width: 991px)": {
                "padding-top": "50px"
              },
              "@media (max-width: 767px)": {
                "padding-top": "40px"
              }
            },
            ".card-title": {
              "color": "#C4CFDE",
              "margin-bottom": "20px"
            },
            ".card-subtitle": {
              "color": "#878e99",
              "margin-bottom": "0"
            },
            ".list-container": {
              "margin-top": "30px",
              "@media (max-width: 767px)": {
                "margin-top": "20px"
              }
            },
            ".mbr-text": {
              "color": "#C4CFDE",
              "margin-bottom": "20px"
            },
            ".list-item": {
              "display": "flex",
              "align-items": "center",
              "width": "100%",
              "padding-bottom": "10px"
            },
            ".iconfont-wrapper": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "flex-start",
              "margin-right": "10px",
              ".mbr-iconfont": {
                "font-size": "18px",
                "color": "@iconColor"
              }
            },
            ".list-item-text": {
              "color": "#C4CFDE",
              "width": "fit-content"
            },
            ".img-box": {
              "width": "100%",
              "border-radius": "8px",
              "overflow": "hidden",
              "img": {
                "aspect-ratio": "(4 / 3)",
                "object-fit": "cover",
                "width": "100%"
              }
            }
          },
          "_cid": "uHeswDkG9O",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "aslider3-2i"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".title-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "flex-end",
              "margin-bottom": "50px",
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              "@media (max-width: 768px)": {
                "display": "block"
              },
              ".title-wrap": {
                "padding-right": "30px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "30px",
                  "padding-right": "0"
                },
                ".mbr-section-title": {
                  "margin-bottom": "30px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "0"
                }
              },
              ".buttons-wrapper": {
                "position": "relative",
                "display": "flex",
                "justify-content": "space-between",
                "height": "56px",
                "min-width": "130px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "390px",
              "max-width": "390px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              "&:hover, &:focus": {
                ".slide-content .item-wrapper::before": {
                  "top": "-150px",
                  "right": "-150px"
                }
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "position": "relative",
                  "background-color": "@card",
                  "border": "1px solid @border",
                  "border-radius": "20px !important",
                  "padding": "40px 30px",
                  "overflow": "hidden",
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "top": "-400px",
                    "right": "-400px",
                    "width": "300px",
                    "height": "300px",
                    "border-radius": "100%",
                    "background-color": "@active",
                    "filter": "blur(95px)",
                    "transition": "all 0.45s ease-in-out",
                    "@media (max-width: 768px)": {
                      "display": "none"
                    }
                  },
                  ".card-box": {
                    "position": "relative",
                    ".date-wrapper": {
                      "margin-bottom": "15px",
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "space-between",
                      "@media (max-width: 768px)": {
                        "display": "block"
                      },
                      ".mbr-date": {
                        "margin-right": "10px",
                        "margin-bottom": "0",
                        "@media (max-width: 768px)": {
                          "margin-bottom": "15px",
                          "margin-right": "0"
                        }
                      },
                      ".tag-wrapper": {
                        "display": "inline-flex",
                        "padding": "6px 9px 2px",
                        "border-radius": "6px",
                        "position": "relative",
                        "@media (max-width: 768px)": {
                          "margin": "0"
                        },
                        "&:hover, &:focus": {
                          "&::before": {
                            "opacity": ".85"
                          }
                        },
                        "&::before": {
                          "content": "''",
                          "position": "absolute",
                          "top": "0",
                          "left": "0",
                          "width": "100%",
                          "height": "100%",
                          "background-color": "@tag",
                          "border-radius": "6px",
                          "opacity": ".4",
                          "transition": "all 0.3s ease-in-out",
                          "pointer-events": "none"
                        },
                        ".mbr-tag": {
                          "position": "relative",
                          "margin-bottom": "0"
                        }
                      }
                    },
                    ".mbr-card-title": {
                      "margin-bottom": "20px"
                    },
                    ".mbr-card-text": {
                      "margin-bottom": "0"
                    },
                    ".mbr-section-btn": {
                      "margin-top": "20px",
                      ".btn-primary-outline, .btn-secondary-outline, .btn-success-outline, .btn-info-outline, .btn-warning-outline, .btn-danger-outline, .btn-white-outline, .btn-black-outline": {
                        "padding": "0",
                        "border": "none !important",
                        "&:hover, &:focus": {
                          "text-decoration": "underline"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "54px",
              "height": "54px",
              "margin-top": "-1.5rem",
              "font-size": "22px",
              "background-color": "transparent !important",
              "color": "@arrowsColor !important",
              "border": "1px solid @arrowsColor !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex !important",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "&::before": {
                "content": "''",
                "position": "absolute",
                "width": "54px",
                "height": "54px",
                "border-radius": "50%",
                "background-color": "@arrowsBg",
                "pointer-events": "none",
                "transition": "all 0.3s ease-in-out",
                "border": "1px solid"
              },
              "span": {
                "z-index": "1"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "&::before": {
                  "opacity": "0"
                }
              },
              "&.embla__button--prev": {
                "left": "0"
              },
              "&.embla__button--next": {
                "right": "0",
                "@media (max-width: 992px)": {
                  "right": "0"
                }
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              ".btn-wrapper": {
                "margin-top": "22%",
                "margin-right": "0%"
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#d2d2df"
            },
            ".mbr-date": {
              "color": "#ffffff"
            },
            ".mbr-tag": {
              "color": "#ffffff"
            },
            ".mbr-card-title": {
              "color": "#f2ac2b"
            },
            ".mbr-card-text": {
              "color": "#d2d2df"
            }
          },
          "_name": "slider02",
          "_sourceTheme": "authorm5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider01 mbr-embla authorm5\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\"/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"5\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\r\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked/>\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"5\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked/>\r\n        <input type=\"color\" name=\"arrowsColor\" title=\"Arrows Color\" value=\"#f2ac2b\" condition=\"arrows\"/>\r\n        <input type=\"color\" name=\"arrowsBg\" title=\"Arrows BG\" value=\"#373d52\" condition=\"arrows\"/>\r\n        <header>Cards</header>\r\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\"/>\r\n        <input\r\n                type=\"range\"\r\n                name=\"gap\"\r\n                title=\"Gap\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input type=\"checkbox\" name=\"showDate\" title=\"Card Date\" checked/>\r\n        <input type=\"checkbox\" name=\"showTag\" title=\"Card Tag\" checked/>\r\n        <input type=\"color\" title=\"Tag BG\" value=\"#1e6bff\" name=\"tag\" condition=\"showTag\"/>\r\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Card Title\" checked/>\r\n        <input type=\"checkbox\" name=\"showCardText\" title=\"Card Text\" checked/>\r\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked/>\r\n        <input type=\"color\" title=\"Card BG\" value=\"#232b45\" name=\"card\"/>\r\n        <input type=\"color\" title=\"Card Border\" value=\"#373d52\" name=\"border\"/>\r\n        <input type=\"color\" title=\"Card Active Color\" value=\"#41798C\" name=\"active\"/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax required>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/authorm5/components/_images/background1.jpg\" parallax selected/>\r\n            <input type=\"color\" title=\"Color\" value=\"#232b45\"/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#232b45\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.5\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div\r\n                        class=\"embla\"\r\n                        data-loop=\"{{loop}}\"\r\n                        data-auto-play=\"{{autoplay}}\"\r\n                        data-auto-play-interval=\"{{interval}}\"\r\n                        data-draggable=\"{{draggable}}\"\r\n                        data-skip-snaps=\"true\"\r\n                        data-align=\"center\"\r\n                        data-contain-scroll=\"trimSnaps\"\r\n                >\r\n                    <div class=\"title-wrapper\">\r\n                        <div class=\"title-wrap\" mbr-if=\"showTitle || showText\">\r\n                            <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                                data-app-selector=\".mbr-section-title\"\r\n                                mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                                Events\r\n                            </h2>\r\n                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\r\n                               mbr-theme-style=\"display-7\" mbr-if=\"showText\">\r\n                                Book publishers often hold a variety of events to promote their authors.\r\n                            </p>\r\n                        </div>\r\n                        <div class=\"buttons-wrapper\" mbr-if=\"arrows\">\r\n                            <button class=\"embla__button embla__button--prev\">\r\n                                <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                                <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                            </button>\r\n                            <button class=\"embla__button embla__button--next\">\r\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\r\n                                <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"embla__viewport\">\r\n                        <div class=\"embla__container\">\r\n                            <div class=\"embla__slide slider-image features-without-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"card-box\">\r\n                                            <div class=\"date-wrapper\" mbr-if=\"showDate || showTag\">\r\n                                                <p class=\"mbr-date mbr-fonts-style\" mbr-if=\"showDate\"\r\n                                                   mbr-theme-style=\"display-4\" data-app-selector=\".mbr-date\">\r\n                                                    March 03, 2030\r\n                                                </p>\r\n                                                <a href=\"#\" class=\"tag-wrapper\" mbr-if=\"showTag\">\r\n                                                    <p class=\"mbr-tag mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-4\" data-app-selector=\".mbr-tag\">\r\n                                                        EVENT\r\n                                                    </p>\r\n                                                </a>\r\n                                            </div>\r\n                                            <h4 class=\"mbr-card-title mbr-fonts-style\" mbr-if=\"showCardTitle\"\r\n                                                mbr-theme-style=\"display-5\"\r\n                                                data-app-selector=\".mbr-card-title, .mbr-section-btn\">\r\n                                                Book Launch Parties\r\n                                            </h4>\r\n                                            <p class=\"mbr-card-text mbr-fonts-style\" mbr-if=\"showCardText\"\r\n                                               mbr-theme-style=\"display-7\" data-app-selector=\".mbr-card-text\">\r\n                                                These celebratory events mark the release of a new book. They often\r\n                                                feature the author discussing their work, readings, book signings, and\r\n                                                socializing with attendees.\r\n                                            </p>\r\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                 mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                                                <a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\"\r\n                                                   data-app-placeholder=\"Type Text\">\r\n                                                    VIEW MORE\r\n                                                </a>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image features-without-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"card-box\">\r\n                                            <div class=\"date-wrapper\" mbr-if=\"showDate || showTag\">\r\n                                                <p class=\"mbr-date mbr-fonts-style\" mbr-if=\"showDate\"\r\n                                                   mbr-theme-style=\"display-4\" data-app-selector=\".mbr-date\">\r\n                                                    March 09, 2030\r\n                                                </p>\r\n                                                <a href=\"#\" class=\"tag-wrapper\" mbr-if=\"showTag\">\r\n                                                    <p class=\"mbr-tag mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-4\" data-app-selector=\".mbr-tag\">\r\n                                                        EVENT\r\n                                                    </p>\r\n                                                </a>\r\n                                            </div>\r\n                                            <h4 class=\"mbr-card-title mbr-fonts-style\" mbr-if=\"showCardTitle\"\r\n                                                mbr-theme-style=\"display-5\"\r\n                                                data-app-selector=\".mbr-card-title, .mbr-section-btn\">\r\n                                                Author Readings and Signings\r\n                                            </h4>\r\n                                            <p class=\"mbr-card-text mbr-fonts-style\" mbr-if=\"showCardText\"\r\n                                               mbr-theme-style=\"display-7\" data-app-selector=\".mbr-card-text\">\r\n                                                Publishers host events where authors read excerpts from their books and\r\n                                                interact with fans. Attendees can get their books signed and ask\r\n                                                questions about the author's work.\r\n                                            </p>\r\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                 mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                                                <a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\"\r\n                                                   data-app-placeholder=\"Type Text\">\r\n                                                    VIEW MORE\r\n                                                </a>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image features-without-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"card-box\">\r\n                                            <div class=\"date-wrapper\" mbr-if=\"showDate || showTag\">\r\n                                                <p class=\"mbr-date mbr-fonts-style\" mbr-if=\"showDate\"\r\n                                                   mbr-theme-style=\"display-4\" data-app-selector=\".mbr-date\">\r\n                                                    March 12, 2030\r\n                                                </p>\r\n                                                <a href=\"#\" class=\"tag-wrapper\" mbr-if=\"showTag\">\r\n                                                    <p class=\"mbr-tag mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-4\" data-app-selector=\".mbr-tag\">\r\n                                                        EVENT\r\n                                                    </p>\r\n                                                </a>\r\n                                            </div>\r\n                                            <h4 class=\"mbr-card-title mbr-fonts-style\" mbr-if=\"showCardTitle\"\r\n                                                mbr-theme-style=\"display-5\"\r\n                                                data-app-selector=\".mbr-card-title, .mbr-section-btn\">\r\n                                                Book Clubs\r\n                                            </h4>\r\n                                            <p class=\"mbr-card-text mbr-fonts-style\" mbr-if=\"showCardText\"\r\n                                               mbr-theme-style=\"display-7\" data-app-selector=\".mbr-card-text\">\r\n                                                Publishers might establish or sponsor book clubs where readers gather to\r\n                                                discuss a specific book or a selection of titles from their catalog.\r\n                                            </p>\r\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                 mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                                                <a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\"\r\n                                                   data-app-placeholder=\"Type Text\">\r\n                                                    VIEW MORE\r\n                                                </a>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image features-without-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"card-box\">\r\n                                            <div class=\"date-wrapper\" mbr-if=\"showDate || showTag\">\r\n                                                <p class=\"mbr-date mbr-fonts-style\" mbr-if=\"showDate\"\r\n                                                   mbr-theme-style=\"display-4\" data-app-selector=\".mbr-date\">\r\n                                                    March 23, 2030\r\n                                                </p>\r\n                                                <a href=\"#\" class=\"tag-wrapper\" mbr-if=\"showTag\">\r\n                                                    <p class=\"mbr-tag mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-4\" data-app-selector=\".mbr-tag\">\r\n                                                        EVENT\r\n                                                    </p>\r\n                                                </a>\r\n                                            </div>\r\n                                            <h4 class=\"mbr-card-title mbr-fonts-style\" mbr-if=\"showCardTitle\"\r\n                                                mbr-theme-style=\"display-5\"\r\n                                                data-app-selector=\".mbr-card-title, .mbr-section-btn\">\r\n                                                Literary Festivals\r\n                                            </h4>\r\n                                            <p class=\"mbr-card-text mbr-fonts-style\" mbr-if=\"showCardText\"\r\n                                               mbr-theme-style=\"display-7\" data-app-selector=\".mbr-card-text\">\r\n                                                Publishers often participate in or sponsor literary festivals, where\r\n                                                their authors can showcase their work alongside other prominent writers.\r\n                                            </p>\r\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                 mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                                                <a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\"\r\n                                                   data-app-placeholder=\"Type Text\">\r\n                                                    VIEW MORE\r\n                                                </a>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image features-without-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"card-box\">\r\n                                            <div class=\"date-wrapper\" mbr-if=\"showDate || showTag\">\r\n                                                <p class=\"mbr-date mbr-fonts-style\" mbr-if=\"showDate\"\r\n                                                   mbr-theme-style=\"display-4\" data-app-selector=\".mbr-date\">\r\n                                                    March 29, 2030\r\n                                                </p>\r\n                                                <a href=\"#\" class=\"tag-wrapper\" mbr-if=\"showTag\">\r\n                                                    <p class=\"mbr-tag mbr-fonts-style\"\r\n                                                       mbr-theme-style=\"display-4\" data-app-selector=\".mbr-tag\">\r\n                                                        EVENT\r\n                                                    </p>\r\n                                                </a>\r\n                                            </div>\r\n                                            <h4 class=\"mbr-card-title mbr-fonts-style\" mbr-if=\"showCardTitle\"\r\n                                                mbr-theme-style=\"display-5\"\r\n                                                data-app-selector=\".mbr-card-title, .mbr-section-btn\">\r\n                                                Panel Discussions\r\n                                            </h4>\r\n                                            <p class=\"mbr-card-text mbr-fonts-style\" mbr-if=\"showCardText\"\r\n                                               mbr-theme-style=\"display-7\" data-app-selector=\".mbr-card-text\">\r\n                                                These events bring together authors, industry experts, and readers for\r\n                                                in-depth discussions on various literary topics or themes related to\r\n                                                specific books.\r\n                                            </p>\r\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                 mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\r\n                                                <a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\"\r\n                                                   data-app-placeholder=\"Type Text\">\r\n                                                    VIEW MORE\r\n                                                </a>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_cid": "uHeswHtfCC",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider02-2j"
        },
        {
          "_name": "slider2",
          "_sourceTheme": "electricm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider2 mbr-embla electricm5\" group=\"Sliders & Galleries\"\r\n         mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"embla\">\r\n\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\r\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\r\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\r\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\r\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\r\n        <header>Cards</header>\r\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\r\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\r\n        <input type=\"checkbox\" title=\"Card Subtitle\" name=\"showSubtitle\" checked>\r\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked>\r\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\r\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\r\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/electricm5/components/_images/background1.jpg\" parallax>\r\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/electricm5/components/_images/background1.jpg\" name=\"fallBackImage\"\r\n               condition=\"bg.type === 'video'\">\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\r\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\"\r\n               condition=\"overlay && bg.type !== 'color'\">\r\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"\r\n               condition=\"overlay && bg.type !== 'color'\">\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\r\n         mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\r\n    </div>\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row position-relative\">\r\n            <div class=\"col-12\">\r\n                <div class=\"slider-wrap\">\r\n                    <div class=\"embla\" data-loop={{loop}} data-auto-play={{autoplay}}\r\n                         data-auto-play-interval={{interval}}\r\n                         data-draggable={{draggable}} data-skip-snaps=\"true\" data-align=\"center\"\r\n                         data-contain-scroll=\"trimSnaps\">\r\n                        <div class=\"embla__viewport\">\r\n                            <div class=\"embla__container\">\r\n                                <div class=\"embla__slide slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"card-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n                                        <div class=\"content-wrap\">\r\n                                            <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\r\n                                                WATCH NOW\r\n                                            </h5>\r\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                                mbr-if=\"showTitle\" data-app-selector=\".card-title\">\r\n                                                Electric Base Model\r\n                                            </h4>\r\n                                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc\"\r\n                                               mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\r\n                                                Up to 300 miles/ From $125,000\r\n                                            </p>\r\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\"\r\n                                               mbr-theme-style=\"display-7\" mbr-if=\"showText\">\r\n                                                The entry-level Electric Car sets the standard for affordable electric\r\n                                                transportation without compromising on quality and features.\r\n                                                Equipped with a regenerative braking system, touchscreen infotainment,\r\n                                                and advanced driver-assistance technologies.\r\n                                            </p>\r\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                 mbr-if=\"showButtons\">\r\n                                                <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                                   data-app-placeholder=\"Type Text\">\r\n                                                    Buy Now\r\n                                                </a>\r\n                                                <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\"\r\n                                                   data-app-placeholder=\"Type Text\">\r\n                                                    Read More\r\n                                                </a>\r\n                                            </div>\r\n                                        </div>\r\n                                        <div class=\"item-wrapper position-relative\">\r\n                                            <div class=\"image-wrap\">\r\n                                                <img src=\"@ADDONS_PATH@/electricm5/components/_images/electric/image3.jpg\"\r\n                                                     alt=\"Mobirise Website Builder\">\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"card-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n                                        <div class=\"content-wrap\">\r\n                                            <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\r\n                                                WATCH NOW\r\n                                            </h5>\r\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                                mbr-if=\"showTitle\" data-app-selector=\".card-title\">\r\n                                                Electric Plus Model\r\n                                            </h4>\r\n                                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc\"\r\n                                               mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\r\n                                                Up to 450 miles/ From $130,000\r\n                                            </p>\r\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\"\r\n                                               mbr-theme-style=\"display-7\" mbr-if=\"showText\">\r\n                                                Taking electric driving to the next level, the Electric Plus Model\r\n                                                offers enhanced performance and convenience. This\r\n                                                model features advanced connectivity options, including smartphone\r\n                                                integration and voice-activated controls, allowing you to stay connected\r\n                                                while on the move.\r\n                                            </p>\r\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                 mbr-if=\"showButtons\">\r\n                                                <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                                   data-app-placeholder=\"Type Text\">\r\n                                                    Buy Now\r\n                                                </a>\r\n                                                <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\"\r\n                                                   data-app-placeholder=\"Type Text\">\r\n                                                    Read More\r\n                                                </a>\r\n                                            </div>\r\n                                        </div>\r\n                                        <div class=\"item-wrapper position-relative\">\r\n                                            <div class=\"image-wrap\">\r\n                                                <img src=\"@ADDONS_PATH@/electricm5/components/_images/electric/image14.jpg\"\r\n                                                     alt=\"Mobirise Website Builder\">\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"card-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\r\n                                        <div class=\"content-wrap\">\r\n                                            <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\r\n                                                WATCH NOW\r\n                                            </h5>\r\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                                mbr-if=\"showTitle\" data-app-selector=\".card-title\">\r\n                                                Electric Performance Model\r\n                                            </h4>\r\n                                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc\"\r\n                                               mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\r\n                                                Up to 600 miles/ From $150,000\r\n                                            </p>\r\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\"\r\n                                               mbr-theme-style=\"display-7\" mbr-if=\"showText\">\r\n                                                For adrenaline seekers and driving enthusiasts, the Electric\r\n                                                Performance Model delivers an electrifying experience.\r\n                                                The Electric Performance Model features sport-tuned suspension,\r\n                                                performance brakes, and aerodynamic enhancements to ensure an\r\n                                                exhilarating ride on any road.\r\n                                            </p>\r\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                 mbr-if=\"showButtons\">\r\n                                                <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                                   data-app-placeholder=\"Type Text\">\r\n                                                    Buy Now\r\n                                                </a>\r\n                                                <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\"\r\n                                                   data-app-placeholder=\"Type Text\">\r\n                                                    Read More\r\n                                                </a>\r\n                                            </div>\r\n                                        </div>\r\n                                        <div class=\"item-wrapper position-relative\">\r\n                                            <div class=\"image-wrap\">\r\n                                                <img src=\"@ADDONS_PATH@/electricm5/components/_images/electric/image12.jpg\"\r\n                                                     alt=\"Mobirise Website Builder\">\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <button class=\"embla__button embla__button--prev\">\r\n                            <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\r\n                            <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\r\n                        </button>\r\n                        <button class=\"embla__button embla__button--next\">\r\n                            <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\r\n                            <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 40px",
                "@media (max-width: 992px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 768px)": {
                "min-width": "100%",
                "max-width": "100%",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important",
                "border-right": "none"
              },
              ".card-wrap": {
                "display": "flex",
                "@media (max-width: 992px)": {
                  "display": "block"
                },
                ".content-wrap": {
                  "width": "40%",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "24px",
                    "width": "100%"
                  },
                  ".card-subtitle": {
                    "margin-bottom": "10px",
                    "letter-spacing": ".16em"
                  },
                  ".card-title": {
                    "margin-bottom": "16px"
                  },
                  ".card-desc": {
                    "margin-bottom": "30px"
                  },
                  ".card-text": {
                    "margin-bottom": "24px"
                  }
                },
                ".item-wrapper": {
                  "width": "60%",
                  "padding-left": "4rem",
                  "& when (@reverseContent)": {
                    "padding-left": "0",
                    "padding-right": "4rem",
                    "@media (max-width: 992px)": {
                      "padding": "0"
                    }
                  },
                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "padding": "0"
                  },
                  ".image-wrap": {
                    "height": "100%",
                    "display": "flex",
                    "align-items": "center",
                    "img": {
                      "height": "350px",
                      "width": "100%",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "300px"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "-3rem",
              "width": "40px",
              "height": "40px",
              "margin-top": "-1.5rem",
              "font-size": "16px",
              "background-color": "transparent",
              "color": "@primaryColor",
              "border": "2px solid @infoColor",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "transparent",
                "color": "@primaryColor",
                "border-color": "@primaryColor"
              },
              "&.embla__button--prev": {
                "left": "auto",
                "right": "3.5rem",
                "margin-left": "0"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".card-subtitle": {
              "color": "#ededed"
            },
            ".card-title": {
              "color": "#ffffff"
            },
            ".card-desc": {
              "color": "#ffffff"
            },
            ".card-text": {
              "color": "#ffffff"
            }
          },
          "_cid": "uHeswMpqvy",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider2-2k"
        },
        {
          "_name": "agallery2",
          "_sourceTheme": "ideam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery1\" group=\"Sliders & Galleries\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked>\n        <input type=\"checkbox\" name=\"showCardBG\" title=\"Background\" checked>\n        <input type=\"color\" title=\"Card BG Color\" name=\"cardBg\" value=\"#FAFAFA\" condition=\"showCardBG\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/ideam5/components/_images/background4.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Liner Gradient\" name=\"linerGradient\" condition=\"bg.type == 'color'\">\n        <input type=\"checkbox\" title=\"Horizontally \" name=\"horizontallyGradient\" condition=\"bg.type == 'color' && linerGradient\">\n        <input type=\"color\" title=\"Gradient Color\" name=\"gradientColor\" value=\"#7D7D7D\" condition=\"linerGradient && bg.type == 'color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\n            condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"\n            condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"mbr-section-head col-12\" mbr-if=\"showTitle || showSubtitle || showLabel\">\n                <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\"\n                    mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                    <b>Get started</b>\n                </h4>\n                <h5 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-0 mt-2\" mbr-theme-style=\"display-4\"\n                    mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Lorem ipsum dolor sit amet consectetur adipiscing elit eque ipsum</h5>\n            </div>\n\n            <div class=\"col-12 col-items\">\n                <div class=\"item features-image col-12 col-lg-4\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"item-img\">\n                            <img src=\"@ADDONS_PATH@/ideam5/components/_images/features/features2.jpg\">\n                        </div>\n                        <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showButtons\">\n                            <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\"\n                                data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">\n                                <b>Learn the basics</b>\n                            </h5>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\"\n                               data-app-selector=\".mbr-text\">\n                                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud.\n                            </p>\n                            <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\"\n                                 data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                <a href class=\"btn btn-primary item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                                    Start tutorial\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"item features-image col-12 col-lg-4\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"item-img\">\n                            <img src=\"@ADDONS_PATH@/ideam5/components/_images/features/features3.jpg\">\n                        </div>\n                        <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showButtons\">\n                            <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\"\n                                data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">\n                                <b>Start with components</b>\n                            </h5>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\"\n                               data-app-selector=\".mbr-text\">\n                                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud.\n                            </p>\n                            <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\"\n                                 data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                <a href class=\"btn btn-success item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                                    Start tutorial\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"item features-image col-12 col-lg-4\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"item-img\">\n                            <img src=\"@ADDONS_PATH@/ideam5/components/_images/features/features8.jpg\">\n                        </div>\n                        <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showButtons\">\n                            <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\"\n                                data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">\n                                <b>Onboarding and support</b>\n                            </h5>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\"\n                               data-app-selector=\".mbr-text\">\n                                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud.\n                            </p>\n                            <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\"\n                                 data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                <a href class=\"btn btn-info item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                                    Start tutorial\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              "& when (@linerGradient)": {
                "background": "linear-gradient(180deg, @bg-value, @gradientColor)",
                "& when (@horizontallyGradient)": {
                  "background": "linear-gradient(90deg, @bg-value, @gradientColor) !important"
                }
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".item-img": {
              "display": "flex",
              "width": "100%",
              "margin-bottom": "40px",
              "border-radius": "1rem",
              "overflow": "hidden",
              "@media (max-width: 991px)": {}
            },
            "img": {
              "width": "100%",
              "height": "100%",
              "object-fit": "cover"
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".col-items": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "stretch",
              "flex-wrap": "wrap",
              "height": "100%",
              "@media (min-width: 992px)": {
                "padding": "0 !important"
              }
            },
            ".item": {
              "cursor": "pointer",
              "margin-bottom": "40px",
              "@media (min-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".item-wrapper": {
              "position": "relative",
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap",
              "justify-content": "flex-start",
              "padding": "32px",
              "border-radius": "20px",
              "& when (@showCardBG)": {
                "background-color": "@cardBg"
              },
              "@media (min-width: 992px)": {
                "padding": "40px"
              },
              "@media (min-width: 1200px)": {
                "padding": "60px"
              }
            },
            ".item-content": {
              "width": "100%",
              "@media (max-width: 767px)": {
                "text-align": "center"
              }
            },
            ".mbr-section-title": {
              "width": "100%",
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000",
              "margin-top": "16px",
              "margin-bottom": "16px",
              "opacity": "0.5"
            },
            ".item-title": {
              "color": "#000000"
            },
            ".item-subtitle": {
              "color": "#000000"
            },
            ".mbr-section-head": {
              "margin-bottom": "24px",
              "@media (min-width: 992px)": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              "@media (max-width: 767px)": {
                "text-align": "center !important"
              }
            },
            ".mbr-section-btn": {
              "@media (max-width: 575px)": {
                "display": "flex",
                "flex-wrap": "wrap",
                "& .btn": {
                  "width": "100%"
                }
              }
            }
          },
          "_cid": "uHeswPB4yX",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "agallery2-2l"
        },
        {
          "_name": "slider2",
          "_sourceTheme": "socialm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider2 mbr-embla\" group=\"Galleries &amp; Sliders\" plugins=\"embla\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Title\" checked=\"\">\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Subtitle\" checked=\"\">\n        <input type=\"checkbox\" name=\"showButton\" title=\"Button\" checked=\"\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked=\"\">\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/socialm5/components/_images/background3.jpg\" selected=\"\">\n            <input type=\"color\" title=\"Color\" value=\"#f7f7f7\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#012b3a\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{\n        'mbr-fullscreen': fullScreen}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"row title-block\">\n                <div class=\"col-12\">\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .button-align\" mbr-if=\"showTitle\"><b>HOW SOCIAL MEDIA CAN\n                            HELP YOU</b></h4>\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\">\n                        Social Media Marketing</h3>\n                </div>\n            </div>\n            <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                <div class=\"embla__viewport\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n                    <div class=\"embla__container\">\n                        <div class=\"embla__slide slider-image item features-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"slide-content\">\n                                <div class=\"item-wrapper\">\n                                    <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title, .iconfont-wrapper\">1. Quality content</h5>\n                                    <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\">Lorem ipsum dolor sit amet, consectetur\n                                        adipiscing\n                                        elit. Blandit velit leo urna, diam est proin.</h5>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item features-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"slide-content\">\n                                <div class=\"item-wrapper\">\n                                    <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title, .iconfont-wrapper\">2. Exclusive interviews\n                                    </h5>\n                                    <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\">Lorem ipsum dolor sit amet, consectetur\n                                        adipiscing\n                                        elit. Blandit velit leo urna, diam est proin.</h5>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item features-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"slide-content\">\n                                <div class=\"item-wrapper\">\n                                    <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title, .iconfont-wrapper\">3. Global community</h5>\n                                    <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\">Lorem ipsum dolor sit amet, consectetur\n                                        adipiscing\n                                        elit. Blandit velit leo urna, diam est proin.</h5>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item features-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"slide-content\">\n                                <div class=\"item-wrapper\">\n                                    <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title, .iconfont-wrapper\">4. Questions and answers\n                                    </h5>\n                                    <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\">Lorem ipsum dolor sit amet, consectetur\n                                        adipiscing\n                                        elit. Blandit velit leo urna, diam est proin.</h5>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <button class=\"embla__button embla__button--prev\">\n                    <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\n                    <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                </button>\n                <button class=\"embla__button embla__button--next\">\n                    <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\n                    <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                </button>\n            </div>\n            <div class=\"button-align\">\n                <div class=\"mbr-section-btn\" mbr-if=\"showButton\" mbr-buttons=\"\" mbr-theme-style=\"display-4\"><a class=\"btn btn-success\" href=\"\" data-app-placeholder=\"Type Text\">get in touch</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item-wrapper": {
              "position": "relative",
              "padding": "50px",
              "background-color": "#012B3A"
            },
            ".slide-content": {
              "position": "relative",
              "border-radius": "4px",
              "background": "transparent",
              "height": "100%",
              "display": "flex",
              "overflow": "visible",
              "flex-flow": "column nowrap"
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important",
              "margin-left": "0",
              "margin-right": "0",
              "width": "auto",
              "display": "inline-block"
            },
            ".mbr-section-title": {
              "color": "#14142b",
              "text-align": "center",
              "margin-bottom": "20px",
              "text-transform": "uppercase",
              "letter-spacing": "5.2px"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left"
            },
            ".item-title": {
              "text-align": "left"
            },
            ".item-subtitle": {
              "text-align": "left"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "33%",
              "max-width": "596px",
              "@media (max-width: 768px)": {
                "min-width": "70%",
                "max-width": "initial",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              }
            },
            "@media (max-width: 900px)": {
              ".embla__slide": {
                "min-width": "60%"
              }
            },
            "@media (max-width: 630px)": {
              ".embla__slide": {
                "min-width": "375px"
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "transition": "background-color 300ms ease, transform 300ms ease, -webkit-transform 300ms ease",
              "border": "2px solid #ffffff",
              "width": "50px",
              "height": "50px",
              "font-size": "22px",
              "border-radius": "50%",
              "top": "50%",
              "margin-top": "-1.5rem",
              "background-color": "transparent",
              "color": "#fff",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&.embla__button--prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              }
            },
            ".mobi-mbri-arrow-prev": {
              "margin-right": "5px"
            },
            ".mobi-mbri-arrow-next": {
              "margin-left": "5px"
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "overflow": "hidden"
            },
            ".embla__viewport": {
              "overflow": "visible",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-section-subtitle": {
              "text-align": "center",
              "color": "#fff8ef"
            },
            ".title-block": {
              "justify-content": "space-between",
              "align-items": "center",
              "padding-bottom": "40px",
              "margin": "auto"
            },
            ".card-title": {
              "color": "#4c4c4c",
              "text-align": "left",
              "font-size": "24px"
            },
            ".card-text": {
              "color": "#ffffff",
              "text-align": "left"
            },
            "H3": {
              "color": "#1d1d1f",
              "text-align": "center"
            },
            ".button-align": {
              "margin-top": "25px",
              "text-align": "center"
            },
            ".btn": {
              "margin-top": "5px",
              "padding": "15px 30px !important",
              "letter-spacing": "5.2px",
              "text-transform": "uppercase",
              "transition": "all .3s !important"
            },
            "a.btn > span": {
              "margin-left": "0.5rem"
            },
            ".card-title, .iconfont-wrapper": {
              "color": "#75dbcd"
            },
            ".mbr-section-title, .button-align": {
              "color": "#75dbcd"
            },
            "a.btn:hover": {
              "background-color": "#8e443d !important",
              "border-color": "#8e443d !important"
            },
            "@media (max-width: 576px)": {
              ".embla__slide": {
                "min-width": "100%"
              }
            }
          },
          "_cid": "uHeswSAQ0h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider2-2m"
        },
        {
          "_name": "slider5",
          "_sourceTheme": "wellnessm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider5\" group=\"Sliders & Galleries\" mbr-class=\"{'mbr-fullscreen': fullScreen}\">\n\n\t<mbr-parameters>\n\t\t<input type=\"id\" name=\"sliderId\">\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\t\t<header>Carousel</header>\n\t\t<input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n\t\t<input type=\"range\" title=\"Interval\" name=\"interval\" min=\"3\" max=\"10\" value=\"3\" step=\"1\" condition=\"autoplay\">\n\t\t<header>Slide</header>\n\t\t<input type=\"checkbox\" title=\"Caption\" name=\"showCaption\" checked>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked condition=\"showCaption\">\n\t\t<input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"color\" title=\"Arrows Color\" name=\"arrowsColor\" value=\"#ffffff\" condition=\"arrows\">\n\t\t<header condition=\"showLink && showCaption\">Link</header>\n\t\t<input type=\"checkbox\" title=\"Link\" name=\"showLink\" checked condition=\"showCaption\">\n\t\t<input type=\"color\" title=\"Border\" name=\"borderColor\" value=\"#9a948d\" condition=\"showLink && showCaption\">\n\t\t<input type=\"color\" title=\"Animation\" name=\"animationColor\" value=\"#ffffff\" condition=\"showLink && showCaption\">\n\t\t<header>Images</header>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#262221\"\n\t\t\tcondition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"\n\t\t\tcondition=\"overlay && bg.type !== 'color'\">\n\t\t<header>Background</header>\n\t\t<input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#000000\" selected>\n\t</mbr-parameters>\n\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div id={{sliderId}} class=\"carousel slide\" mbr-class=\"{'carousel-fade': fade}\"\n\t\t\tdata-ride=\"{{autoplay ? 'carousel' : false}}\" data-bs-ride=\"{{autoplay ? 'carousel' : false}}\"\n\t\t\tdata-interval=\"{{interval*1000}}\" data-bs-interval=\"{{interval*1000}}\">\n\t\t\t<div class=\"carousel-inner\">\n\t\t\t\t<div class=\"carousel-item slider-image item active\">\n\t\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t\t<div class=\"mbr-overlay\" mbr-if=\"overlay\"\n\t\t\t\t\t\t\tmbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<img class=\"d-block w-100\" src=\"@ADDONS_PATH@/wellnessm5/components/_images/background3.jpg\">\n\t\t\t\t\t\t<div class=\"carousel-caption justify-content-center\" mbr-if=\"showCaption\">\n\t\t\t\t\t\t\t<div class=\"row justify-content-center w-100\">\n\t\t\t\t\t\t\t\t<div class=\"col-12 col-md-7 wrap\">\n\t\t\t\t\t\t\t\t\t<h1 class=\"mbr-section-title mbr-fonts-style mbr-white w-100\"\n\t\t\t\t\t\t\t\t\t\tdata-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\"\n\t\t\t\t\t\t\t\t\t\tmbr-if=\"showTitle\">GIVE YOURSELF PLEASURE AND CLOSE TO PEOPLE</h1>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"div\" mbr-if=\"showLink\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style btnHeader d-flex align-items-center\"\n\t\t\t\t\t\t\t\t\t\tmbr-theme-style=\"display-4\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"#\" class=\"link text-white\" data-app-selector=\".link\">\n\t\t\t\t\t\t\t\t\t\t\tView demo\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"carousel-item slider-image item\">\n\t\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t\t<div class=\"mbr-overlay\" mbr-if=\"overlay\"\n\t\t\t\t\t\t\tmbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<img class=\"d-block w-100\" src=\"@ADDONS_PATH@/wellnessm5/components/_images/background2.jpg\">\n\t\t\t\t\t\t<div class=\"carousel-caption justify-content-center\" mbr-if=\"showCaption\">\n\t\t\t\t\t\t\t<div class=\"row justify-content-center w-100\">\n\t\t\t\t\t\t\t\t<div class=\"col-12 col-md-7 wrap\">\n\t\t\t\t\t\t\t\t\t<h1 class=\"mbr-section-title mbr-fonts-style mbr-white w-100\" data-app-selector=\".mbr-section-title\"\n\t\t\t\t\t\t\t\t\t\tmbr-theme-style=\"display-1\" mbr-if=\"showTitle\">GIVE YOURSELF PLEASURE AND CLOSE\n\t\t\t\t\t\t\t\t\t\tTO PEOPLE</h1>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"div\" mbr-if=\"showLink\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style btnHeader d-flex align-items-center mbr-section-btn\"\n\t\t\t\t\t\t\t\t\t\tmbr-theme-style=\"display-4\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"#\" class=\"text-white link\" data-app-selector=\".link\">\n\t\t\t\t\t\t\t\t\t\t\tView demo\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"carousel-item slider-image item\">\n\t\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t\t<div class=\"mbr-overlay\" mbr-if=\"overlay\"\n\t\t\t\t\t\t\tmbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<img class=\"d-block w-100\" src=\"@ADDONS_PATH@/wellnessm5/components/_images/background13.jpeg\">\n\t\t\t\t\t\t<div class=\"carousel-caption justify-content-center\" mbr-if=\"showCaption\">\n\t\t\t\t\t\t\t<div class=\"row justify-content-center w-100\">\n\t\t\t\t\t\t\t\t<div class=\"col-12 col-md-7 wrap\">\n\t\t\t\t\t\t\t\t\t<h1 class=\"mbr-section-title mbr-fonts-style mbr-white w-100\"\n\t\t\t\t\t\t\t\t\t\tdata-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\"\n\t\t\t\t\t\t\t\t\t\tmbr-if=\"showTitle\">GIVE YOURSELF PLEASURE AND CLOSE TO PEOPLE</h1>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"div\" mbr-if=\"showLink\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style btnHeader d-flex align-items-center\"\n\t\t\t\t\t\t\t\t\t\tmbr-theme-style=\"display-4\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"#\" class=\"text-white link\" data-app-selector=\".link\">\n\t\t\t\t\t\t\t\t\t\t\tView demo\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<a class=\"carousel-control carousel-control-prev\" href=\"#{{sliderId}}\" role=\"button\" data-slide=\"prev\"\n\t\t\t\tdata-bs-slide=\"prev\">\n\t\t\t\t<span class=\"mbri-left\" aria-hidden=\"true\"></span>\n\t\t\t\t<span class=\"sr-only visually-hidden\">Previous</span>\n\t\t\t</a>\n\t\t\t<a class=\"carousel-control carousel-control-next\" href=\"#{{sliderId}}\" role=\"button\" data-slide=\"next\"\n\t\t\t\tdata-bs-slide=\"next\">\n\t\t\t\t<span class=\"mbri-right\" aria-hidden=\"true\"></span>\n\t\t\t\t<span class=\"sr-only visually-hidden\">Next</span>\n\t\t\t</a>\n\t\t</div>\n\t</div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            ".carousel": {
              "@media (min-width: 992px)": {
                "height": "940px"
              },
              "@media (max-width: 768px)": {
                "height": "400px"
              },
              "img": {
                "width": "100%",
                "height": "100%",
                "-o-object-fit": "cover",
                "object-fit": "cover"
              },
              ".carousel-item, .carousel-inner": {
                "height": "100%"
              },
              "overflow": "hidden"
            },
            "background-color": "@bgColor",
            ".carousel-caption": {
              "top": "50%",
              "right": "0",
              "bottom": "auto",
              "left": "0",
              "display": "-webkit-flex",
              "align-items": "center",
              "transform": "translateY(-50%)",
              "-webkit-align-items": "center"
            },
            ".mobi-mbri-arrow-next": {
              "margin-left": "5px"
            },
            ".mobi-mbri-arrow-prev": {
              "margin-right": "5px"
            },
            ".carousel-control:hover": {
              "color": "#fff",
              "opacity": "1"
            },
            ".item-wrapper": {
              "position": "relative",
              "text-align": "start",
              "width": "100%"
            },
            "@media (max-width: 767px)": {
              ".container .carousel-control": {
                "margin-bottom": "0"
              },
              ".content-slider-wrap": {
                "width": "100% !important"
              }
            },
            ".row": {
              "position": "relative"
            },
            ".container": {
              "margin-bottom": "3px"
            },
            ".carousel-control": {
              "color": "@arrowsColor",
              "top": "50%",
              "width": "100px",
              "height": "60px",
              "margin-top": "-1.5rem",
              "font-size": "40px",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "opacity": ".8",
              "& when not (@arrows)": {
                ".mbri-left, .mbri-right": {
                  "display": "none"
                }
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  ".mbri-left, .mbri-right": {
                    "display": "none"
                  }
                }
              },
              "&.carousel-control-prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.carousel-control-next": {
                "right": "0",
                "margin-right": "2.5rem"
              },
              "@media (max-width: 767px)": {
                "top": "70%",
                "&.carousel-control-prev": {
                  "margin-left": ".5rem"
                },
                "&.carousel-control-next": {
                  "margin-right": ".5rem"
                }
              }
            },
            ".buttons-wrap": {
              "justify-content": "start"
            },
            ".container-fluid": {
              "padding-left": "0",
              "padding-right": "0"
            },
            "@media (max-width: 768px)": {
              ".carousel-caption": {
                "padding-left": "15px",
                "padding-right": "15px"
              },
              ".buttons-wrap": {
                "flex-wrap": "wrap",
                "flex-direction": "column",
                ".mbr-section-btn": {
                  "margin-bottom": "10px"
                }
              }
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#ffffff"
            },
            ".wrap": {
              "z-index": "9999"
            },
            ".btnHeader": {
              "position": "absolute",
              "width": "140px",
              "height": "140px",
              "border-radius": "50%",
              "cursor": "pointer",
              "left": "50%",
              "top": "70%",
              "border": "1px solid @borderColor",
              "justify-content": "center",
              "transition": "border 0.5s ease",
              "transform": "translateX(-50%)",
              "@media (max-width: 991px)": {},
              "&::before, &::after": {
                "content": "''",
                "width": "102%",
                "height": "102%",
                "position": "absolute",
                "border-radius": "50%",
                "top": "-1px",
                "left": "-1%"
              },
              "&::before": {
                "border": "1px solid transparent",
                "transition": "border-top-color 0.1s linear, border-right-color 0.1s linear 0.1s, border-bottom-color 0.1s linear 0.2s"
              },
              "&:hover::before": {
                "border-top-color": "@animationColor",
                "border-right-color": "@animationColor",
                "border-bottom-color": "@animationColor"
              },
              "&::after": {
                "border": "0 solid transparent",
                "transition": "transform 0.2s linear 0s, border-left-width 0s linear 0.3s"
              },
              "&:hover::after": {
                "border-top": "1px solid @animationColor",
                "border-left-color": "@animationColor",
                "border-left-width": "1px",
                "bordersborder-right-width": "1px",
                "borderstransform": "rotate(270deg)"
              }
            },
            ".img": {
              "position": "relative"
            }
          },
          "_cid": "uHeswWECeE",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider5-2n"
        },
        {
