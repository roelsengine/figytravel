              },
              "&.embla__button--prev": {
                "right": "5rem"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "padding-top": "32px",
              "border-top": "1px solid @border",
              "& when (@arrows)": {
                "& when not (@showTitle)": {
                  "padding-bottom": "2rem"
