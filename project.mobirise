              "display": "inline-flex",
              "font-size": "1.5rem",
              "color": "@iconColor",
              "width": "30px",
              "justify-content": "center",
              "align-items": "center"
            },
            ".card-title, .iconfont-wrapper": {
              "color": "#232323"
            },
